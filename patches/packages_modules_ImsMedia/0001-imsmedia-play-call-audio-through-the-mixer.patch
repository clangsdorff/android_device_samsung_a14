From 45bca1f646fa287c6f0b0275dff52333d169f7cd Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sun, 8 Nov 2026 20:56:13 +0300
Subject: [PATCH 1/1] imsmedia: play call audio through the mixer

the stock samsung audio hal sets up the ap call route on the primary
output and treats a mmap stream as a media stream, so it unroutes the
stream when the call switches to the speaker and the earpiece audio
breaks up.

open the player in shared mode without low latency so it uses the
mixer. this path takes longer to start, so wait up to a second.
---
 .../core/audio/android/ImsMediaAudioPlayer.cpp           | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/service/src/com/android/telephony/imsmedia/lib/libimsmedia/core/audio/android/ImsMediaAudioPlayer.cpp b/service/src/com/android/telephony/imsmedia/lib/libimsmedia/core/audio/android/ImsMediaAudioPlayer.cpp
index a9539d5d..02758adb 100644
--- a/service/src/com/android/telephony/imsmedia/lib/libimsmedia/core/audio/android/ImsMediaAudioPlayer.cpp
+++ b/service/src/com/android/telephony/imsmedia/lib/libimsmedia/core/audio/android/ImsMediaAudioPlayer.cpp
@@ -31,6 +31,7 @@
 #include <utils/Errors.h>
 
 #define AAUDIO_STATE_TIMEOUT_NANO (100 * 1000000L)
+#define AAUDIO_START_TIMEOUT_NANO (1000 * 1000000L)
 #define DEFAULT_SAMPLING_RATE     (8000)
 #define CODEC_TIMEOUT_NANO        (100000)
 
@@ -195,7 +196,7 @@ bool ImsMediaAudioPlayer::Start()
     }
 
     result = AAudioStream_waitForStateChange(
-            mAudioStream, inputState, &nextState, AAUDIO_STATE_TIMEOUT_NANO);
+            mAudioStream, inputState, &nextState, AAUDIO_START_TIMEOUT_NANO);
 
     if (result != AAUDIO_OK)
     {
@@ -434,8 +435,8 @@ void ImsMediaAudioPlayer::openAudioStream()
     AAudioStreamBuilder_setFormat(builder, AAUDIO_FORMAT_PCM_I16);
     AAudioStreamBuilder_setChannelCount(builder, 1);
     AAudioStreamBuilder_setSampleRate(builder, mSamplingRate);
-    AAudioStreamBuilder_setSharingMode(builder, AAUDIO_SHARING_MODE_EXCLUSIVE);
-    AAudioStreamBuilder_setPerformanceMode(builder, AAUDIO_PERFORMANCE_MODE_LOW_LATENCY);
+    AAudioStreamBuilder_setSharingMode(builder, AAUDIO_SHARING_MODE_SHARED);
+    AAudioStreamBuilder_setPerformanceMode(builder, AAUDIO_PERFORMANCE_MODE_NONE);
     AAudioStreamBuilder_setUsage(builder, AAUDIO_USAGE_VOICE_COMMUNICATION);
     AAudioStreamBuilder_setErrorCallback(builder, audioErrorCallback, this);
 
@@ -485,7 +486,7 @@ void ImsMediaAudioPlayer::restartAudioStream()
     }
 
     result = AAudioStream_waitForStateChange(
-            mAudioStream, inputState, &nextState, 3 * AAUDIO_STATE_TIMEOUT_NANO);
+            mAudioStream, inputState, &nextState, AAUDIO_START_TIMEOUT_NANO);
 
     if (result != AAUDIO_OK)
     {
