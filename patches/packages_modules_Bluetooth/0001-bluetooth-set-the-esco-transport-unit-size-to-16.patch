From 1e59181473e76dd3c7e39f3904ef75c6be6a0431 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Mon, 9 Nov 2026 02:06:11 +0300
Subject: [PATCH] bluetooth: set the esco transport unit size to 16

the s612 controller rejects every enhanced synchronous connection
with status 0x1f when the transport unit size is 0, and a legacy
connection comes up with no audio over the pcm path. set the input
and output transport unit size to 16 for all codecs.
---
 system/device/src/esco_parameters.cc | 36 ++++++++++++++--------------
 1 file changed, 18 insertions(+), 18 deletions(-)

diff --git a/system/device/src/esco_parameters.cc b/system/device/src/esco_parameters.cc
index d2c83bf..b243583 100644
--- a/system/device/src/esco_parameters.cc
+++ b/system/device/src/esco_parameters.cc
@@ -55,8 +55,8 @@ static const enh_esco_params_t default_esco_parameters[ESCO_NUM_CODECS] = {
                 .output_pcm_payload_msb_position = 0,
                 .input_data_path = ESCO_DATA_PATH_PCM,
                 .output_data_path = ESCO_DATA_PATH_PCM,
-                .input_transport_unit_size = 0x00,
-                .output_transport_unit_size = 0x00,
+                .input_transport_unit_size = 0x10,
+                .output_transport_unit_size = 0x10,
                 .max_latency_ms = 0xFFFF,  // Don't care
                 .packet_types = (ESCO_PKT_TYPES_MASK_HV1 | ESCO_PKT_TYPES_MASK_HV2 |
                                  ESCO_PKT_TYPES_MASK_HV3),
@@ -90,8 +90,8 @@ static const enh_esco_params_t default_esco_parameters[ESCO_NUM_CODECS] = {
                 .output_pcm_payload_msb_position = 0,
                 .input_data_path = ESCO_DATA_PATH_PCM,
                 .output_data_path = ESCO_DATA_PATH_PCM,
-                .input_transport_unit_size = 0x00,
-                .output_transport_unit_size = 0x00,
+                .input_transport_unit_size = 0x10,
+                .output_transport_unit_size = 0x10,
                 .max_latency_ms = 7,
                 .packet_types = (ESCO_PKT_TYPES_MASK_HV1 | ESCO_PKT_TYPES_MASK_HV2 |
                                  ESCO_PKT_TYPES_MASK_HV3 | ESCO_PKT_TYPES_MASK_EV3 |
@@ -129,8 +129,8 @@ static const enh_esco_params_t default_esco_parameters[ESCO_NUM_CODECS] = {
                 .output_pcm_payload_msb_position = 0,
                 .input_data_path = ESCO_DATA_PATH_PCM,
                 .output_data_path = ESCO_DATA_PATH_PCM,
-                .input_transport_unit_size = 0x00,
-                .output_transport_unit_size = 0x00,
+                .input_transport_unit_size = 0x10,
+                .output_transport_unit_size = 0x10,
                 .max_latency_ms = 10,
                 .packet_types = (ESCO_PKT_TYPES_MASK_HV1 | ESCO_PKT_TYPES_MASK_HV2 |
                                  ESCO_PKT_TYPES_MASK_HV3 | ESCO_PKT_TYPES_MASK_EV3 |
@@ -168,8 +168,8 @@ static const enh_esco_params_t default_esco_parameters[ESCO_NUM_CODECS] = {
                 .output_pcm_payload_msb_position = 0,
                 .input_data_path = ESCO_DATA_PATH_PCM,
                 .output_data_path = ESCO_DATA_PATH_PCM,
-                .input_transport_unit_size = 0x00,
-                .output_transport_unit_size = 0x00,
+                .input_transport_unit_size = 0x10,
+                .output_transport_unit_size = 0x10,
                 .max_latency_ms = 12,
                 .packet_types = (ESCO_PKT_TYPES_MASK_HV1 | ESCO_PKT_TYPES_MASK_HV2 |
                                  ESCO_PKT_TYPES_MASK_HV3 | ESCO_PKT_TYPES_MASK_EV3 |
@@ -207,8 +207,8 @@ static const enh_esco_params_t default_esco_parameters[ESCO_NUM_CODECS] = {
                 .output_pcm_payload_msb_position = 0,
                 .input_data_path = ESCO_DATA_PATH_PCM,
                 .output_data_path = ESCO_DATA_PATH_PCM,
-                .input_transport_unit_size = 0x00,
-                .output_transport_unit_size = 0x00,
+                .input_transport_unit_size = 0x10,
+                .output_transport_unit_size = 0x10,
                 .max_latency_ms = 8,
                 .packet_types = (ESCO_PKT_TYPES_MASK_EV3 | ESCO_PKT_TYPES_MASK_NO_3_EV3 |
                                  ESCO_PKT_TYPES_MASK_NO_2_EV5 | ESCO_PKT_TYPES_MASK_NO_3_EV5 |
@@ -244,8 +244,8 @@ static const enh_esco_params_t default_esco_parameters[ESCO_NUM_CODECS] = {
                 .output_pcm_payload_msb_position = 0,
                 .input_data_path = ESCO_DATA_PATH_PCM,
                 .output_data_path = ESCO_DATA_PATH_PCM,
-                .input_transport_unit_size = 0x00,
-                .output_transport_unit_size = 0x00,
+                .input_transport_unit_size = 0x10,
+                .output_transport_unit_size = 0x10,
                 .max_latency_ms = 13,
                 .packet_types = (ESCO_PKT_TYPES_MASK_EV3 | ESCO_PKT_TYPES_MASK_NO_3_EV3 |
                                  ESCO_PKT_TYPES_MASK_NO_2_EV5 | ESCO_PKT_TYPES_MASK_NO_3_EV5),
@@ -280,8 +280,8 @@ static const enh_esco_params_t default_esco_parameters[ESCO_NUM_CODECS] = {
                 .output_pcm_payload_msb_position = 0,
                 .input_data_path = ESCO_DATA_PATH_PCM,
                 .output_data_path = ESCO_DATA_PATH_PCM,
-                .input_transport_unit_size = 0x00,
-                .output_transport_unit_size = 0x00,
+                .input_transport_unit_size = 0x10,
+                .output_transport_unit_size = 0x10,
                 .max_latency_ms = 8,
                 .packet_types = (ESCO_PKT_TYPES_MASK_EV3 | ESCO_PKT_TYPES_MASK_NO_3_EV3 |
                                  ESCO_PKT_TYPES_MASK_NO_2_EV5 | ESCO_PKT_TYPES_MASK_NO_3_EV5 |
@@ -317,8 +317,8 @@ static const enh_esco_params_t default_esco_parameters[ESCO_NUM_CODECS] = {
                 .output_pcm_payload_msb_position = 0,
                 .input_data_path = ESCO_DATA_PATH_PCM,
                 .output_data_path = ESCO_DATA_PATH_PCM,
-                .input_transport_unit_size = 0x00,
-                .output_transport_unit_size = 0x00,
+                .input_transport_unit_size = 0x10,
+                .output_transport_unit_size = 0x10,
                 .max_latency_ms = 13,
                 .packet_types = (ESCO_PKT_TYPES_MASK_NO_3_EV3 | ESCO_PKT_TYPES_MASK_NO_2_EV5 |
                                  ESCO_PKT_TYPES_MASK_NO_3_EV5),
@@ -352,8 +352,8 @@ static const enh_esco_params_t default_esco_parameters[ESCO_NUM_CODECS] = {
          .output_pcm_payload_msb_position = 0,
          .input_data_path = ESCO_DATA_PATH_PCM,
          .output_data_path = ESCO_DATA_PATH_PCM,
-         .input_transport_unit_size = 0x00,
-         .output_transport_unit_size = 0x00,
+         .input_transport_unit_size = 0x10,
+         .output_transport_unit_size = 0x10,
          .max_latency_ms = 14,
          .packet_types = 0x0380,
          .retransmission_effort = ESCO_RETRANSMISSION_QUALITY}};
-- 
