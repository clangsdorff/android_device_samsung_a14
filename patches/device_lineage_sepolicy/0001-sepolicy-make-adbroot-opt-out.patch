From bb230359f70bc33810aa617d3dd4e572884ec7ea Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:04:33 +0000
Subject: [PATCH] sepolicy: make adbroot opt-out

move the adbroot types, contexts and allow rules to common/adbroot and
only include them when TARGET_EXCLUDE_ADB_ROOT is not set. this avoids
leaking the adbroot domain into user builds and dirty policy checks.

Change-Id: Ib4139d825c978dfcb172c02fdf4e3f934184dd13
---
 common/{private => adbroot}/adbd.te    | 0
 common/{private => adbroot}/adbroot.te | 0
 common/adbroot/file.te                 | 1 +
 common/adbroot/file_contexts           | 2 ++
 common/adbroot/service.te              | 1 +
 common/adbroot/service_contexts        | 1 +
 common/adbroot/system_server.te        | 1 +
 common/private/file.te                 | 1 -
 common/private/file_contexts           | 3 ---
 common/private/service.te              | 1 -
 common/private/service_contexts        | 1 -
 common/private/system_server.te        | 1 -
 common/sepolicy.mk                     | 5 +++++
 13 files changed, 11 insertions(+), 7 deletions(-)
 rename common/{private => adbroot}/adbd.te (100%)
 rename common/{private => adbroot}/adbroot.te (100%)
 create mode 100644 common/adbroot/file.te
 create mode 100644 common/adbroot/file_contexts
 create mode 100644 common/adbroot/service.te
 create mode 100644 common/adbroot/service_contexts
 create mode 100644 common/adbroot/system_server.te

diff --git a/common/private/adbd.te b/common/adbroot/adbd.te
similarity index 100%
rename from common/private/adbd.te
rename to common/adbroot/adbd.te
diff --git a/common/private/adbroot.te b/common/adbroot/adbroot.te
similarity index 100%
rename from common/private/adbroot.te
rename to common/adbroot/adbroot.te
diff --git a/common/adbroot/file.te b/common/adbroot/file.te
new file mode 100644
index 0000000..76521e5
--- /dev/null
+++ b/common/adbroot/file.te
@@ -0,0 +1 @@
+type adbroot_data_file, file_type, data_file_type, core_data_file_type;
diff --git a/common/adbroot/file_contexts b/common/adbroot/file_contexts
new file mode 100644
index 0000000..344c05e
--- /dev/null
+++ b/common/adbroot/file_contexts
@@ -0,0 +1,2 @@
+/(system_ext|system/system_ext)/bin/adb_root      u:object_r:adbroot_exec:s0
+/data/adbroot(/.*)?        u:object_r:adbroot_data_file:s0
diff --git a/common/adbroot/service.te b/common/adbroot/service.te
new file mode 100644
index 0000000..47dfb49
--- /dev/null
+++ b/common/adbroot/service.te
@@ -0,0 +1 @@
+type adbroot_service,                   service_manager_type;
diff --git a/common/adbroot/service_contexts b/common/adbroot/service_contexts
new file mode 100644
index 0000000..8dcdccf
--- /dev/null
+++ b/common/adbroot/service_contexts
@@ -0,0 +1 @@
+adbroot_service                           u:object_r:adbroot_service:s0
diff --git a/common/adbroot/system_server.te b/common/adbroot/system_server.te
new file mode 100644
index 0000000..e9e0f11
--- /dev/null
+++ b/common/adbroot/system_server.te
@@ -0,0 +1 @@
+allow system_server adbroot_service:service_manager find;
diff --git a/common/private/file.te b/common/private/file.te
index 6fb480b..908a75b 100644
--- a/common/private/file.te
+++ b/common/private/file.te
@@ -1,3 +1,2 @@
 type sdcard_posix, sdcard_type, sdcard_posix_contextmount_type, fs_type, mlstrustedobject;
-type adbroot_data_file, file_type, data_file_type, core_data_file_type;
 type sysfs_perdev_minors, fs_type, sysfs_type;
diff --git a/common/private/file_contexts b/common/private/file_contexts
index d4c34e9..3a77ebc 100644
--- a/common/private/file_contexts
+++ b/common/private/file_contexts
@@ -12,9 +12,6 @@
 /system/bin/backuptool_ab\.sh                     u:object_r:postinstall_exec:s0
 /system/bin/backuptool_postinstall\.sh            u:object_r:postinstall_exec:s0
 
-# ADB Root
-/(system_ext|system/system_ext)/bin/adb_root      u:object_r:adbroot_exec:s0
-/data/adbroot(/.*)?        u:object_r:adbroot_data_file:s0
 
 # Bash
 /(system_ext|system/system_ext)/bin/bash          u:object_r:shell_exec:s0
diff --git a/common/private/service.te b/common/private/service.te
index c570430..d028cf2 100644
--- a/common/private/service.te
+++ b/common/private/service.te
@@ -1,4 +1,3 @@
-type adbroot_service,                   service_manager_type;
 type lineage_hardware_service, system_api_service, system_server_service, service_manager_type;
 type lineage_health_interface_service, system_api_service, system_server_service, service_manager_type;
 type lineage_globalactions_service, system_api_service, system_server_service, service_manager_type;
diff --git a/common/private/service_contexts b/common/private/service_contexts
index eee1784..f4065ff 100644
--- a/common/private/service_contexts
+++ b/common/private/service_contexts
@@ -6,4 +6,3 @@ lineagesensitivephone                     u:object_r:lineage_sensitive_phone_num
 lineagetrust                              u:object_r:lineage_trust_service:s0
 profile                                   u:object_r:lineage_profile_service:s0
 
-adbroot_service                           u:object_r:adbroot_service:s0
diff --git a/common/private/system_server.te b/common/private/system_server.te
index d2fbdf5..78270d9 100644
--- a/common/private/system_server.te
+++ b/common/private/system_server.te
@@ -1,6 +1,5 @@
 allow system_server storage_stub_file:dir getattr;
 
-allow system_server adbroot_service:service_manager find;
 
 # Use HALs
 hal_client_domain(system_server, hal_lineage_health)
diff --git a/common/sepolicy.mk b/common/sepolicy.mk
index 9a1620d..0b060c7 100644
--- a/common/sepolicy.mk
+++ b/common/sepolicy.mk
@@ -29,3 +29,8 @@ endif
 ifeq ($(PRODUCT_IS_ATV), true)
 include device/lineage/sepolicy/atv/sepolicy.mk
 endif
+
+ifneq ($(TARGET_EXCLUDE_ADB_ROOT),true)
+SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += \
+    device/lineage/sepolicy/common/adbroot
+endif
-- 
2.43.0
