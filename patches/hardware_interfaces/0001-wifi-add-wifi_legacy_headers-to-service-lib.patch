From abf6fb175cc45b147218cba73694cf69c4cb8dd1 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sat, 14 Nov 2026 20:38:59 +0000
Subject: [PATCH 1/2] wifi: add wifi_legacy_headers and libwifi_hal_headers to service-lib

when libwifi-hal is provided as a vendor prebuilt, it does not export
wifi_legacy_headers or wifi_hal/* headers, so
android.hardware.wifi-service-lib
must declare those header_libs dependencies explicitly.

Change-Id: Icb71b43e67006769717ff9acf037d8f502403e01
---
 wifi/aidl/default/Android.bp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/wifi/aidl/default/Android.bp b/wifi/aidl/default/Android.bp
index ee2eb82eae..d493caaf28 100644
--- a/wifi/aidl/default/Android.bp
+++ b/wifi/aidl/default/Android.bp
@@ -100,6 +100,15 @@ cc_library_static {
         "wifi_status_util.cpp",
     ],
 
+    header_libs: [
+        "libwifi_hal_headers",
+        "wifi_legacy_headers",
+    ],
+    export_header_lib_headers: [
+        "libwifi_hal_headers",
+        "wifi_legacy_headers",
+    ],
+
     shared_libs: [
         "libbase",
         "libbinder_ndk",
-- 
2.43.0
