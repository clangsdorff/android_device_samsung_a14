From 1b068c9f807562d5f6b086735f32c898e278301d Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sun, 15 Nov 2026 05:08:59 +0300
Subject: [PATCH 2/2] wifi: realign android 15 vendor wifi_hal_fn table

stock android 15 libwifi-hal.so lacks wifi_rtt_range_request_v4 and
wifi_get_rtt_capabilities_v4 in wifi_hal_fn, shifting all following
slots by one or two entries and causing SIGSEGV on android 17.
---
 wifi/aidl/default/wifi_legacy_hal.cpp | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/wifi/aidl/default/wifi_legacy_hal.cpp b/wifi/aidl/default/wifi_legacy_hal.cpp
index c8d6f9b..86bbbe4 100644
--- a/wifi/aidl/default/wifi_legacy_hal.cpp
+++ b/wifi/aidl/default/wifi_legacy_hal.cpp
@@ -23,6 +23,9 @@
 #include <algorithm>
 #include <array>
 #include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
 
 #include "aidl_sync_util.h"
 #include "wifi_legacy_hal_stubs.h"
@@ -559,7 +562,23 @@ WifiLegacyHal::WifiLegacyHal(const std::weak_ptr<::android::wifi_system::Interfa
       awaiting_event_loop_termination_(false),
       is_started_(false),
       iface_tool_(iface_tool),
-      is_primary_(is_primary) {}
+      is_primary_(is_primary) {
+    // Stock vendor libwifi-hal.so (Android 15) omits the v4 RTT pointers added
+    // to wifi_hal_fn in Android 17, shifting all subsequent function slots.
+    auto* base = reinterpret_cast<uint8_t*>(&global_func_table_);
+    constexpr size_t off_rtt_req_v4 = offsetof(wifi_hal_fn, wifi_rtt_range_request_v4);
+    constexpr size_t off_rtt_cap_v4 = offsetof(wifi_hal_fn, wifi_get_rtt_capabilities_v4);
+    constexpr size_t off_rtt_resp = offsetof(wifi_hal_fn, wifi_rtt_get_responder_info);
+    constexpr size_t ptr_size = sizeof(void*);
+    static_assert(off_rtt_cap_v4 - off_rtt_req_v4 == 4 * ptr_size);
+    static_assert(off_rtt_resp - off_rtt_cap_v4 == ptr_size);
+
+    std::memmove(base + off_rtt_resp, base + off_rtt_resp - 2 * ptr_size,
+                 sizeof(wifi_hal_fn) - off_rtt_resp);
+    std::memmove(base + off_rtt_req_v4 + ptr_size, base + off_rtt_req_v4, 3 * ptr_size);
+    global_func_table_.wifi_rtt_range_request_v4 = nullptr;
+    global_func_table_.wifi_get_rtt_capabilities_v4 = nullptr;
+}
 
 wifi_error WifiLegacyHal::initialize() {
     LOG(DEBUG) << "Initialize legacy HAL";
-- 
