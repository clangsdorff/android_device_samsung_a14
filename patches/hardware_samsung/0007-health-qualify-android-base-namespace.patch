From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Wed, 18 Nov 2026 14:25:00 +0300
Subject: [PATCH 1/1] health: qualify ::android::base in HealthImpl

Inside namespace aidl::android::hardware::health, unqualified
android::base resolves to aidl::android::base and fails to compile.

---
 aidl/health/Health.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/aidl/health/Health.cpp b/aidl/health/Health.cpp
index 1111111..2222222 100644
--- a/aidl/health/Health.cpp
+++ b/aidl/health/Health.cpp
@@ -61,12 +61,12 @@ class HealthImpl : public Health {
         }
 
         std::string content;
-        if (!android::base::ReadFileToString(kHvChargerStatusPath, &content, true)) {
+        if (!::android::base::ReadFileToString(kHvChargerStatusPath, &content, true)) {
             return;
         }
 
         int hv_status = 0;
-        if (!android::base::ParseInt(android::base::Trim(content), &hv_status)) {
+        if (!::android::base::ParseInt(::android::base::Trim(content), &hv_status)) {
             return;
         }
 
-- 
