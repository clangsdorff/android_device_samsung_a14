From bab29a31cc69fbdabf1eb34e86b277b8c6768fc9 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sat, 14 Nov 2026 21:48:40 +0300
Subject: [PATCH] codec2: support Exynos ComponentStore

add support for exynos codec2 componentstore blobs that export
android::GetCodec2ExynosComponentStore() and register the store
as hidl 1.2.

also add missing syscalls needed by exynos blobs to the arm and arm64
seccomp policies.
---
 aidl/codec2/Android.bp                        | 18 ++++++--
 ...droid.software.media.c2-default-arm.policy | 30 ++++++++++++
 ...oid.software.media.c2-default-arm64.policy | 29 ++++++++++++
 aidl/codec2/vendor.cpp                        | 46 +++++++++++++++----
 4 files changed, 112 insertions(+), 11 deletions(-)

diff --git a/aidl/codec2/Android.bp b/aidl/codec2/Android.bp
index f40c39e..7a8da16 100644
--- a/aidl/codec2/Android.bp
+++ b/aidl/codec2/Android.bp
@@ -27,9 +27,12 @@ cc_binary {
 // legacy_default0 -> For devices that already have a c2@1.0 service in their vendor (QTI c2, Samsung hardware c2 etc.)
 // legacy_default -> For devices without a c2 service in their vendor
 //
-    vintf_fragments: select(soong_config_variable("samsungCodec2Vars", "c2_instance_type"), {
-        any @ fragment: ["samsung_media_c2_" + fragment + ".xml"],
-        default: ["samsung_media_c2_default.xml"],
+    vintf_fragments: select(soong_config_variable("samsungCodec2Vars", "uses_exynos_component_store"), {
+        true: [],
+        default: select(soong_config_variable("samsungCodec2Vars", "c2_instance_type"), {
+            any @ fragment: ["samsung_media_c2_" + fragment + ".xml"],
+            default: ["samsung_media_c2_default.xml"],
+        }),
     }),
 
     defaults: [
@@ -52,11 +55,20 @@ cc_binary {
     }) + select(soong_config_variable("samsungCodec2Vars", "uses_legacy_component_store"), {
         true: ["libcodec2_hidl@1.0"],
         default: [],
+    }) + select(soong_config_variable("samsungCodec2Vars", "uses_exynos_component_store"), {
+        true: [
+            "android.hardware.media.c2@1.2",
+            "libcodec2_hidl@1.2",
+        ],
+        default: [],
     }),
 
     cflags: select(soong_config_variable("samsungCodec2Vars", "uses_legacy_component_store"), {
         true: ["-DLEGACY_COMPONENT_STORE" ],
         default: [],
+    }) + select(soong_config_variable("samsungCodec2Vars", "uses_exynos_component_store"), {
+        true: ["-DEXYNOS_COMPONENT_STORE"],
+        default: [],
     }) + select(soong_config_variable("samsungCodec2Vars", "c2_instance_type"), {
         "legacy_default0": ["-DLEGACY_COMPONENT_STORE_DEFAULT0"],
         default: [],
diff --git a/aidl/codec2/seccomp_policy/android.software.media.c2-default-arm.policy b/aidl/codec2/seccomp_policy/android.software.media.c2-default-arm.policy
index 9042cd7..a8ff0e6 100644
--- a/aidl/codec2/seccomp_policy/android.software.media.c2-default-arm.policy
+++ b/aidl/codec2/seccomp_policy/android.software.media.c2-default-arm.policy
@@ -84,3 +84,33 @@ geteuid32: 1
 getgid32: 1
 getegid32: 1
 getgroups32: 1
+
+# samsung exynos additions
+eventfd: 1
+eventfd2: 1
+dup2: 1
+dup3: 1
+epoll_create1: 1
+epoll_ctl: 1
+epoll_wait: 1
+epoll_pwait: 1
+getppid: 1
+getpriority: 1
+sched_get_priority_max: 1
+sched_get_priority_min: 1
+sched_setscheduler: 1
+setsockopt: 1
+sendmsg: 1
+sched_getaffinity: 1
+sched_setaffinity: 1
+shutdown: 1
+getsockopt: 1
+sysinfo: 1
+statfs: 1
+statfs64: 1
+unlinkat: 1
+getcwd: 1
+bind: 1
+mkdirat: 1
+renameat2: 1
+
diff --git a/aidl/codec2/seccomp_policy/android.software.media.c2-default-arm64.policy b/aidl/codec2/seccomp_policy/android.software.media.c2-default-arm64.policy
index 3839111..43f1f07 100644
--- a/aidl/codec2/seccomp_policy/android.software.media.c2-default-arm64.policy
+++ b/aidl/codec2/seccomp_policy/android.software.media.c2-default-arm64.policy
@@ -78,3 +78,32 @@ geteuid: 1
 getgid: 1
 getegid: 1
 getgroups: 1
+
+# samsung exynos additions
+eventfd: 1
+eventfd2: 1
+dup2: 1
+dup3: 1
+epoll_create1: 1
+epoll_ctl: 1
+epoll_wait: 1
+epoll_pwait: 1
+getppid: 1
+getpriority: 1
+sched_get_priority_max: 1
+sched_get_priority_min: 1
+sched_setscheduler: 1
+setsockopt: 1
+sendmsg: 1
+sched_getaffinity: 1
+sched_setaffinity: 1
+shutdown: 1
+getsockopt: 1
+sysinfo: 1
+statfs: 1
+unlinkat: 1
+getcwd: 1
+bind: 1
+mkdirat: 1
+renameat2: 1
+
diff --git a/aidl/codec2/vendor.cpp b/aidl/codec2/vendor.cpp
index 4d7c2bb..c7002ed 100644
--- a/aidl/codec2/vendor.cpp
+++ b/aidl/codec2/vendor.cpp
@@ -22,10 +22,14 @@
 #include <minijail.h>
 
 // HIDL
-#ifdef LEGACY_COMPONENT_STORE
+#if defined(LEGACY_COMPONENT_STORE)
 #include <binder/ProcessState.h>
 #include <codec2/hidl/1.0/ComponentStore.h>
 #include <hidl/HidlTransportSupport.h>
+#elif defined(EXYNOS_COMPONENT_STORE)
+#include <binder/ProcessState.h>
+#include <codec2/hidl/1.2/ComponentStore.h>
+#include <hidl/HidlTransportSupport.h>
 #endif
 
 // AIDL
@@ -49,23 +53,47 @@ static constexpr char kExtSeccompPolicyPath[] =
 // contains alternating binder and hwbinder calls. (See b/35283480.)
 static constexpr int kThreadCount = 8;
 
-#ifndef LEGACY_COMPONENT_STORE
-extern "C" void RegisterSECCodecAidlServices();
-extern "C" void RegisterSECCodecHidlServices();
-#else
+#if defined(EXYNOS_COMPONENT_STORE)
+namespace android {
+std::shared_ptr<C2ComponentStore> GetCodec2ExynosComponentStore();
+}
+#elif defined(LEGACY_COMPONENT_STORE)
 namespace android {
 std::shared_ptr<C2ComponentStore> GetCodec2SecComponentStore();
 }
+#else
+extern "C" void RegisterSECCodecAidlServices();
+extern "C" void RegisterSECCodecHidlServices();
 #endif
 
 void runAidlService() {
-#ifndef LEGACY_COMPONENT_STORE
+#if !defined(LEGACY_COMPONENT_STORE) && !defined(EXYNOS_COMPONENT_STORE)
     RegisterSECCodecAidlServices();
 #endif
 }
 
 void runHidlService() {
-#ifdef LEGACY_COMPONENT_STORE
+#if defined(EXYNOS_COMPONENT_STORE)
+    using namespace ::android;
+
+    // Enable vndbinder to allow vendor-to-vendor binder calls.
+    ProcessState::initWithDriver("/dev/vndbinder");
+
+    ProcessState::self()->startThreadPool();
+    hardware::configureRpcThreadpool(kThreadCount, true /* callerWillJoin */);
+
+    sp<hardware::media::c2::V1_2::utils::ComponentStore> store =
+            new hardware::media::c2::V1_2::utils::ComponentStore(GetCodec2ExynosComponentStore());
+#ifdef LEGACY_COMPONENT_STORE_DEFAULT0
+    constexpr char kInstance[] = "default0";
+#else
+    constexpr char kInstance[] = "default";
+#endif
+    CHECK_EQ(store->registerAsService(kInstance), OK)
+            << "Failed to register Samsung Codec2 store as " << kInstance;
+
+    hardware::joinRpcThreadpool();
+#elif defined(LEGACY_COMPONENT_STORE)
     using namespace ::android;
 
     // Enable vndbinder to allow vendor-to-vendor binder calls.
@@ -93,7 +121,9 @@ void runHidlService() {
 
 int main(int /* argc */, char** /* argv */) {
     const bool aidlEnabled = ::aidl::android::hardware::media::c2::utils::IsSelected();
-#ifdef LEGACY_COMPONENT_STORE
+#if defined(EXYNOS_COMPONENT_STORE)
+    LOG(DEBUG) << "android.software.media.c2@1.2-service.samsung starting...";
+#elif defined(LEGACY_COMPONENT_STORE)
     LOG(DEBUG) << "android.software.media.c2@1.0-service.samsung starting...";
 #else
     LOG(DEBUG) << "android.software.media.c2" << (aidlEnabled ? "-V1" : "@1.2")
-- 
2.56.0

