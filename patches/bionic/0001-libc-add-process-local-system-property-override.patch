From dd43d24330229561595dca5dad2d270e8349e414 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Mon, 16 Nov 2026 09:31:18 +0000
Subject: [PATCH] libc: add process-local system property override

Add __system_property_set_process_override under LIBC_PLATFORM so privileged runtime hooks can override read-only properties inside a single process without touching global property areas.

Change-Id: If081ab2bf42b9b4c2f92f316b588bd53eaa3cee3
---
 libc/bionic/system_property_api.cpp           |   5 +
 libc/libc.map.txt                             |   1 +
 .../system_properties/system_properties.h     |   1 +
 libc/system_properties/system_properties.cpp  | 125 +++++++++++++++++-
 4 files changed, 131 insertions(+), 1 deletion(-)

diff --git a/libc/bionic/system_property_api.cpp b/libc/bionic/system_property_api.cpp
index 34438e7af..46cee2aea 100644
--- a/libc/bionic/system_property_api.cpp
+++ b/libc/bionic/system_property_api.cpp
@@ -135,3 +135,8 @@ int __system_properties_zygote_reload(void) {
   CHECK(getpid() == gettid());
   return system_properties.EnableOverrides() ? 0 : -1;
 }
+
+extern "C" __BIONIC_WEAK_FOR_NATIVE_BRIDGE
+int __system_property_set_process_override(const char* name, const char* value) {
+  return system_properties.SetProcessOverride(name, value);
+}
diff --git a/libc/libc.map.txt b/libc/libc.map.txt
index b0633eb32..eb19d71ae 100644
--- a/libc/libc.map.txt
+++ b/libc/libc.map.txt
@@ -1834,6 +1834,7 @@ LIBC_PLATFORM {
     __system_property_area__; # var
     __system_property_area_init;
     __system_property_set_filename;
+    __system_property_set_process_override;
     __system_property_update;
     android_fdsan_get_fd_table;
     android_fdtrack_compare_exchange_hook; # llndk
diff --git a/libc/system_properties/include/system_properties/system_properties.h b/libc/system_properties/include/system_properties/system_properties.h
index 6c3b1cd78..0d1fbb121 100644
--- a/libc/system_properties/include/system_properties/system_properties.h
+++ b/libc/system_properties/include/system_properties/system_properties.h
@@ -70,6 +70,7 @@ class SystemProperties {
             const timespec* relative_timeout);
   const prop_info* FindNth(unsigned n);
   int Foreach(void (*propfn)(const prop_info* pi, void* cookie), void* cookie);
+  int SetProcessOverride(const char* name, const char* value);
 
  private:
   uint32_t ReadMutablePropertyValue(const prop_info* pi, char* value);
diff --git a/libc/system_properties/system_properties.cpp b/libc/system_properties/system_properties.cpp
index ca286e8ee..329fd9d27 100644
--- a/libc/system_properties/system_properties.cpp
+++ b/libc/system_properties/system_properties.cpp
@@ -30,7 +30,10 @@
 
 #include <errno.h>
 #include <private/android_filesystem_config.h>
+#include <pthread.h>
 #include <stdatomic.h>
+#include <stddef.h>
+#include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 #include <sys/stat.h>
@@ -54,6 +57,39 @@
 #define APPCOMPAT_PREFIX "ro.appcompat_override."
 #define APPCOMPAT_OVERRIDE_ENV_VAR "BIONIC_APPCOMPAT_OVERRIDE"
 
+static constexpr size_t kMaxProcOverrides = 48;
+static constexpr size_t kMaxProcOverrideName = 64;
+static constexpr size_t kMaxProcOverrideValue = 256;
+
+struct ProcOverrideSlot {
+  alignas(prop_info) uint8_t pi_storage[sizeof(prop_info)];
+  char name_buf[kMaxProcOverrideName];
+  char long_val[kMaxProcOverrideValue];
+
+  const prop_info* as_prop_info() const {
+    return reinterpret_cast<const prop_info*>(pi_storage);
+  }
+  prop_info* mutable_prop_info() {
+    return reinterpret_cast<prop_info*>(pi_storage);
+  }
+};
+
+static_assert(offsetof(ProcOverrideSlot, name_buf) == sizeof(prop_info),
+              "name_buf must immediately follow pi_storage");
+
+static ProcOverrideSlot g_proc_overrides[kMaxProcOverrides];
+static atomic_int g_proc_override_count;
+static pthread_mutex_t g_proc_override_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static const prop_info* find_proc_override(const char* name, int count) {
+  for (int i = 0; i < count; ++i) {
+    if (strcmp(g_proc_overrides[i].name_buf, name) == 0) {
+      return g_proc_overrides[i].as_prop_info();
+    }
+  }
+  return nullptr;
+}
+
 static bool is_dir(const char* pathname) {
   struct stat info;
   if (stat(pathname, &info) == -1) {
@@ -166,10 +202,16 @@ uint32_t SystemProperties::AreaSerial() {
 }
 
 const prop_info* SystemProperties::Find(const char* name) {
-  if (!initialized_) {
+  if (!initialized_ || name == nullptr) {
     return nullptr;
   }
 
+  int override_count = atomic_load_explicit(&g_proc_override_count, memory_order_acquire);
+  if (__predict_false(override_count > 0)) {
+    if (const prop_info* pi = find_proc_override(name, override_count)) {
+      return pi;
+    }
+  }
   // if appcompat override is enabled, we first try finding APPCOMPAT_PREFIXed system
   // property
   if (use_appcompat_override_) {
@@ -495,11 +537,92 @@ const prop_info* SystemProperties::FindNth(unsigned n) {
   return state.result;
 }
 
+int SystemProperties::SetProcessOverride(const char* name, const char* value) {
+  if (name == nullptr || value == nullptr || !is_read_only(name)) {
+    return -1;
+  }
+  size_t name_len = strlen(name);
+  size_t val_len = strlen(value);
+  if (name_len == 0 || name_len >= kMaxProcOverrideName || val_len >= kMaxProcOverrideValue) {
+    return -1;
+  }
+
+  pthread_mutex_lock(&g_proc_override_lock);
+  int count = atomic_load_explicit(&g_proc_override_count, memory_order_relaxed);
+  int slot_idx = -1;
+  for (int i = 0; i < count; ++i) {
+    if (strcmp(g_proc_overrides[i].name_buf, name) == 0) {
+      slot_idx = i;
+      break;
+    }
+  }
+  bool is_new = false;
+  if (slot_idx < 0) {
+    if (count >= static_cast<int>(kMaxProcOverrides)) {
+      pthread_mutex_unlock(&g_proc_override_lock);
+      return -1;
+    }
+    slot_idx = count;
+    is_new = true;
+  }
+
+  ProcOverrideSlot& slot = g_proc_overrides[slot_idx];
+  if (is_new) {
+    memset(&slot, 0, sizeof(slot));
+    memcpy(slot.name_buf, name, name_len + 1);
+  }
+  memcpy(slot.long_val, value, val_len + 1);
+  prop_info* pi = slot.mutable_prop_info();
+  if (val_len < PROP_VALUE_MAX) {
+    memcpy(pi->value, value, val_len + 1);
+    atomic_store_explicit(&pi->serial, static_cast<uint32_t>(val_len << 24), memory_order_release);
+  } else {
+    snprintf(pi->long_property.error_message, prop_info::kLongLegacyErrorBufferSize,
+             "Must use __system_property_read_callback() to read");
+    pi->long_property.offset = static_cast<uint32_t>(offsetof(ProcOverrideSlot, long_val));
+    atomic_store_explicit(&pi->serial, prop_info::kLongFlag, memory_order_release);
+  }
+  if (is_new) {
+    atomic_store_explicit(&g_proc_override_count, count + 1, memory_order_release);
+  }
+  pthread_mutex_unlock(&g_proc_override_lock);
+  return 0;
+}
+
 int SystemProperties::Foreach(void (*propfn)(const prop_info* pi, void* cookie), void* cookie) {
   if (!initialized_) {
     return -1;
   }
 
+  int override_count = atomic_load_explicit(&g_proc_override_count, memory_order_acquire);
+  if (__predict_false(override_count > 0)) {
+    struct OverrideIterCtx {
+      void (*propfn)(const prop_info* pi, void* cookie);
+      void* cookie;
+      int count;
+      bool seen[kMaxProcOverrides];
+    } ctx{propfn, cookie, override_count, {}};
+
+    auto wrapper = [](const prop_info* pi, void* raw_ctx) {
+      auto* c = static_cast<OverrideIterCtx*>(raw_ctx);
+      for (int i = 0; i < c->count; ++i) {
+        if (strcmp(g_proc_overrides[i].name_buf, pi->name) == 0) {
+          c->seen[i] = true;
+          c->propfn(g_proc_overrides[i].as_prop_info(), c->cookie);
+          return;
+        }
+      }
+      c->propfn(pi, c->cookie);
+    };
+    contexts_->ForEach(wrapper, &ctx);
+    for (int i = 0; i < ctx.count; ++i) {
+      if (!ctx.seen[i]) {
+        propfn(g_proc_overrides[i].as_prop_info(), cookie);
+      }
+    }
+    return 0;
+  }
+
   contexts_->ForEach(propfn, cookie);
 
   return 0;
-- 
