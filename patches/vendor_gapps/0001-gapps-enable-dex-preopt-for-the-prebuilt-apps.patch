From e5f4dc376ebf495afd46c5a54ab94dc5173abd06 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sun, 8 Nov 2026 10:46:19 +0300
Subject: [PATCH] gapps: enable dex preopt for the prebuilt apps

the generated android_app_import modules set dex_preopt enabled to
false, so none of the gapps apks get an odex at build time and they
stay at verify after the first boot. turn preopt on so they are
compiled with the device speed filter during the build, and list
each apk's optional uses-library tags since preopt enforces them
against the manifest.
---
 arm64/Android.bp  | 53 ++++++++++++++++++++++++++++++++++++++++-------
 common/Android.bp | 43 ++++++++++++++++++++++++++++++--------
 2 files changed, 80 insertions(+), 16 deletions(-)

diff --git a/arm64/Android.bp b/arm64/Android.bp
index c800163..a270354 100644
--- a/arm64/Android.bp
+++ b/arm64/Android.bp
@@ -11,7 +11,7 @@ android_app_import {
     preprocessed: true,
     presigned: true,
     dex_preopt: {
-        enabled: false,
+        enabled: true,
     },
     product_specific: true,
 }
@@ -22,8 +22,14 @@ android_app_import {
     apk: "proprietary/product/priv-app/Phonesky/Phonesky.apk",
     preprocessed: true,
     presigned: true,
+    optional_uses_libs: [
+        "org.apache.http.legacy",
+        "android.ext.adservices",
+        "androidx.window.extensions",
+        "androidx.window.sidecar",
+    ],
     dex_preopt: {
-        enabled: false,
+        enabled: true,
     },
     privileged: true,
     product_specific: true,
@@ -36,8 +42,13 @@ android_app_import {
     overrides: ["Provision"],
     preprocessed: true,
     presigned: true,
+    optional_uses_libs: [
+        "org.apache.http.legacy",
+        "androidx.window.extensions",
+        "androidx.window.sidecar",
+    ],
     dex_preopt: {
-        enabled: false,
+        enabled: true,
     },
     privileged: true,
     system_ext_specific: true,
@@ -49,8 +60,12 @@ android_app_import {
     apk: "proprietary/product/app/SpeechServicesByGoogle/SpeechServicesByGoogle.apk",
     preprocessed: true,
     presigned: true,
+    optional_uses_libs: [
+        "androidx.window.extensions",
+        "androidx.window.sidecar",
+    ],
     dex_preopt: {
-        enabled: false,
+        enabled: true,
     },
     product_specific: true,
 }
@@ -61,8 +76,18 @@ android_app_import {
     apk: "proprietary/product/priv-app/Velvet/Velvet.apk",
     preprocessed: true,
     presigned: true,
+    optional_uses_libs: [
+        "org.apache.http.legacy",
+        "wear-sdk",
+        "com.android.extensions.computercontrol",
+        "com.android.extensions.appfunctions",
+        "com.android.extensions.xr",
+        "android.ext.adservices",
+        "androidx.window.extensions",
+        "androidx.window.sidecar",
+    ],
     dex_preopt: {
-        enabled: false,
+        enabled: true,
     },
     privileged: true,
     product_specific: true,
@@ -75,8 +100,18 @@ android_app_import {
     overrides: ["Velvet"],
     preprocessed: true,
     presigned: true,
+    optional_uses_libs: [
+        "org.apache.http.legacy",
+        "wear-sdk",
+        "com.android.extensions.computercontrol",
+        "com.android.extensions.appfunctions",
+        "com.android.extensions.xr",
+        "android.ext.adservices",
+        "androidx.window.extensions",
+        "androidx.window.sidecar",
+    ],
     dex_preopt: {
-        enabled: false,
+        enabled: true,
     },
     privileged: true,
     product_specific: true,
@@ -88,8 +123,12 @@ android_app_import {
     apk: "proprietary/product/app/talkback/talkback.apk",
     preprocessed: true,
     presigned: true,
+    optional_uses_libs: [
+        "androidx.window.extensions",
+        "androidx.window.sidecar",
+    ],
     dex_preopt: {
-        enabled: false,
+        enabled: true,
     },
     product_specific: true,
 }
