From 57c94eadaac9be2af21878dd2e571e4763b2b539 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sat, 14 Nov 2026 20:13:53 +0000
Subject: [PATCH 4/4] gralloc4: isolate allocator service in soong namespace

add a local soong_namespace to the 4.x allocator service so devices can
include it without importing the top-level exynos namespace.
---
 gralloc/gralloc4/service/4.x/Android.bp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/gralloc/gralloc4/service/4.x/Android.bp b/gralloc/gralloc4/service/4.x/Android.bp
index 013ed23..e8f4eca 100644
--- a/gralloc/gralloc4/service/4.x/Android.bp
+++ b/gralloc/gralloc4/service/4.x/Android.bp
@@ -15,6 +15,8 @@
  * limitations under the License.
  */
 
+soong_namespace {}
+
 cc_binary {
     name: "android.hardware.graphics.allocator@4.0-service",
     proprietary: true,
-- 
2.43.0

