+/// Installs (or removes when empty) `/data/misc/keystore/keybox.xml` atomically and returns
+/// a bitmask (`1=EC, 2=RSA`).
+pub fn set_keybox_xml(xml: &str) -> Result<i32, Error> {
+    let dir = db_root();
+    let path = dir.join("keybox.xml");
+    let trimmed = xml.trim();
+    if trimmed.is_empty() {
+        if let Err(e) = fs::remove_file(&path) {
+            if e.kind() != std::io::ErrorKind::NotFound {
+                warn!("failed removing keybox.xml: {e:?}");
+                return Err(Error::Rc(crate::error::ResponseCode::SYSTEM_ERROR));
+            }
+        }
+        let mut w = KEYBOX_CACHE.write().unwrap();
+        let next_gen = w.snapshot.generation.wrapping_add(1).max(1);
+        w.dir = dir;
+        w.stamp = FileStamp::default();
+        w.snapshot = Arc::new(KeyboxSnapshot { ec: None, rsa: None, generation: next_gen });
+        return Ok(0);
+    }
+    let mut snap = parse_keybox_xml(trimmed, 1).map_err(|e| {
+        warn!("rejecting invalid keybox XML: {e:?}");
+        Error::Km(ErrorCode::INVALID_ARGUMENT)
+    })?;
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent).map_err(|_| Error::Rc(crate::error::ResponseCode::SYSTEM_ERROR))?;
+    }
+    let tmp = path.with_extension("xml.tmp");
+    {
+        let mut f = fs::OpenOptions::new()
+            .create(true)
+            .write(true)
+            .truncate(true)
+            .mode(0o600)
+            .open(&tmp)
+            .map_err(|_| Error::Rc(crate::error::ResponseCode::SYSTEM_ERROR))?;
+        f.write_all(trimmed.as_bytes())
+            .and_then(|_| f.sync_all())
+            .map_err(|_| Error::Rc(crate::error::ResponseCode::SYSTEM_ERROR))?;
+    }
+    fs::rename(&tmp, &path).map_err(|_| Error::Rc(crate::error::ResponseCode::SYSTEM_ERROR))?;
+    let status = (if snap.ec.is_some() { 1 } else { 0 }) | (if snap.rsa.is_some() { 2 } else { 0 });
+    let stamp = FileStamp::from_path(&path);
+    let mut w = KEYBOX_CACHE.write().unwrap();
+    let next_gen = w.snapshot.generation.wrapping_add(1).max(1);
+    snap.generation = next_gen;
+    w.dir = dir;
+    w.stamp = stamp;
+    w.snapshot = Arc::new(snap);
+    Ok(status)
+}
+
+/// Returns bitmask of currently loaded keybox algorithms (`0=none, 1=EC, 2=RSA, 3=EC+RSA`).
+pub fn get_keybox_status() -> i32 {
+    let kb = current_keybox_at(&db_root());
+    (if kb.ec.is_some() { 1 } else { 0 }) | (if kb.rsa.is_some() { 2 } else { 0 })
+}
+
+/// Returns hex-encoded public DER certificates from the currently loaded keybox.
+pub fn get_keybox_certs_hex() -> Vec<String> {
+    let kb = current_keybox_at(&db_root());
+    let mut out = Vec::new();
+    for entry in [&kb.ec, &kb.rsa].into_iter().flatten() {
+        for der in &entry.certs_der {
+            out.push(hex::encode(der));
+        }
+    }
+    out
+}
