+
+    fn setKeyboxXml(&self, xml: &str) -> BinderResult<i32> {
+        if AppUid::calling().0 != 1000 {
+            return Err(into_logged_binder(anyhow!(Error::perm())));
+        }
+        let _wp = wd::watch("IKeystoreMaintenance::setKeyboxXml");
+        crate::attest_spoof::set_keybox_xml(xml)
+            .map_err(|e| into_logged_binder(anyhow!(e)))
+    }
+
+    fn getKeyboxStatus(&self) -> BinderResult<i32> {
+        if AppUid::calling().0 != 1000 {
+            return Err(into_logged_binder(anyhow!(Error::perm())));
+        }
+        let _wp = wd::watch("IKeystoreMaintenance::getKeyboxStatus");
+        Ok(crate::attest_spoof::get_keybox_status())
+    }
+
+    fn getKeyboxCertsHex(&self) -> BinderResult<std::vec::Vec<String>> {
+        if AppUid::calling().0 != 1000 {
+            return Err(into_logged_binder(anyhow!(Error::perm())));
+        }
+        let _wp = wd::watch("IKeystoreMaintenance::getKeyboxCertsHex");
+        Ok(crate::attest_spoof::get_keybox_certs_hex())
+    }
 }
