+
+    #[test]
+    fn test_set_keybox_xml_and_status() {
+        let tmp = TempDir::new().unwrap();
+        {
+            let mut p = DB_PATH.write().unwrap();
+            *p = tmp.path().to_path_buf();
+        }
+        assert_eq!(get_keybox_status(), 0);
+        assert!(matches!(set_keybox_xml("<bad/>"), Err(Error::Km(ErrorCode::INVALID_ARGUMENT))));
+        assert_eq!(get_keybox_status(), 0);
+
+        assert_eq!(set_keybox_xml(&ec_only_keybox_xml()).unwrap(), 1);
+        assert_eq!(get_keybox_status(), 1);
+        assert!(!get_keybox_certs_hex().is_empty());
+        assert!(tmp.path().join("keybox.xml").exists());
+
+        assert_eq!(set_keybox_xml("").unwrap(), 0);
+        assert_eq!(get_keybox_status(), 0);
+        assert!(get_keybox_certs_hex().is_empty());
+        assert!(!tmp.path().join("keybox.xml").exists());
+    }
 }
