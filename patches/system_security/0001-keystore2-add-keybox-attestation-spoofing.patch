+    system: Option<String>,
+    vendor: Option<String>,
+    boot: Option<String>,
+}
+
+#[derive(Debug, Clone, Default)]
+struct PatchRules {
+    global: PatchEntry,
+    per_pkg: HashMap<String, PatchEntry>,
+}
+
+struct CachedPatchRules {
+    dir: PathBuf,
+    stamp: FileStamp,
+    rules: PatchRules,
+}
+
+static PATCH_CACHE: LazyLock<RwLock<CachedPatchRules>> = LazyLock::new(|| {
+    RwLock::new(CachedPatchRules {
+        dir: PathBuf::new(),
+        stamp: FileStamp { exists: false, len: 0, modified_nanos: 0 },
+        rules: PatchRules::default(),
+    })
+});
+
+fn parse_security_patch_txt(text: &str) -> PatchRules {
+    let mut rules = PatchRules::default();
+    let mut current_pkg: Option<String> = None;
+    for raw_line in text.lines() {
+        let line = raw_line.split('#').next().unwrap_or("").trim();
+        if line.is_empty() {
+            continue;
+        }
+        if line.starts_with('[') && line.ends_with(']') && line.len() > 2 {
+            let pkg = line[1..line.len() - 1].trim().to_string();
+            current_pkg = Some(pkg);
+            continue;
+        }
+        let target = match &current_pkg {
+            Some(pkg) => rules.per_pkg.entry(pkg.clone()).or_default(),
+            None => &mut rules.global,
+        };
+        if let Some((k, v)) = line.split_once('=') {
+            let k = k.trim().to_ascii_lowercase();
+            let v = v.trim().to_string();
+            match k.as_str() {
+                "system" => target.system = Some(v),
+                "vendor" => target.vendor = Some(v),
+                "boot" => target.boot = Some(v),
+                "all" => {
+                    target.system = Some(v.clone());
+                    target.vendor = Some(v.clone());
+                    target.boot = Some(v);
+                }
+                _ => {}
+            }
+        } else if !line.contains('=') {
+            let v = line.to_string();
+            target.system = Some(v.clone());
+            target.vendor = Some(v.clone());
+            target.boot = Some(v);
+        }
+    }
+    rules
+}
+
+fn current_patch_rules(dir: &Path) -> PatchRules {
+    let path = dir.join("security_patch.txt");
+    let stamp = FileStamp::from_path(&path);
+    {
+        let r = PATCH_CACHE.read().unwrap();
+        if r.dir == dir && r.stamp == stamp {
+            return r.rules.clone();
+        }
+    }
+    let mut w = PATCH_CACHE.write().unwrap();
+    if w.dir == dir && w.stamp == stamp {
+        return w.rules.clone();
+    }
+    let rules = if !stamp.exists {
+        PatchRules::default()
+    } else {
+        fs::read_to_string(&path).map(|s| parse_security_patch_txt(&s)).unwrap_or_default()
+    };
+    w.dir = dir.to_path_buf();
+    w.stamp = stamp;
+    w.rules = rules.clone();
+    rules
+}
+
+fn current_ymd_utc() -> (i32, u32, u32) {
+    let secs = SystemTime::now().duration_since(UNIX_EPOCH).map(|d| d.as_secs() as i64).unwrap_or(0);
+    // Civil date from Unix days (Howard Hinnant algorithm).
+    let z = secs.div_euclid(86400) + 719468;
+    let era = if z >= 0 { z } else { z - 146096 } / 146097;
+    let doe = (z - era * 146097) as u64;
+    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+    let y = (yoe as i64) + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = (doy - (153 * mp + 2) / 5 + 1) as u32;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 } as u32;
+    let year = (y + if m <= 2 { 1 } else { 0 }) as i32;
+    (year, m, d)
+}
+
+pub(crate) fn parse_patch_date_str(val: &str, long_format: bool) -> Option<i32> {
+    let (cy, cm, cd) = current_ymd_utc();
+    let resolved = val
+        .replace("YYYY", &format!("{cy:04}"))
+        .replace("yyyy", &format!("{cy:04}"))
+        .replace("MM", &format!("{cm:02}"))
+        .replace("mm", &format!("{cm:02}"))
+        .replace("DD", &format!("{cd:02}"))
+        .replace("dd", &format!("{cd:02}"));
+    let digits: String = resolved.chars().filter(|c| c.is_ascii_digit()).collect();
+    if digits.len() == 6 {
+        let y: i32 = digits[0..4].parse().ok()?;
+        let m: i32 = digits[4..6].parse().ok()?;
+        if !(1..=12).contains(&m) {
+            return None;
+        }
+        Some(if long_format { y * 10000 + m * 100 + 1 } else { y * 100 + m })
+    } else if digits.len() == 8 {
+        let y: i32 = digits[0..4].parse().ok()?;
+        let m: i32 = digits[4..6].parse().ok()?;
+        let d: i32 = digits[6..8].parse().ok()?;
+        if !(1..=12).contains(&m) || !(1..=31).contains(&d) {
+            return None;
+        }
+        Some(if long_format { y * 10000 + m * 100 + d } else { y * 100 + m })
+    } else {
+        None
+    }
+}
+
+fn resolve_patch_component(
+    spec: Option<&str>,
+    prop_name: &str,
+    long_format: bool,
+) -> PatchValue {
+    let Some(s) = spec else {
+        return PatchValue::DeviceDefault;
+    };
+    if s.eq_ignore_ascii_case("device_default") {
+        return PatchValue::DeviceDefault;
+    }
+    if s.eq_ignore_ascii_case("no") {
+        return PatchValue::Omit;
+    }
+    if s.eq_ignore_ascii_case("prop") {
+        let pv = rustutils::android::system_properties::read(prop_name)
+            .ok()
+            .flatten()
+            .filter(|v| !v.trim().is_empty())
+            .or_else(|| {
+                if prop_name == "ro.vendor.build.security_patch" {
+                    rustutils::android::system_properties::read("ro.build.version.security_patch")
+                        .ok()
+                        .flatten()
+                        .filter(|v| !v.trim().is_empty())
+                } else {
+                    None
+                }
+            });
+        if let Some(pv) = pv {
+            if let Some(parsed) = parse_patch_date_str(&pv, long_format) {
+                return PatchValue::Fixed(parsed);
+            }
+        }
+        return PatchValue::DeviceDefault;
+    }
+    if s.eq_ignore_ascii_case("today") {
+        let (cy, cm, cd) = current_ymd_utc();
+        return PatchValue::Fixed(if long_format {
+            cy * 10000 + (cm as i32) * 100 + (cd as i32)
+        } else {
+            cy * 100 + (cm as i32)
+        });
+    }
+    parse_patch_date_str(s, long_format).map(PatchValue::Fixed).unwrap_or(PatchValue::DeviceDefault)
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct ResolvedPatchLevels {
+    pub(crate) os: PatchValue,
+    pub(crate) vendor: PatchValue,
+    pub(crate) boot: PatchValue,
+}
+
+fn resolve_patch_levels_for_pkgs(dir: &Path, pkgs: &[String]) -> ResolvedPatchLevels {
+    let rules = current_patch_rules(dir);
+    let mut pkg_entry: Option<&PatchEntry> = None;
+    for p in pkgs {
+        if let Some(e) = rules.per_pkg.get(p) {
+            pkg_entry = Some(e);
+            break;
+        }
+    }
+    let sys_spec = pkg_entry.and_then(|e| e.system.as_deref()).or(rules.global.system.as_deref());
+    let ven_spec = pkg_entry.and_then(|e| e.vendor.as_deref()).or(rules.global.vendor.as_deref());
+    let boot_spec = pkg_entry.and_then(|e| e.boot.as_deref()).or(rules.global.boot.as_deref());
+    ResolvedPatchLevels {
+        os: resolve_patch_component(sys_spec, "ro.build.version.security_patch", false),
+        vendor: resolve_patch_component(ven_spec, "ro.vendor.build.security_patch", true),
+        boot: resolve_patch_component(boot_spec, "ro.vendor.build.security_patch", true),
+    }
+}
