+/// Target spoofing mode for an app.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum TargetMode {
+    /// Try real TEE + leaf-hack first, automatically fall back to `kmr-ta` on TEE failure.
+    Auto,
+    /// Prefer real TEE + leaf-hack; fall back to `kmr-ta` if TEE fails.
+    LeafHack,
+    /// Always generate keys and attestation certificates in `kmr-ta`.
+    Generate,
+    /// Explicitly excluded (`-pkg`); pass straight through to real TEE.
+    Ignore,
+}
