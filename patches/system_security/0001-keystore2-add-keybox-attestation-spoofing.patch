+    #[test]
+    fn test_policy_and_fallback_rules() {
+        let base = vec![
+            KeyParameter { tag: Tag::ALGORITHM, value: KeyParameterValue::Algorithm(Algorithm::EC) },
+            KeyParameter { tag: Tag::NO_AUTH_REQUIRED, value: KeyParameterValue::BoolValue(true) },
+        ];
+        assert!(software_policy_supported(&base));
+
+        let mut with_auth = base.clone();
+        with_auth.push(KeyParameter { tag: Tag::USER_SECURE_ID, value: KeyParameterValue::LongInteger(1) });
+        assert!(!software_policy_supported(&with_auth));
+
+        let mut no_auth_flag = vec![
+            KeyParameter { tag: Tag::ALGORITHM, value: KeyParameterValue::Algorithm(Algorithm::EC) },
+        ];
+        assert!(software_policy_supported(&no_auth_flag));
+        no_auth_flag.push(KeyParameter {
+            tag: Tag::UNLOCKED_DEVICE_REQUIRED,
+            value: KeyParameterValue::BoolValue(true),
+        });
+        assert!(software_policy_supported(&no_auth_flag));
+        assert!(should_fallback_to_software(&Error::Km(ErrorCode::CANNOT_ATTEST_IDS), &base));
+        assert!(should_fallback_to_software(
+            &Error::Rc(crate::error::ResponseCode::OUT_OF_KEYS_TRANSIENT_ERROR),
+            &base
+        ));
+        assert!(!should_fallback_to_software(&Error::Km(ErrorCode::INVALID_INPUT_LENGTH), &base));
+        assert!(!should_fallback_to_software(&Error::Km(ErrorCode::UNSUPPORTED_ALGORITHM), &base));
+
+        let ok_ch = vec![KeyParameter {
+            tag: Tag::ATTESTATION_CHALLENGE,
+            value: KeyParameterValue::Blob(vec![0x41; 128]),
+        }];
+        assert!(validate_challenge_len(&ok_ch).is_ok());
+        let bad_ch = vec![KeyParameter {
+            tag: Tag::ATTESTATION_CHALLENGE,
+            value: KeyParameterValue::Blob(vec![0x41; 129]),
+        }];
+        assert!(matches!(
+            validate_challenge_len(&bad_ch),
+            Err(Error::Km(ErrorCode::INVALID_INPUT_LENGTH))
+        ));
+    }
