+#[derive(Debug, Clone)]
+struct AttestSecrets {
+    root_kek: [u8; 32],
+    unique_id_hbk: [u8; 32],
+    fallback_boot_key: [u8; 32],
+    fallback_boot_hash: [u8; 32],
+    blob_hmac_key: [u8; 32],
+}
+
+static ATTEST_SECRETS: LazyLock<Mutex<Option<(PathBuf, AttestSecrets)>>> =
+    LazyLock::new(|| Mutex::new(None));
+
+fn db_root() -> PathBuf {
+    DB_PATH.read().map(|p| p.clone()).unwrap_or_else(|_| PathBuf::from("/data/misc/keystore"))
+}
+
+fn load_or_create_secrets_at(dir: &Path) -> AttestSecrets {
+    let mut guard = ATTEST_SECRETS.lock().unwrap();
+    if let Some((cached_dir, secrets)) = &*guard {
+        if cached_dir == dir {
+            return secrets.clone();
+        }
+    }
+    let path = dir.join(".attest_state");
+    if let Ok(text) = fs::read_to_string(&path) {
+        if let Some(parsed) = parse_secrets(&text) {
+            *guard = Some((dir.to_path_buf(), parsed.clone()));
+            return parsed;
+        }
+    }
+    let secrets = AttestSecrets {
+        root_kek: random_32(),
+        unique_id_hbk: random_32(),
+        fallback_boot_key: random_32(),
+        fallback_boot_hash: random_32(),
+        blob_hmac_key: random_32(),
+    };
+    if let Err(e) = save_secrets(&path, &secrets) {
+        warn!("failed to persist attest state at {path:?}: {e:?}");
+    }
+    *guard = Some((dir.to_path_buf(), secrets.clone()));
+    secrets
+}
+
+fn random_32() -> [u8; 32] {
+    let mut out = [0u8; 32];
+    if let Ok(v) = generate_random_data(32) {
+        if v.len() == 32 {
+            out.copy_from_slice(&v);
+            return out;
+        }
+    }
+    // Fallback should never be reached because BoringSSL RAND_bytes succeeds.
+    for (i, b) in out.iter_mut().enumerate() {
+        *b = (i as u8).wrapping_mul(0x5d).wrapping_add(0x37);
+    }
+    out
+}
+
+fn parse_secrets(text: &str) -> Option<AttestSecrets> {
+    let mut map = HashMap::new();
+    for line in text.lines() {
+        if let Some((k, v)) = line.trim().split_once('=') {
+            map.insert(k.trim(), v.trim());
+        }
+    }
+    let decode32 = |key: &str| -> Option<[u8; 32]> {
+        let bytes = hex::decode(map.get(key)?).ok()?;
+        let arr: [u8; 32] = bytes.try_into().ok()?;
+        if arr.iter().all(|&b| b == 0) {
+            return None;
+        }
+        Some(arr)
+    };
+    Some(AttestSecrets {
+        root_kek: decode32("root_kek")?,
+        unique_id_hbk: decode32("hbk")?,
+        fallback_boot_key: decode32("boot_key")?,
+        fallback_boot_hash: decode32("boot_hash")?,
+        blob_hmac_key: decode32("blob_hmac")?,
+    })
+}
+
+fn save_secrets(path: &Path, s: &AttestSecrets) -> Result<()> {
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent)?;
+    }
+    let tmp = path.with_extension("tmp");
+    let content = format!(
+        "root_kek={}\nhbk={}\nboot_key={}\nboot_hash={}\nblob_hmac={}\n",
+        hex::encode(s.root_kek),
+        hex::encode(s.unique_id_hbk),
+        hex::encode(s.fallback_boot_key),
+        hex::encode(s.fallback_boot_hash),
+        hex::encode(s.blob_hmac_key),
+    );
+    let mut f = fs::OpenOptions::new().create(true).write(true).truncate(true).mode(0o600).open(&tmp)?;
+    f.write_all(content.as_bytes())?;
+    f.sync_all()?;
+    drop(f);
+    fs::rename(&tmp, path)?;
+    Ok(())
+}
