+
+#[derive(Debug, Clone, Default)]
+struct TargetRules {
+    has_file: bool,
+    default_mode: Option<TargetMode>,
+    packages: HashMap<String, TargetMode>,
+}
+
+struct CachedTargets {
+    dir: PathBuf,
+    stamp: FileStamp,
+    rules: TargetRules,
+}
+
+static TARGET_CACHE: LazyLock<RwLock<CachedTargets>> = LazyLock::new(|| {
+    RwLock::new(CachedTargets {
+        dir: PathBuf::new(),
+        stamp: FileStamp { exists: false, len: 0, modified_nanos: 0 },
+        rules: TargetRules::default(),
+    })
+});
+
+fn parse_target_txt(text: &str) -> TargetRules {
+    let mut rules = TargetRules { has_file: true, default_mode: None, packages: HashMap::new() };
+    for raw_line in text.lines() {
+        let line = raw_line.split('#').next().unwrap_or("").trim();
+        if line.is_empty() {
+            continue;
+        }
+        if line == "*" {
+            rules.default_mode = Some(TargetMode::Auto);
+            continue;
+        }
+        if line == "*!" {
+            rules.default_mode = Some(TargetMode::Generate);
+            continue;
+        }
+        if line == "*?" {
+            rules.default_mode = Some(TargetMode::LeafHack);
+            continue;
+        }
+        if let Some(pkg) = line.strip_prefix('-') {
+            let pkg = pkg.trim();
+            if !pkg.is_empty() {
+                rules.packages.insert(pkg.to_string(), TargetMode::Ignore);
+            }
+        } else if let Some(pkg) = line.strip_suffix('!') {
+            let pkg = pkg.trim();
+            if !pkg.is_empty() {
+                rules.packages.insert(pkg.to_string(), TargetMode::Generate);
+            }
+        } else if let Some(pkg) = line.strip_suffix('?') {
+            let pkg = pkg.trim();
+            if !pkg.is_empty() {
+                rules.packages.insert(pkg.to_string(), TargetMode::LeafHack);
+            }
+        } else {
+            rules.packages.insert(line.to_string(), TargetMode::Auto);
+        }
+    }
+    rules
+}
+
+fn current_target_rules(dir: &Path) -> TargetRules {
+    let path = dir.join("target.txt");
+    let stamp = FileStamp::from_path(&path);
+    {
+        let r = TARGET_CACHE.read().unwrap();
+        if r.dir == dir && r.stamp == stamp {
+            return r.rules.clone();
+        }
+    }
+    let mut w = TARGET_CACHE.write().unwrap();
+    if w.dir == dir && w.stamp == stamp {
+        return w.rules.clone();
+    }
+    let rules = if !stamp.exists {
+        TargetRules::default()
+    } else {
+        fs::read_to_string(&path).map(|s| parse_target_txt(&s)).unwrap_or_default()
+    };
+    w.dir = dir.to_path_buf();
+    w.stamp = stamp;
+    w.rules = rules.clone();
+    rules
+}
