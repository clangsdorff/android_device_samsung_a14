+        let hw_params = strip_device_id_params(&req_params);
+        assert_eq!(hw_params.len(), 3);
+        assert!(!has_device_id_attestation(&hw_params));
+        assert!(hw_params.iter().any(|p| p.tag == Tag::USER_SECURE_ID));
+
+        let tee_seq = der_wrap(&[0x30], &der_encode_context_explicit(
+            704,
+            &encode_root_of_trust(&[0x11; 32], &[0x22; 32]).unwrap(),
+        ));
+        let sw_seq = der_wrap(&[0x30], &[]);
+        let mut kd_body = Vec::new();
+        kd_body.extend_from_slice(&der_encode_integer_i64(200).unwrap());
+        kd_body.extend_from_slice(&[0x0a, 0x01, 0x01]);
+        kd_body.extend_from_slice(&der_encode_integer_i64(200).unwrap());
+        kd_body.extend_from_slice(&[0x0a, 0x01, 0x01]);
+        kd_body.extend_from_slice(&der_encode_octet_string(b"c").unwrap());
+        kd_body.extend_from_slice(&der_encode_octet_string(b"").unwrap());
+        kd_body.extend_from_slice(&sw_seq);
+        kd_body.extend_from_slice(&tee_seq);
+        let kd = der_wrap(&[0x30], &kd_body);
+        let levels = ResolvedPatchLevels {
+            os: PatchValue::DeviceDefault,
+            vendor: PatchValue::DeviceDefault,
+            boot: PatchValue::DeviceDefault,
+        };
+        let patched = patch_attestation_extension(&kd, tmp.path(), &levels, &req_params).unwrap();
+        let elems = parse_sequence_elements(&patched).unwrap();
+        let tee_out = parse_sequence_elements(elems[7].1).unwrap();
+        let tags: Vec<u32> = tee_out.iter().map(|(t, _, _)| *t).collect();
+        assert_eq!(tags, vec![704, 710, 711, 712, 713, 714, 716, 717, 723]);
+    }
+
+    #[test]
+    fn test_patch_stored_cert_chain_re_roots_and_is_idempotent() {
+        let tmp = TempDir::new().unwrap();
+        fs::write(tmp.path().join("keybox.xml"), ec_only_keybox_xml()).unwrap();
+        {
+            let mut p = DB_PATH.write().unwrap();
+            *p = tmp.path().to_path_buf();
+        }
+        let full = parse_keybox_xml(&full_test_keybox_xml(), 1).unwrap();
+        let rsa_entry = full.rsa.as_ref().unwrap();
+        let ec_entry = parse_keybox_xml(&ec_only_keybox_xml(), 2).unwrap().ec.unwrap();
+        let aaid = vec![0x30, 0x06, 0x31, 0x00, 0x31, 0x02, 0x04, 0x00];
+        let gen_params = vec![
+            KeyParameter { tag: Tag::ALGORITHM, value: KeyParameterValue::Algorithm(Algorithm::EC) },
+            KeyParameter { tag: Tag::EC_CURVE, value: KeyParameterValue::EcCurve(AidlEcCurve::P_256) },
+            KeyParameter { tag: Tag::PURPOSE, value: KeyParameterValue::KeyPurpose(KeyPurpose::SIGN) },
+            KeyParameter { tag: Tag::DIGEST, value: KeyParameterValue::Digest(Digest::SHA_2_256) },
+            KeyParameter { tag: Tag::NO_AUTH_REQUIRED, value: KeyParameterValue::BoolValue(true) },
+            KeyParameter { tag: Tag::ATTESTATION_CHALLENGE, value: KeyParameterValue::Blob(b"old".to_vec()) },
+            KeyParameter { tag: Tag::ATTESTATION_APPLICATION_ID, value: KeyParameterValue::Blob(aaid) },
+            KeyParameter { tag: Tag::CERTIFICATE_NOT_BEFORE, value: KeyParameterValue::DateTime(0) },
+            KeyParameter { tag: Tag::CERTIFICATE_NOT_AFTER, value: KeyParameterValue::DateTime(253402300799000) },
+        ];
+        let base_res = generate_key_software(
+            AppUid(10097),
+            SecurityLevel::TRUSTED_ENVIRONMENT,
+            200,
+            &gen_params,
+            None,
+        )
+        .unwrap();
+        let base_leaf = &base_res.certificateChain[0].encodedCertificate;
+        let ext_octets = extract_extension_from_certificate(base_leaf, ATTESTATION_OID_CSTR).unwrap();
+        let old_leaf = resign_leaf_certificate(
+            base_leaf,
+            &rsa_entry.certs_der[0],
+            &rsa_entry.priv_key,
+            ATTESTATION_OID_CSTR,
+            &ext_octets,
+        )
+        .unwrap();
+
+        let mut cert = Some(old_leaf.clone());
+        let mut chain = Some(rsa_entry.certs_der[0].clone());
+        patch_stored_cert_chain(AppUid(10097), &mut cert, &mut chain);
+        let leaf1 = cert.clone().unwrap();
+        let chain1 = chain.clone().unwrap();
+        assert!(keystore2_crypto::verify_cert_signature(&leaf1, &ec_entry.certs_der[0]));
+        assert_eq!(chain1, ec_entry.certs_der[0]);
+
+        // Repeated get_key_entry calls must return byte-for-byte identical leaf & chain.
+        patch_stored_cert_chain(AppUid(10097), &mut cert, &mut chain);
+        assert_eq!(cert.as_ref().unwrap(), &leaf1);
+        assert_eq!(chain.as_ref().unwrap(), &chain1);
+
+        let mut attest_key_child_cert = Some(old_leaf.clone());
+        let mut empty_chain: Option<Vec<u8>> = None;
+        patch_stored_cert_chain(AppUid(10097), &mut attest_key_child_cert, &mut empty_chain);
+        assert_eq!(attest_key_child_cert.as_ref(), Some(&old_leaf));
+        assert!(empty_chain.is_none());
+    }
+}
