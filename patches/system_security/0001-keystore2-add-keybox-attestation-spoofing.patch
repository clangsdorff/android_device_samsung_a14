+fn packages_for_uid(uid: AppUid) -> Vec<String> {
+    let Ok(pm) = binder::get_interface::<dyn IPackageManagerNative>("package_native") else {
+        return Vec::new();
+    };
+    let Ok(Some(infos)) = pm.getPackageInfoWithSigningInfoForUid(uid.0 as i32) else {
+        return Vec::new();
+    };
+    infos.into_iter().flatten().map(|i| i.packageName).filter(|n| !n.is_empty()).collect()
+}
