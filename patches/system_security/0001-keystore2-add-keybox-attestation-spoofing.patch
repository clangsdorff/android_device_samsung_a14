+fn parse_prop_hex32(name: &str, reject_empty_sha256: bool) -> Option<[u8; 32]> {
+    let val = rustutils::android::system_properties::read(name).ok().flatten()?;
+    let trimmed = val.trim();
+    if trimmed.len() != 64 {
+        return None;
+    }
+    let bytes = hex::decode(trimmed).ok()?;
+    let arr: [u8; 32] = bytes.try_into().ok()?;
+    if arr.iter().all(|&b| b == 0) {
+        return None;
+    }
+    if reject_empty_sha256 && arr == EMPTY_SHA256 {
+        return None;
+    }
+    Some(arr)
+}
+
+fn non_zero_32(bytes: &[u8]) -> Option<[u8; 32]> {
+    let arr: [u8; 32] = bytes.try_into().ok()?;
+    if arr.iter().all(|&b| b == 0) {
+        None
+    } else {
+        Some(arr)
+    }
+}
