+#[derive(Debug, Clone)]
+pub(crate) struct KeyboxEntry {
+    pub(crate) priv_key: ParsedPemPrivateKey,
+    pub(crate) certs_der: Vec<Vec<u8>>,
+}
+
+#[derive(Debug, Clone, Default)]
+pub(crate) struct KeyboxSnapshot {
+    pub(crate) ec: Option<KeyboxEntry>,
+    pub(crate) rsa: Option<KeyboxEntry>,
+    pub(crate) generation: u64,
+}
+
+impl KeyboxSnapshot {
+    pub(crate) fn is_loaded(&self) -> bool {
+        self.ec.is_some() || self.rsa.is_some()
+    }
+
+    pub(crate) fn pick_for_algorithm(&self, algo: Algorithm) -> Option<&KeyboxEntry> {
+        match algo {
+            Algorithm::RSA => self.rsa.as_ref().or(self.ec.as_ref()),
+            _ => self.ec.as_ref().or(self.rsa.as_ref()),
+        }
+    }
+
+    pub(crate) fn pick_for_signing_algo(&self, algo: SigningAlgorithm) -> Option<&KeyboxEntry> {
+        match algo {
+            SigningAlgorithm::Rsa => self.rsa.as_ref().or(self.ec.as_ref()),
+            SigningAlgorithm::Ec => self.ec.as_ref().or(self.rsa.as_ref()),
+        }
+    }
+}
+
+struct CachedKeybox {
+    dir: PathBuf,
+    stamp: FileStamp,
+    snapshot: Arc<KeyboxSnapshot>,
+}
+
+static KEYBOX_CACHE: LazyLock<RwLock<CachedKeybox>> = LazyLock::new(|| {
+    RwLock::new(CachedKeybox {
+        dir: PathBuf::new(),
+        stamp: FileStamp { exists: false, len: 0, modified_nanos: 0 },
+        snapshot: Arc::new(KeyboxSnapshot::default()),
+    })
+});
+
+fn current_keybox_at(dir: &Path) -> Arc<KeyboxSnapshot> {
+    let path = dir.join("keybox.xml");
+    let stamp = FileStamp::from_path(&path);
+    {
+        let r = KEYBOX_CACHE.read().unwrap();
+        if r.dir == dir && r.stamp == stamp {
+            return r.snapshot.clone();
+        }
+    }
+    let mut w = KEYBOX_CACHE.write().unwrap();
+    if w.dir == dir && w.stamp == stamp {
+        return w.snapshot.clone();
+    }
+    let next_gen = w.snapshot.generation.wrapping_add(1).max(1);
+    let snap = if !stamp.exists {
+        KeyboxSnapshot { ec: None, rsa: None, generation: next_gen }
+    } else {
+        match fs::read_to_string(&path) {
+            Ok(xml) => match parse_keybox_xml(&xml, next_gen) {
+                Ok(s) => {
+                    info!(
+                        "loaded keybox.xml (ec={}, rsa={}, gen={})",
+                        s.ec.is_some(),
+                        s.rsa.is_some(),
+                        s.generation
+                    );
+                    s
+                }
+                Err(e) => {
+                    error!("failed to parse keybox.xml: {e:?}");
+                    KeyboxSnapshot { ec: None, rsa: None, generation: next_gen }
+                }
+            },
+            Err(e) => {
+                error!("failed to read keybox.xml: {e:?}");
+                KeyboxSnapshot { ec: None, rsa: None, generation: next_gen }
+            }
+        }
+    };
+    w.dir = dir.to_path_buf();
+    w.stamp = stamp;
+    w.snapshot = Arc::new(snap);
+    w.snapshot.clone()
+}
+
+fn strip_xml_comments(input: &str) -> String {
+    let mut out = String::with_capacity(input.len());
+    let mut rest = input.trim_start_matches('\u{feff}');
+    while let Some(start) = rest.find("<!--") {
+        out.push_str(&rest[..start]);
+        let after = &rest[start + 4..];
+        if let Some(end) = after.find("-->") {
+            rest = &after[end + 3..];
+        } else {
+            rest = "";
+            break;
+        }
+    }
+    out.push_str(rest);
+    out
+}
+
+fn unwrap_cdata(s: &str) -> &str {
+    let t = s.trim();
+    if let Some(inner) = t.strip_prefix("<![CDATA[") {
+        if let Some(body) = inner.strip_suffix("]]>") {
+            return body.trim();
+        }
+    }
+    t
+}
+
+// BoringSSL PEM_read_bio requires markers at column 0 and rejects indented base64 lines > 65 bytes.
+fn normalize_pem(s: &str) -> String {
+    let inner = unwrap_cdata(s);
+    let mut out = String::with_capacity(inner.len() + 1);
+    for line in inner.lines() {
+        let trimmed = line.trim();
+        if !trimmed.is_empty() {
+            out.push_str(trimmed);
+            out.push('\n');
+        }
+    }
+    out
+}
+
+fn extract_tag_blocks<'a>(haystack: &'a str, tag: &str) -> Vec<&'a str> {
+    let mut blocks = Vec::new();
+    let open_prefix = format!("<{tag}");
+    let close_tag = format!("</{tag}>");
+    let mut pos = 0;
+    while let Some(rel_start) = haystack[pos..].find(&open_prefix) {
+        let start = pos + rel_start;
+        let after_name = start + open_prefix.len();
+        let next_ch = haystack[after_name..].chars().next();
+        if !matches!(next_ch, Some('>' | ' ' | '\t' | '\r' | '\n' | '/')) {
+            pos = after_name;
+            continue;
+        }
+        let Some(gt_rel) = haystack[after_name..].find('>') else { break };
+        let body_start = after_name + gt_rel + 1;
+        // Skip self-closing tag.
+        if haystack[after_name..body_start - 1].trim_end().ends_with('/') {
+            pos = body_start;
+            continue;
+        }
+        let Some(end_rel) = haystack[body_start..].find(&close_tag) else { break };
+        let body_end = body_start + end_rel;
+        blocks.push(&haystack[body_start..body_end]);
+        pos = body_end + close_tag.len();
+    }
+    blocks
+}
+
+pub(crate) fn parse_keybox_xml(xml: &str, generation: u64) -> Result<KeyboxSnapshot> {
+    let cleaned = strip_xml_comments(xml);
+    let key_blocks = extract_tag_blocks(&cleaned, "Key");
+    if key_blocks.is_empty() {
+        return Err(anyhow!("no <Key> elements in keybox.xml"));
+    }
+
+    let mut snap = KeyboxSnapshot { ec: None, rsa: None, generation };
+
+    for key_body in key_blocks {
+        let priv_blocks = extract_tag_blocks(key_body, "PrivateKey");
+        let Some(priv_raw) = priv_blocks.first() else {
+            warn!("skipping <Key> entry without <PrivateKey>");
+            continue;
+        };
+        let priv_pem = normalize_pem(priv_raw);
+        let priv_key = match parse_pem_private_key(priv_pem.as_bytes()) {
+            Ok(k) => k,
+            Err(e) => {
+                warn!("failed to parse <PrivateKey> PEM: {e:?}");
+                continue;
+            }
+        };
+
+        let cert_blocks = extract_tag_blocks(key_body, "Certificate");
+        let mut certs_der = Vec::with_capacity(cert_blocks.len());
+        for c_raw in cert_blocks {
+            let c_pem = normalize_pem(c_raw);
+            if c_pem.is_empty() {
+                continue;
+            }
+            match parse_pem_certificate(c_pem.as_bytes()) {
+                Ok(der) => certs_der.push(der),
+                Err(e) => warn!("failed to parse <Certificate> PEM: {e:?}"),
+            }
+        }
+        if certs_der.is_empty() {
+            warn!("skipping <Key> entry with empty certificate chain");
+            continue;
+        }
+        if !verify_cert_matches_private_key(&certs_der[0], &priv_key) {
+            warn!("skipping <Key> entry: leaf certificate public key mismatches private key");
+            continue;
+        }
+        let _ = parse_subject_from_certificate(&certs_der[0])
+            .context("extracting subject from keybox cert[0]")?;
+        let is_ec = matches!(priv_key, ParsedPemPrivateKey::Ec { .. });
+        let entry = KeyboxEntry { priv_key, certs_der };
+        if is_ec {
+            if snap.ec.is_none() {
+                snap.ec = Some(entry);
+            }
+        } else if snap.rsa.is_none() {
+            snap.rsa = Some(entry);
+        }
+    }
+
+    if !snap.is_loaded() {
+        return Err(anyhow!("no valid EC or RSA keybox entries found"));
+    }
+    Ok(snap)
+}
