+    #[test]
+    fn test_patch_attestation_extension_rewrites_rot_and_patchlevels() {
+        let tmp = TempDir::new().unwrap();
+        // Build synthetic KeyDescription with unlocked RootOfTrust (all-zero key/hash, locked=false, state=2).
+        let unlocked_rot = {
+            let mut body = Vec::new();
+            body.extend_from_slice(&der_encode_octet_string(&[0u8; 32]).unwrap());
+            body.extend_from_slice(&[0x01, 0x01, 0x00]); // deviceLocked = FALSE
+            body.extend_from_slice(&[0x0a, 0x01, 0x02]); // Unverified (2)
+            body.extend_from_slice(&der_encode_octet_string(&[0u8; 32]).unwrap());
+            der_wrap(&[0x30], &body)
+        };
+        let mut tee_body = Vec::new();
+        tee_body.extend_from_slice(&der_encode_context_explicit(
+            2,
+            &der_encode_integer_i64(3).unwrap(),
+        ));
+        tee_body.extend_from_slice(&der_encode_context_explicit(704, &unlocked_rot));
+        tee_body.extend_from_slice(&der_encode_context_explicit(
+            705,
+            &der_encode_integer_i64(170000).unwrap(),
+        ));
+        tee_body.extend_from_slice(&der_encode_context_explicit(
+            706,
+            &der_encode_integer_i64(202501).unwrap(),
+        ));
+        tee_body.extend_from_slice(&der_encode_context_explicit(
+            719,
+            &der_encode_integer_i64(20250105).unwrap(),
+        ));
+        let tee_seq = der_wrap(&[0x30], &tee_body);
+        let sw_seq = der_wrap(&[0x30], &[]);
+        let mut kd_body = Vec::new();
+        kd_body.extend_from_slice(&der_encode_integer_i64(200).unwrap());
+        kd_body.extend_from_slice(&[0x0a, 0x01, 0x01]);
+        kd_body.extend_from_slice(&der_encode_integer_i64(200).unwrap());
+        kd_body.extend_from_slice(&[0x0a, 0x01, 0x01]);
+        kd_body.extend_from_slice(&der_encode_octet_string(b"challenge").unwrap());
+        kd_body.extend_from_slice(&der_encode_octet_string(b"").unwrap());
+        kd_body.extend_from_slice(&sw_seq);
+        kd_body.extend_from_slice(&tee_seq);
+        let ext = der_wrap(&[0x30], &kd_body);
+
+        let patch = ResolvedPatchLevels {
+            os: PatchValue::Fixed(202611),
+            vendor: PatchValue::Fixed(20261105),
+            boot: PatchValue::Omit,
+        };
+        let patched = patch_attestation_extension(&ext, tmp.path(), &patch, &[]).unwrap();
+        let top = parse_sequence_elements(&patched).unwrap();
+        assert_eq!(top.len(), 8);
+        let tee_elems = parse_sequence_elements(top[7].1).unwrap();
+        // Verify strictly ascending tag numbers and bootPatchLevel omitted.
+        let tags: Vec<u32> = tee_elems.iter().map(|(t, _, _)| *t).collect();
+        assert_eq!(tags, vec![2, 704, 705, 706, 718]);
+
+        let rot_inner = tee_elems.iter().find(|(t, _, _)| *t == 704).unwrap().2;
+        let rot_fields = parse_sequence_elements(rot_inner).unwrap();
+        assert_eq!(rot_fields.len(), 4);
+        assert!(rot_fields[0].2.iter().any(|&b| b != 0)); // verifiedBootKey non-zero
+        assert_eq!(rot_fields[1].2, &[0xff]); // deviceLocked = true
+        assert_eq!(rot_fields[2].2, &[0x00]); // Verified = 0
+        assert!(rot_fields[3].2.iter().any(|&b| b != 0)); // verifiedBootHash non-zero
+    }
