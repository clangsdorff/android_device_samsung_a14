+
+struct PersistKeyMaterial {
+    dir: PathBuf,
+}
+
+impl RetrieveKeyMaterial for PersistKeyMaterial {
+    fn root_kek(&self, _context: &[u8]) -> Result<OpaqueOr<kmr_common::crypto::hmac::Key>, KmrError> {
+        let s = load_or_create_secrets_at(&self.dir);
+        Ok(kmr_common::crypto::hmac::Key::new(s.root_kek.to_vec()).into())
+    }
+
+    fn kak(&self) -> Result<OpaqueOr<kmr_common::crypto::aes::Key>, KmrError> {
+        let s = load_or_create_secrets_at(&self.dir);
+        let mut kak = [0u8; 32];
+        for (dst, src) in kak.iter_mut().zip(s.root_kek.iter()) {
+            *dst = src ^ 0xa5;
+        }
+        Ok(kmr_common::crypto::aes::Key::Aes256(kak).into())
+    }
+
+    fn unique_id_hbk(&self, _ckdf: &dyn crypto::Ckdf) -> Result<kmr_common::crypto::hmac::Key, KmrError> {
+        let s = load_or_create_secrets_at(&self.dir);
+        kmr_common::crypto::hmac::Key::new_from(&s.unique_id_hbk)
+    }
+}
+
+struct KeyboxCertSignInfo {
+    dir: PathBuf,
+}
+
+impl RetrieveCertSigningInfo for KeyboxCertSignInfo {
+    fn signing_key(&self, key_type: SigningKeyType) -> Result<KeyMaterial, KmrError> {
+        let kb = current_keybox_at(&self.dir);
+        let entry = kb.pick_for_signing_algo(key_type.algo_hint).ok_or_else(|| {
+            kmr_common::km_err!(AttestationKeysNotProvisioned, "no keybox entry loaded")
+        })?;
+        match &entry.priv_key {
+            ParsedPemPrivateKey::Ec { curve, sec1_der } => {
+                let nist = ec::NistKey(sec1_der.clone());
+                let (kmr_curve, key) = match curve {
+                    EcCurveKind::P224 => (EcCurve::P224, ec::Key::P224(nist)),
+                    EcCurveKind::P256 => (EcCurve::P256, ec::Key::P256(nist)),
+                    EcCurveKind::P384 => (EcCurve::P384, ec::Key::P384(nist)),
+                    EcCurveKind::P521 => (EcCurve::P521, ec::Key::P521(nist)),
+                };
+                Ok(KeyMaterial::Ec(kmr_curve, CurveType::Nist, key.into()))
+            }
+            ParsedPemPrivateKey::Rsa { pkcs1_der } => {
+                Ok(KeyMaterial::Rsa(rsa::Key(pkcs1_der.clone()).into()))
+            }
+        }
+    }
+
+    fn cert_chain(&self, key_type: SigningKeyType) -> Result<Vec<kmr_wire::keymint::Certificate>, KmrError> {
+        let kb = current_keybox_at(&self.dir);
+        let entry = kb.pick_for_signing_algo(key_type.algo_hint).ok_or_else(|| {
+            kmr_common::km_err!(AttestationKeysNotProvisioned, "no keybox entry loaded")
+        })?;
+        Ok(entry
+            .certs_der
+            .iter()
+            .map(|c| kmr_wire::keymint::Certificate { encoded_certificate: c.clone() })
+            .collect())
+    }
+}
