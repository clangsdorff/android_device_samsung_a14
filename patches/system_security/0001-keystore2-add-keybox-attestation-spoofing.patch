+// -----------------------------------------------------------------------------
+// Software KeyBlob Wrapping (matches km_compat pattern)
+// -----------------------------------------------------------------------------
+/// Returns true if `blob` is an HMAC-authenticated software KeyMint blob.
+pub fn is_sw_keyblob(blob: &[u8]) -> bool {
+    unwrap_sw_keyblob(blob).is_some()
+}
+
+/// Validates and strips the software KeyMint blob prefix and HMAC tag.
+pub fn unwrap_sw_keyblob(blob: &[u8]) -> Option<&[u8]> {
+    if !blob.starts_with(SW_KM_BLOB_PREFIX) {
+        return None;
+    }
+    let rest = &blob[SW_KM_BLOB_PREFIX.len()..];
+    if rest.len() < HMAC_SHA256_LEN {
+        return None;
+    }
+    let (inner, want_tag) = rest.split_at(rest.len() - HMAC_SHA256_LEN);
+    let secrets = load_or_create_secrets_at(&db_root());
+    let got_tag = hmac_sha256(&secrets.blob_hmac_key, inner).ok()?;
+    let mut diff = 0u8;
+    for (a, b) in want_tag.iter().zip(got_tag.iter()) {
+        diff |= a ^ b;
+    }
+    if diff == 0 {
+        Some(inner)
+    } else {
+        None
+    }
+}
+
+fn wrap_sw_keyblob(inner: &[u8]) -> Result<Vec<u8>, Error> {
+    let secrets = load_or_create_secrets_at(&db_root());
+    let tag = hmac_sha256(&secrets.blob_hmac_key, inner)
+        .map_err(|_| Error::Rc(crate::error::ResponseCode::SYSTEM_ERROR))?;
+    let mut out = Vec::with_capacity(SW_KM_BLOB_PREFIX.len() + inner.len() + HMAC_SHA256_LEN);
+    out.extend_from_slice(SW_KM_BLOB_PREFIX);
+    out.extend_from_slice(inner);
+    out.extend_from_slice(&tag);
+    Ok(out)
+}
+
+fn ensure_creation_datetime(params: &[KeyParameter]) -> Vec<KeyParameter> {
+    if params.iter().any(|kp| kp.tag == Tag::CREATION_DATETIME) {
+        return params.to_vec();
+    }
+    let mut out = params.to_vec();
+    let now_ms = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_millis() as i64)
+        .unwrap_or(0);
+    out.push(KeyParameter {
+        tag: Tag::CREATION_DATETIME,
+        value: KeyParameterValue::DateTime(now_ms),
+    });
+    out
+}
+
+fn unwrap_attest_key(attest_key: Option<&AttestationKey>) -> Option<AttestationKey> {
+    let ak = attest_key?;
+    let unwrapped = unwrap_sw_keyblob(&ak.keyBlob).unwrap_or(&ak.keyBlob).to_vec();
+    Some(AttestationKey {
+        keyBlob: unwrapped,
+        attestKeyParams: ak.attestKeyParams.clone(),
+        issuerSubjectName: ak.issuerSubjectName.clone(),
+    })
+}
+
+fn apply_sw_patch_overrides(
+    caller_uid: AppUid,
+    res: &mut KeyCreationResult,
+) -> Result<(), Error> {
+    let dir = db_root();
+    let pkgs = packages_for_uid(caller_uid);
+    let patch_levels = resolve_patch_levels_for_pkgs(&dir, &pkgs);
+    let any_override = !matches!(patch_levels.os, PatchValue::DeviceDefault)
+        || !matches!(patch_levels.vendor, PatchValue::DeviceDefault)
+        || !matches!(patch_levels.boot, PatchValue::DeviceDefault);
+    if !any_override {
+        return Ok(());
+    }
+    patch_key_characteristics(&mut res.keyCharacteristics, &patch_levels);
+    if res.certificateChain.is_empty() {
+        return Ok(());
+    }
+    let leaf_der = &res.certificateChain[0].encodedCertificate;
+    let Ok(ext_octets) = extract_extension_from_certificate(leaf_der, ATTESTATION_OID_CSTR) else {
+        return Ok(());
+    };
+    let keybox = current_keybox_at(&dir);
+    let algo = detect_leaf_algorithm(&res.keyCharacteristics);
+    let Some(kb) = keybox.pick_for_algorithm(algo) else {
+        return Ok(());
+    };
+    let patched_ext = patch_attestation_extension(&ext_octets, &dir, &patch_levels, &[])
+        .map_err(|_| Error::Rc(crate::error::ResponseCode::SYSTEM_ERROR))?;
+    let resigned = resign_leaf_certificate(
+        leaf_der,
+        &kb.certs_der[0],
+        &kb.priv_key,
+        ATTESTATION_OID_CSTR,
+        &patched_ext,
+    )
+    .map_err(|_| Error::Rc(crate::error::ResponseCode::SYSTEM_ERROR))?;
+    res.certificateChain[0].encodedCertificate = resigned;
+    Ok(())
+}
+/// Generates a key in the in-process `kmr-ta` software KeyMint instance.
+pub fn generate_key_software(
+    caller_uid: AppUid,
+    sec_level: SecurityLevel,
+    hw_version: i32,
+    params: &[KeyParameter],
+    attest_key: Option<&AttestationKey>,
+) -> Result<KeyCreationResult, Error> {
+    let params = ensure_creation_datetime(params);
+    latch_device_ids_from_params(&params);
+    let unwrapped_ak = unwrap_attest_key(attest_key);
+    let mut res = with_soft_device(sec_level, hw_version, |dev| {
+        dev.generateKey(&params, unwrapped_ak.as_ref())
+    })?;
+    res.keyBlob = wrap_sw_keyblob(&res.keyBlob)?;
+    if attest_key.is_none() {
+        apply_sw_patch_overrides(caller_uid, &mut res)?;
+    }
+    Ok(res)
+}
+/// Imports a key in the in-process `kmr-ta` software KeyMint instance.
+pub fn import_key_software(
+    caller_uid: AppUid,
+    sec_level: SecurityLevel,
+    hw_version: i32,
+    params: &[KeyParameter],
+    format: KeyFormat,
+    key_data: &[u8],
+    attest_key: Option<&AttestationKey>,
+) -> Result<KeyCreationResult, Error> {
+    let params = ensure_creation_datetime(params);
+    latch_device_ids_from_params(&params);
+    let unwrapped_ak = unwrap_attest_key(attest_key);
+    let mut res = with_soft_device(sec_level, hw_version, |dev| {
+        dev.importKey(&params, format, key_data, unwrapped_ak.as_ref())
+    })?;
+    res.keyBlob = wrap_sw_keyblob(&res.keyBlob)?;
+    if attest_key.is_none() {
+        apply_sw_patch_overrides(caller_uid, &mut res)?;
+    }
+    Ok(res)
+}
