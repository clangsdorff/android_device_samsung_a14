+#[derive(Debug)]
+struct LocalTaChannel {
+    in_tx: mpsc::Sender<Vec<u8>>,
+    out_rx: mpsc::Receiver<Vec<u8>>,
+}
+
+impl LocalTaChannel {
+    fn new(dir: PathBuf, sec_level: SecurityLevel, hw_version: i32) -> Self {
+        let (in_tx, in_rx) = mpsc::channel::<Vec<u8>>();
+        let (out_tx, out_rx) = mpsc::channel::<Vec<u8>>();
+        let kmr_sec_level = match sec_level {
+            SecurityLevel::STRONGBOX => KmrSecurityLevel::Strongbox,
+            _ => KmrSecurityLevel::TrustedEnvironment,
+        };
+        std::thread::spawn(move || {
+            let hw_info = HardwareInfo {
+                version_number: hw_version.max(100),
+                security_level: kmr_sec_level,
+                impl_name: "KeyMint",
+                author_name: "Google",
+                unique_id: "KeyMint",
+            };
+            let rpc_info = RpcInfo::V3(RpcInfoV3 {
+                author_name: "Google",
+                unique_id: "KeyMint",
+                fused: true,
+                supported_num_of_keys_in_csr: MINIMUM_SUPPORTED_KEYS_IN_CSR,
+            });
+            let imp = kmr_crypto_boring::implementation(
+                Box::new(BoringRng),
+                Box::new(StdBootClock),
+            );
+            let dev = TaDevImpl {
+                keys: Box::new(PersistKeyMaterial { dir: dir.clone() }),
+                sign_info: Some(Box::new(KeyboxCertSignInfo { dir })),
+                attest_ids: None,
+                sdd_mgr: None,
+                bootloader: Box::new(BootloaderDone),
+                sk_wrapper: None,
+                tup: Box::new(TrustedPresenceUnsupported),
+                legacy_key: None,
+                rpc: Box::new(NoOpRetrieveRpcArtifacts),
+            };
+            let allowed_versions = vec![
+                KeyMintHalVersion::V1,
+                KeyMintHalVersion::V2,
+                KeyMintHalVersion::V3,
+                KeyMintHalVersion::V4,
+                KeyMintHalVersion::V5,
+            ];
+            let mut ta = KeyMintTa::new_allowing_versions(
+                hw_info,
+                rpc_info,
+                imp,
+                dev,
+                allowed_versions,
+            );
+            let hal_ver = normalize_hal_version(hw_version);
+            let _ = ta.set_hal_version(hal_ver);
+            let base = cached_tee_baseline();
+            let os_patch = parse_patch_date_str(
+                &read_prop_or("ro.build.version.security_patch", "2026-01-01"),
+                false,
+            )
+            .map(|v| v as u32)
+            .or_else(|| base.and_then(|b| b.os_patchlevel))
+            .unwrap_or(202601);
+            let vendor_patch = parse_patch_date_str(
+                &read_prop_or(
+                    "ro.vendor.build.security_patch",
+                    &read_prop_or("ro.build.version.security_patch", "2026-01-01"),
+                ),
+                true,
+            )
+            .map(|v| v as u32)
+            .or_else(|| base.and_then(|b| b.vendor_patchlevel))
+            .unwrap_or(20260101);
+            let os_version = base.and_then(|b| b.os_version).unwrap_or_else(parse_os_version_u32);
+            ta.set_hal_info(HalInfo {
+                os_version,
+                os_patchlevel: os_patch,
+                vendor_patchlevel: vendor_patch,
+            });
+            while let Ok(req) = in_rx.recv() {
+                let rsp = ta.process(&req);
+                if out_tx.send(rsp).is_err() {
+                    break;
+                }
+            }
+        });
+        Self { in_tx, out_rx }
+    }
+}
+
+impl SerializedChannel for LocalTaChannel {
+    const MAX_SIZE: usize = usize::MAX;
+
+    fn execute(&mut self, req_data: &[u8]) -> binder::Result<Vec<u8>> {
+        self.in_tx
+            .send(req_data.to_vec())
+            .map_err(|_| binder::Status::new_exception(binder::ExceptionCode::TRANSACTION_FAILED, None))?;
+        self.out_rx
+            .recv()
+            .map_err(|_| binder::Status::new_exception(binder::ExceptionCode::TRANSACTION_FAILED, None))
+    }
+}
+
+fn read_prop_or(name: &str, default: &str) -> String {
+    rustutils::android::system_properties::read(name)
+        .ok()
+        .flatten()
+        .filter(|s| !s.is_empty())
+        .unwrap_or_else(|| default.to_string())
+}
+
+fn attestation_prop_bytes(suffix: &str) -> Vec<u8> {
+    let for_attest = format!("ro.product.{suffix}_for_attestation");
+    if let Ok(Some(v)) = rustutils::android::system_properties::read(&for_attest) {
+        if !v.is_empty() {
+            return v.into_bytes();
+        }
+    }
+    let prod = format!("ro.product.{suffix}");
+    read_prop_or(&prod, "").into_bytes()
+}
+
+fn parse_os_version_u32() -> u32 {
+    let rel = read_prop_or("ro.build.version.release", "17");
+    let mut parts = rel.split('.');
+    let major: u32 = parts.next().and_then(|s| s.parse().ok()).unwrap_or(17);
+    let minor: u32 = parts.next().and_then(|s| s.parse().ok()).unwrap_or(0);
+    let sub: u32 = parts.next().and_then(|s| s.parse().ok()).unwrap_or(0);
+    major * 10000 + minor * 100 + sub
+}
+
+fn normalize_hal_version(hw_version: i32) -> u32 {
+    match hw_version {
+        v if v >= 500 => 500,
+        v if v >= 400 => 400,
+        v if v >= 300 => 300,
+        v if v >= 200 => 200,
+        _ => 100,
+    }
+}
+
+#[derive(Clone, Default)]
+struct LatchedDeviceIds {
+    gen: u64,
+    serial: Vec<u8>,
+    imei: Vec<u8>,
+    imei2: Vec<u8>,
+    meid: Vec<u8>,
+}
+
+static LATCHED_DEVICE_IDS: LazyLock<Mutex<LatchedDeviceIds>> =
+    LazyLock::new(|| Mutex::new(LatchedDeviceIds::default()));
+
+// `keystore` lacks SELinux access to `serialno_prop` and telephony IMEI/MEID.
+// Callers reaching `generate_key_software` / `import_key_software` have already
+// passed `check_device_attestation_permissions()`, so latch empty fields once.
+fn latch_device_ids_from_params(params: &[KeyParameter]) {
+    let mut guard = LATCHED_DEVICE_IDS.lock().unwrap();
+    let mut changed = false;
+    for kp in params {
+        let KeyParameterValue::Blob(bytes) = &kp.value else { continue };
+        if bytes.is_empty() {
+            continue;
+        }
+        let slot = match kp.tag {
+            Tag::ATTESTATION_ID_SERIAL => &mut guard.serial,
+            Tag::ATTESTATION_ID_IMEI => &mut guard.imei,
+            Tag::ATTESTATION_ID_SECOND_IMEI => &mut guard.imei2,
+            Tag::ATTESTATION_ID_MEID => &mut guard.meid,
+            _ => continue,
+        };
+        if slot.is_empty() {
+            *slot = bytes.clone();
+            changed = true;
+        }
+    }
+    if changed {
+        guard.gen = guard.gen.wrapping_add(1).max(1);
+    }
+}
+
+struct SoftKeyMintInstance {
+    dir: PathBuf,
+    hw_version: i32,
+    keybox_gen: u64,
+    ids_gen: u64,
+    module_hash_sent: bool,
+    device: kmr_hal::keymint::Device<LocalTaChannel>,
+}
+
+impl SoftKeyMintInstance {
+    fn new(
+        dir: PathBuf,
+        sec_level: SecurityLevel,
+        hw_version: i32,
+        keybox_gen: u64,
+        ids: &LatchedDeviceIds,
+    ) -> Self {
+        let channel = Arc::new(Mutex::new(LocalTaChannel::new(dir.clone(), sec_level, hw_version)));
+        {
+            let mut ch = channel.lock().unwrap();
+            let (boot_key, boot_hash) = resolve_root_of_trust_values(&dir, None, None);
+            let boot_patch = parse_patch_date_str(
+                &read_prop_or(
+                    "ro.vendor.build.security_patch",
+                    &read_prop_or("ro.build.version.security_patch", "2026-01-01"),
+                ),
+                true,
+            )
+            .map(|v| v as u32)
+            .or_else(|| cached_tee_baseline().and_then(|b| b.boot_patchlevel))
+            .unwrap_or(20260101);
+            let _ = kmr_hal::send_boot_info(
+                ch.deref_mut(),
+                SetBootInfoRequest {
+                    verified_boot_key: boot_key.to_vec(),
+                    device_boot_locked: true,
+                    verified_boot_state: 0,
+                    verified_boot_hash: boot_hash.to_vec(),
+                    boot_patchlevel: boot_patch,
+                },
+            );
+            let _ = kmr_hal::send_attest_ids(
+                ch.deref_mut(),
+                AttestationIdInfo {
+                    brand: attestation_prop_bytes("brand"),
+                    device: attestation_prop_bytes("device"),
+                    product: attestation_prop_bytes("name"),
+                    serial: ids.serial.clone(),
+                    imei: ids.imei.clone(),
+                    imei2: ids.imei2.clone(),
+                    meid: ids.meid.clone(),
+                    manufacturer: attestation_prop_bytes("manufacturer"),
+                    model: attestation_prop_bytes("model"),
+                },
+            );
+        }
+        let device = kmr_hal::keymint::Device::new(channel);
+        let mut inst = Self {
+            dir,
+            hw_version,
+            keybox_gen,
+            ids_gen: ids.gen,
+            module_hash_sent: false,
+            device,
+        };
+        inst.maybe_send_module_hash();
+        inst
+    }
+
+    fn maybe_send_module_hash(&mut self) {
+        if self.module_hash_sent {
+            return;
+        }
+        if normalize_hal_version(self.hw_version) < 400 {
+            self.module_hash_sent = true;
+            return;
+        }
+        let hash_opt = ENCODED_MODULE_INFO
+            .read()
+            .ok()
+            .and_then(|g| g.clone())
+            .map(|enc| digest::Sha256::hash(&enc).to_vec())
+            .or_else(|| cached_tee_baseline().and_then(|b| b.module_hash.clone()));
+        if let Some(hash) = hash_opt {
+            let kps = vec![KeyParameter {
+                tag: Tag::MODULE_HASH,
+                value: KeyParameterValue::Blob(hash),
+            }];
+            if self.device.setAdditionalAttestationInfo(&kps).is_ok() {
+                self.module_hash_sent = true;
+            }
+        }
+    }
+}
+
+// One SoftKeyMintInstance per SecurityLevel (TEE and optional StrongBox).
+static SOFT_INSTANCES: LazyLock<Mutex<HashMap<i32, SoftKeyMintInstance>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+fn with_soft_device_raw<F, R>(sec_level: SecurityLevel, hw_version: i32, f: F) -> binder::Result<R>
+where
+    F: FnOnce(&kmr_hal::keymint::Device<LocalTaChannel>) -> binder::Result<R>,
+{
+    let dir = db_root();
+    let gen = current_keybox_at(&dir).generation;
+    let ids = LATCHED_DEVICE_IDS.lock().unwrap().clone();
+    let mut map = SOFT_INSTANCES.lock().unwrap();
+    let entry = map.entry(sec_level.0).or_insert_with(|| {
+        SoftKeyMintInstance::new(dir.clone(), sec_level, hw_version, gen, &ids)
+    });
+    if entry.dir != dir || entry.keybox_gen != gen || entry.ids_gen != ids.gen {
+        *entry = SoftKeyMintInstance::new(dir, sec_level, hw_version, gen, &ids);
+    } else {
+        entry.maybe_send_module_hash();
+    }
+    f(&entry.device)
+}
+
+fn with_soft_device<F, R>(sec_level: SecurityLevel, hw_version: i32, f: F) -> Result<R, Error>
+where
+    F: FnOnce(&kmr_hal::keymint::Device<LocalTaChannel>) -> binder::Result<R>,
+{
+    map_km_error(with_soft_device_raw(sec_level, hw_version, f))
+}
