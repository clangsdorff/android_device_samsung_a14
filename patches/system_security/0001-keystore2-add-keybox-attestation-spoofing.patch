+            KeyParameter {
+                tag: Tag::DEVICE_UNIQUE_ATTESTATION,
+                value: KeyParameterValue::BoolValue(true),
+            },
+        ];
+        // When no keybox.xml is loaded, decide_action MUST return Passthrough so GMS keeps
+        // normal TEE attestation and MEETS_BASIC_INTEGRITY does not break.
+        let tmp = TempDir::new().unwrap();
