+/// Returns true when the caller is an unprivileged app (`app_id >= 10000`) in `Domain::APP`.
+pub fn is_unprivileged_app(uid: AppUid, domain: Domain) -> bool {
+    if domain != Domain::APP {
+        return false;
+    }
+    let raw_uid = u32::try_from(uid.0).unwrap_or(0);
+    (raw_uid % AID_USER_OFFSET) >= FIRST_APP_UID
+}
+/// Returns true when key creation requests attestation or device IDs.
+pub fn has_attestation_request(params: &[KeyParameter], has_attest_key_desc: bool) -> bool {
+    has_attest_key_desc
+        || params.iter().any(|kp| {
+            matches!(
+                kp.tag,
+                Tag::ATTESTATION_CHALLENGE
+                    | Tag::ATTESTATION_ID_BRAND
+                    | Tag::ATTESTATION_ID_DEVICE
+                    | Tag::ATTESTATION_ID_PRODUCT
+                    | Tag::ATTESTATION_ID_SERIAL
+                    | Tag::ATTESTATION_ID_IMEI
+                    | Tag::ATTESTATION_ID_SECOND_IMEI
+                    | Tag::ATTESTATION_ID_MEID
+                    | Tag::ATTESTATION_ID_MANUFACTURER
+                    | Tag::ATTESTATION_ID_MODEL
+                    | Tag::DEVICE_UNIQUE_ATTESTATION
+            )
+        })
+}
+/// Returns true when `Tag::PURPOSE` includes `KeyPurpose::ATTEST_KEY`.
+pub fn has_purpose_attest_key(params: &[KeyParameter]) -> bool {
+    params.iter().any(|kp| {
+        kp.tag == Tag::PURPOSE
+            && matches!(kp.value, KeyParameterValue::KeyPurpose(KeyPurpose::ATTEST_KEY))
+    })
+}
+/// Returns true when parameters request device-identifier or unique attestation.
+pub fn has_device_id_attestation(params: &[KeyParameter]) -> bool {
+    params.iter().any(|kp| {
+        matches!(
+            kp.tag,
+            Tag::ATTESTATION_ID_BRAND
+                | Tag::ATTESTATION_ID_DEVICE
+                | Tag::ATTESTATION_ID_PRODUCT
+                | Tag::ATTESTATION_ID_SERIAL
+                | Tag::ATTESTATION_ID_IMEI
+                | Tag::ATTESTATION_ID_SECOND_IMEI
+                | Tag::ATTESTATION_ID_MEID
+                | Tag::ATTESTATION_ID_MANUFACTURER
+                | Tag::ATTESTATION_ID_MODEL
+                | Tag::DEVICE_UNIQUE_ATTESTATION
+        )
+    })
+}
+/// Returns parameters with hardware device-identifier and unique-attestation tags removed.
+pub fn strip_device_id_params(params: &[KeyParameter]) -> Vec<KeyParameter> {
+    params
+        .iter()
+        .filter(|kp| {
+            !matches!(
+                kp.tag,
+                Tag::ATTESTATION_ID_BRAND
+                    | Tag::ATTESTATION_ID_DEVICE
+                    | Tag::ATTESTATION_ID_PRODUCT
+                    | Tag::ATTESTATION_ID_SERIAL
+                    | Tag::ATTESTATION_ID_IMEI
+                    | Tag::ATTESTATION_ID_SECOND_IMEI
+                    | Tag::ATTESTATION_ID_MEID
+                    | Tag::ATTESTATION_ID_MANUFACTURER
+                    | Tag::ATTESTATION_ID_MODEL
+                    | Tag::DEVICE_UNIQUE_ATTESTATION
+            )
+        })
+        .cloned()
+        .collect()
+}
+
+fn attest_id_tag_number(tag: Tag) -> Option<u32> {
+    match tag {
+        Tag::ATTESTATION_ID_BRAND => Some(710),
+        Tag::ATTESTATION_ID_DEVICE => Some(711),
+        Tag::ATTESTATION_ID_PRODUCT => Some(712),
+        Tag::ATTESTATION_ID_SERIAL => Some(713),
+        Tag::ATTESTATION_ID_IMEI => Some(714),
+        Tag::ATTESTATION_ID_MEID => Some(715),
+        Tag::ATTESTATION_ID_MANUFACTURER => Some(716),
+        Tag::ATTESTATION_ID_MODEL => Some(717),
+        Tag::ATTESTATION_ID_SECOND_IMEI => Some(723),
+        _ => None,
+    }
+}
+/// Returns true when authorization tags are compatible with software `kmr-ta` fallback.
+pub fn software_policy_supported(params: &[KeyParameter]) -> bool {
+    !params.iter().any(|kp| {
+        matches!(
+            kp.tag,
+            Tag::USER_SECURE_ID
+                | Tag::USER_AUTH_TYPE
+                | Tag::AUTH_TIMEOUT
+                | Tag::ALLOW_WHILE_ON_BODY
+                | Tag::TRUSTED_USER_PRESENCE_REQUIRED
+                | Tag::TRUSTED_CONFIRMATION_REQUIRED
+                | Tag::EARLY_BOOT_ONLY
+                | Tag::ROLLBACK_RESISTANCE
+                | Tag::STORAGE_KEY
+                | Tag::IDENTITY_CREDENTIAL_KEY
+        )
+    })
+}
+/// Validates that any `ATTESTATION_CHALLENGE` tag does not exceed 128 bytes.
+pub fn validate_challenge_len(params: &[KeyParameter]) -> Result<(), Error> {
+    for kp in params {
+        if kp.tag == Tag::ATTESTATION_CHALLENGE {
+            if let KeyParameterValue::Blob(bytes) = &kp.value {
+                if bytes.len() > MAX_ATTESTATION_CHALLENGE_BYTES {
+                    return Err(Error::Km(ErrorCode::INVALID_INPUT_LENGTH));
+                }
+            }
+        }
+    }
+    Ok(())
+}
+/// Determines how key generation/import should handle attestation for a caller.
+pub fn decide_action(
+    caller_uid: AppUid,
+    domain: Domain,
+    params: &[KeyParameter],
+    has_attest_key_desc: bool,
+) -> AttestAction {
+    if !is_unprivileged_app(caller_uid, domain) {
+        return AttestAction::Passthrough;
+    }
+    let dir = db_root();
+    let rules = current_target_rules(&dir);
+    let mode = if !rules.has_file {
+        TargetMode::Auto
+    } else {
+        let pkgs = packages_for_uid(caller_uid);
+        let mut matched = None;
+        for pkg in &pkgs {
+            if let Some(&m) = rules.packages.get(pkg) {
+                matched = Some(m);
+                break;
+            }
+        }
+        matched.or(rules.default_mode).unwrap_or(TargetMode::Ignore)
+    };
+    if mode == TargetMode::Ignore {
+        return AttestAction::Passthrough;
+    }
+    let keybox = current_keybox_at(&dir);
+    if !keybox.is_loaded() {
+        AttestAction::Passthrough
+    } else if has_attestation_request(params, has_attest_key_desc)
+        || has_purpose_attest_key(params)
+    {
+        AttestAction::SpoofWithKeybox(mode)
+    } else {
+        AttestAction::Passthrough
+    }
+}
+/// Returns true if a real TEE error should fall back to in-process `kmr-ta`.
+pub fn should_fallback_to_software(err: &Error, params: &[KeyParameter]) -> bool {
+    if !software_policy_supported(params) {
+        return false;
+    }
+    match err {
+        Error::Km(code) => {
+            // Do not mask explicit caller contract violations (oversized challenge, unsupported key size/algo, etc.)
+            !matches!(
+                *code,
+                ErrorCode::INVALID_INPUT_LENGTH
+                    | ErrorCode::UNSUPPORTED_ALGORITHM
+                    | ErrorCode::UNSUPPORTED_KEY_SIZE
+                    | ErrorCode::UNSUPPORTED_EC_CURVE
+                    | ErrorCode::INCOMPATIBLE_PURPOSE
+                    | ErrorCode::UNSUPPORTED_PURPOSE
+                    | ErrorCode::UNSUPPORTED_DIGEST
+                    | ErrorCode::INCOMPATIBLE_DIGEST
+                    | ErrorCode::UNSUPPORTED_PADDING_MODE
+                    | ErrorCode::INCOMPATIBLE_PADDING_MODE
+                    | ErrorCode::UNSUPPORTED_BLOCK_MODE
+                    | ErrorCode::INCOMPATIBLE_BLOCK_MODE
+                    | ErrorCode::MISSING_NOT_BEFORE
+                    | ErrorCode::MISSING_NOT_AFTER
+                    | ErrorCode::MEMORY_ALLOCATION_FAILED
+            )
+        }
+        Error::Rc(rc) => {
+            matches!(
+                *rc,
+                crate::error::ResponseCode::SYSTEM_ERROR
+                    | crate::error::ResponseCode::OUT_OF_KEYS_PERMANENT_ERROR
+                    | crate::error::ResponseCode::OUT_OF_KEYS_TRANSIENT_ERROR
+                    | crate::error::ResponseCode::OUT_OF_KEYS_PENDING_INTERNET_CONNECTIVITY
+            )
+        }
+        Error::Binder(_, _) | Error::BinderTransaction(_) => true,
+    }
+}
