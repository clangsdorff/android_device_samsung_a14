+/// Parsed private key kind and curve NID.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ParsedPemPrivateKey {
+    /// SEC1 EC private key with curve kind.
+    Ec {
+        /// NIST EC curve.
+        curve: EcCurveKind,
+        /// SEC1 DER-encoded EC private key.
+        sec1_der: Vec<u8>,
+    },
+    /// PKCS#1 RSA private key.
+    Rsa {
+        /// PKCS#1 DER-encoded RSA private key.
+        pkcs1_der: Vec<u8>,
+    },
+}
+
+/// Supported EC curves for PEM keybox private keys.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum EcCurveKind {
+    /// NIST P-224.
+    P224,
+    /// NIST P-256.
+    P256,
+    /// NIST P-384.
+    P384,
+    /// NIST P-521.
+    P521,
+}
+
+fn call_resizing_c_buf<F>(initial_cap: usize, err: Error, mut f: F) -> Result<Vec<u8>, Error>
+where
+    F: FnMut(*mut u8, usize) -> libc::c_int,
+{
+    let mut buf = vec![0u8; initial_cap];
+    let mut size = f(buf.as_mut_ptr(), buf.len());
+    if size == 0 {
+        return Err(err);
+    }
+    if size < 0 {
+        let needed = usize::try_from(-size).map_err(|_| err.clone_for_resizing())?;
+        buf = vec![0u8; needed];
+        size = f(buf.as_mut_ptr(), buf.len());
+        if size <= 0 {
+            return Err(err);
+        }
+    }
+    let safe_size = usize::try_from(size).map_err(|_| err.clone_for_resizing())?;
+    buf.truncate(safe_size);
+    Ok(buf)
+}
+
+trait ErrorCloneHelper {
+    fn clone_for_resizing(&self) -> Self;
+}
+
+impl ErrorCloneHelper for Error {
+    fn clone_for_resizing(&self) -> Self {
+        match self {
+            Error::ParsePemCertificateFailed => Error::ParsePemCertificateFailed,
+            Error::ParsePemPrivateKeyFailed => Error::ParsePemPrivateKeyFailed,
+            Error::ExtractExtensionFailed => Error::ExtractExtensionFailed,
+            Error::ResignCertificateFailed => Error::ResignCertificateFailed,
+            _ => Error::ExtractSubjectFailed,
+        }
+    }
+}
+
+/// Parse a PEM-encoded X.509 certificate into DER bytes.
+pub fn parse_pem_certificate(pem: &[u8]) -> Result<Vec<u8>, Error> {
+    if pem.is_empty() {
+        return Err(Error::ParsePemCertificateFailed);
+    }
+    call_resizing_c_buf(1024, Error::ParsePemCertificateFailed, |out_ptr, out_cap| {
+        // SAFETY: pem and out_ptr point to valid buffers of lengths pem.len() and out_cap.
+        unsafe { parsePemCertificate(pem.as_ptr(), pem.len(), out_ptr, out_cap) }
+    })
+}
+
+/// Parse a PEM-encoded private key (PKCS#8, SEC1 EC, or PKCS#1 RSA) into SEC1/PKCS#1 DER.
+pub fn parse_pem_private_key(pem: &[u8]) -> Result<ParsedPemPrivateKey, Error> {
+    if pem.is_empty() {
+        return Err(Error::ParsePemPrivateKeyFailed);
+    }
+    let mut kind: libc::c_int = 0;
+    let mut ec_curve: libc::c_int = 0;
+    let der = call_resizing_c_buf(2048, Error::ParsePemPrivateKeyFailed, |out_ptr, out_cap| {
+        // SAFETY: pem, kind, ec_curve, and out_ptr are valid pointers for this call.
+        unsafe {
+            parsePemPrivateKey(
+                pem.as_ptr(),
+                pem.len(),
+                &mut kind,
+                &mut ec_curve,
+                out_ptr,
+                out_cap,
+            )
+        }
+    })?;
+    match kind {
+        1 => {
+            let curve = match ec_curve {
+                1 => EcCurveKind::P224,
+                2 => EcCurveKind::P256,
+                3 => EcCurveKind::P384,
+                4 => EcCurveKind::P521,
+                _ => return Err(Error::ParsePemPrivateKeyFailed),
+            };
+            Ok(ParsedPemPrivateKey::Ec { curve, sec1_der: der })
+        }
+        2 => Ok(ParsedPemPrivateKey::Rsa { pkcs1_der: der }),
+        _ => Err(Error::ParsePemPrivateKeyFailed),
+    }
+}
+
+/// Verify a DER certificate's signature against an issuer DER certificate's public key.
+pub fn verify_cert_signature(cert_der: &[u8], issuer_cert_der: &[u8]) -> bool {
+    if cert_der.is_empty() || issuer_cert_der.is_empty() {
+        return false;
+    }
+    // SAFETY: cert_der and issuer_cert_der are valid byte slices of the passed lengths.
+    unsafe {
+        verifyCertSignature(
+            cert_der.as_ptr(),
+            cert_der.len(),
+            issuer_cert_der.as_ptr(),
+            issuer_cert_der.len(),
+        )
+    }
+}
+
+/// Check whether a DER certificate's public key matches the parsed private key.
+pub fn verify_cert_matches_private_key(cert_der: &[u8], key: &ParsedPemPrivateKey) -> bool {
+    if cert_der.is_empty() {
+        return false;
+    }
+    let (kind, priv_der) = match key {
+        ParsedPemPrivateKey::Ec { sec1_der, .. } => (1, sec1_der.as_slice()),
+        ParsedPemPrivateKey::Rsa { pkcs1_der } => (2, pkcs1_der.as_slice()),
+    };
+    // SAFETY: cert_der and priv_der are valid byte slices of the passed lengths.
+    unsafe {
+        verifyCertMatchesPrivateKey(
+            cert_der.as_ptr(),
+            cert_der.len(),
+            kind,
+            priv_der.as_ptr(),
+            priv_der.len(),
+        )
+    }
+}
+
+/// Extract the raw OCTET STRING value of an X.509 extension by OID.
+pub fn extract_extension_from_certificate(
+    cert_der: &[u8],
+    oid_cstr: &std::ffi::CStr,
+) -> Result<Vec<u8>, Error> {
+    if cert_der.is_empty() {
+        return Err(Error::ExtractExtensionFailed);
+    }
+    call_resizing_c_buf(1024, Error::ExtractExtensionFailed, |out_ptr, out_cap| {
+        // SAFETY: cert_der, oid_cstr, and out_ptr are valid for the passed lengths.
+        unsafe {
+            extractExtensionFromCertificate(
+                cert_der.as_ptr(),
+                cert_der.len(),
+                oid_cstr.as_ptr(),
+                out_ptr,
+                out_cap,
+            )
+        }
+    })
+}
+
+/// Re-sign a DER leaf certificate with an issuer certificate and private key, replacing the
+/// extension OCTET STRING payload for `oid_cstr` and updating/clearing AuthorityKeyIdentifier.
+pub fn resign_leaf_certificate(
+    leaf_der: &[u8],
+    issuer_cert_der: &[u8],
+    key: &ParsedPemPrivateKey,
+    oid_cstr: &std::ffi::CStr,
+    attest_ext_octets: &[u8],
+) -> Result<Vec<u8>, Error> {
+    if leaf_der.is_empty() || issuer_cert_der.is_empty() || attest_ext_octets.is_empty() {
+        return Err(Error::ResignCertificateFailed);
+    }
+    let (kind, priv_der) = match key {
+        ParsedPemPrivateKey::Ec { sec1_der, .. } => (1, sec1_der.as_slice()),
+        ParsedPemPrivateKey::Rsa { pkcs1_der } => (2, pkcs1_der.as_slice()),
+    };
+    call_resizing_c_buf(2048, Error::ResignCertificateFailed, |out_ptr, out_cap| {
+        // SAFETY: all input slices, oid_cstr, and out_ptr are valid for the passed lengths.
+        unsafe {
+            resignLeafCertificate(
+                leaf_der.as_ptr(),
+                leaf_der.len(),
+                issuer_cert_der.as_ptr(),
+                issuer_cert_der.len(),
+                kind,
+                priv_der.as_ptr(),
+                priv_der.len(),
+                oid_cstr.as_ptr(),
+                attest_ext_octets.as_ptr(),
+                attest_ext_octets.len(),
+                out_ptr,
+                out_cap,
+            )
+        }
+    })
+}
