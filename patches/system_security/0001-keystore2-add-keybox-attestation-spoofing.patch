+/// File modification stamp used for lock-free/cheap hot-reload checks.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+struct FileStamp {
+    exists: bool,
+    len: u64,
+    modified_nanos: u128,
+}
+
+impl FileStamp {
+    fn from_path(path: &Path) -> Self {
+        match fs::metadata(path) {
+            Ok(meta) => {
+                let modified_nanos = meta
+                    .modified()
+                    .ok()
+                    .and_then(|t| t.duration_since(UNIX_EPOCH).ok())
+                    .map(|d| d.as_nanos())
+                    .unwrap_or(0);
+                Self { exists: true, len: meta.len(), modified_nanos }
+            }
+            Err(_) => Self { exists: false, len: 0, modified_nanos: 0 },
+        }
+    }
+}
