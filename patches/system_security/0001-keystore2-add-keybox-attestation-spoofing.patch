+        tee_body.extend_from_slice(&der_encode_context_explicit(704, &unlocked_rot));
+        tee_body.extend_from_slice(&der_encode_context_explicit(706, &der_encode_integer_i64(202501).unwrap()));
+        tee_body.extend_from_slice(&der_encode_context_explicit(718, &der_encode_integer_i64(20250105).unwrap()));
+        let tee_seq = der_wrap(&[0x30], &tee_body);
+        let sw_seq = der_wrap(&[0x30], &[]);
+        // Legacy Keymaster swap: teeEnforced at index 6, softwareEnforced at index 7.
+        let mut kd_body = Vec::new();
+        kd_body.extend_from_slice(&der_encode_integer_i64(4).unwrap());
+        kd_body.extend_from_slice(&[0x0a, 0x01, 0x01]);
+        kd_body.extend_from_slice(&der_encode_integer_i64(4).unwrap());
+        kd_body.extend_from_slice(&[0x0a, 0x01, 0x01]);
+        kd_body.extend_from_slice(&der_encode_octet_string(b"c").unwrap());
+        kd_body.extend_from_slice(&der_encode_octet_string(b"").unwrap());
+        kd_body.extend_from_slice(&tee_seq);
+        kd_body.extend_from_slice(&sw_seq);
+        let kd = der_wrap(&[0x30], &kd_body);
+
+        let levels = ResolvedPatchLevels {
+            os: PatchValue::Omit,
+            vendor: PatchValue::DeviceDefault,
+            boot: PatchValue::Fixed(20261105),
+        };
+        let patched = patch_attestation_extension(&kd, tmp.path(), &levels, &[]).unwrap();
+        let elems = parse_sequence_elements(&patched).unwrap();
+        let tee_out = parse_sequence_elements(elems[6].1).unwrap();
+        assert!(tee_out.iter().any(|(t, _, _)| *t == 704));
+        assert!(!tee_out.iter().any(|(t, _, _)| *t == 706));
+        assert!(tee_out.iter().any(|(t, _, _)| *t == 718));
