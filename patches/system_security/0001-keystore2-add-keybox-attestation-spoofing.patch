+    fn test_parse_keybox_xml_ec_pkcs8_and_rsa() {
+        let snap = parse_keybox_xml(&full_test_keybox_xml(), 1).expect("parse full keybox");
+        assert!(snap.ec.is_some());
+        assert!(snap.rsa.is_some());
+        assert!(snap.pick_for_algorithm(Algorithm::EC).is_some());
+        assert!(snap.pick_for_algorithm(Algorithm::RSA).is_some());
+
+        let ec_only = parse_keybox_xml(&ec_only_keybox_xml(), 2).expect("parse ec-only keybox");
+        assert!(ec_only.ec.is_some());
+        assert!(ec_only.rsa.is_none());
+        // RSA keys must fall back to EC entry on EC-only keyboxes.
+        assert!(ec_only.pick_for_algorithm(Algorithm::RSA).is_some());
+        assert!(ec_only.pick_for_signing_algo(SigningAlgorithm::Rsa).is_some());
+    }
