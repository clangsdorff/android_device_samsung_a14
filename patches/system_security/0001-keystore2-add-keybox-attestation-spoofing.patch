+struct StdBootClock;
+
+impl crypto::MonotonicClock for StdBootClock {
+    fn now(&self) -> crypto::MillisecondsSinceEpoch {
+        let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+        // SAFETY: `ts` is a valid stack-allocated `libc::timespec` pointer.
+        let rc = unsafe { libc::clock_gettime(libc::CLOCK_BOOTTIME, &mut ts) };
+        if rc < 0 {
+            return crypto::MillisecondsSinceEpoch(0);
+        }
+        crypto::MillisecondsSinceEpoch(ts.tv_sec * 1000 + ts.tv_nsec / 1_000_000)
+    }
+}
