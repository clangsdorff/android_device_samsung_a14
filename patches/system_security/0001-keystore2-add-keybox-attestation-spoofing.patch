+
+namespace {
+
+bssl::UniquePtr<EVP_PKEY> loadPrivateKeyFromDer(int priv_kind, const uint8_t* priv_der,
+                                                size_t priv_der_len) {
+    if (!priv_der || priv_der_len == 0) {
+        return nullptr;
+    }
+    const uint8_t* p = priv_der;
+    bssl::UniquePtr<EVP_PKEY> pkey(EVP_PKEY_new());
+    if (!pkey) {
+        return nullptr;
+    }
+    if (priv_kind == 1) {
+        bssl::UniquePtr<EC_KEY> ec(
+            d2i_ECPrivateKey(nullptr, &p, static_cast<long>(priv_der_len)));
+        if (!ec || !EVP_PKEY_assign_EC_KEY(pkey.get(), ec.release())) {
+            return nullptr;
+        }
+        return pkey;
+    }
+    if (priv_kind == 2) {
+        bssl::UniquePtr<RSA> rsa(
+            d2i_RSAPrivateKey(nullptr, &p, static_cast<long>(priv_der_len)));
+        if (!rsa || !EVP_PKEY_assign_RSA(pkey.get(), rsa.release())) {
+            return nullptr;
+        }
+        return pkey;
+    }
+    return nullptr;
+}
+
+const EVP_MD* signingDigestForKey(const EVP_PKEY* pkey) {
+    if (!pkey) {
+        return EVP_sha256();
+    }
+    if (EVP_PKEY_id(pkey) == EVP_PKEY_EC) {
+        const EC_KEY* ec = EVP_PKEY_get0_EC_KEY(pkey);
+        if (ec && EC_KEY_get0_group(ec)) {
+            switch (EC_GROUP_get_curve_name(EC_KEY_get0_group(ec))) {
+            case NID_secp384r1:
+                return EVP_sha384();
+            case NID_secp521r1:
+                return EVP_sha512();
+            default:
+                break;
+            }
+        }
+    }
+    return EVP_sha256();
+}
+
+}  // namespace
+
+int parsePemCertificate(const uint8_t* pem_buf, size_t pem_len, uint8_t* out_der,
+                        size_t out_der_cap) {
+    if (!pem_buf || pem_len == 0 || !out_der) {
+        return 0;
+    }
+    bssl::UniquePtr<BIO> bio(BIO_new_mem_buf(pem_buf, static_cast<int>(pem_len)));
+    if (!bio) {
+        return 0;
+    }
+    bssl::UniquePtr<X509> cert(PEM_read_bio_X509(bio.get(), nullptr, nullptr, nullptr));
+    if (!cert) {
+        return 0;
+    }
+    int der_len = i2d_X509(cert.get(), nullptr);
+    if (der_len <= 0) {
+        return 0;
+    }
+    if (static_cast<size_t>(der_len) > out_der_cap) {
+        return -der_len;
+    }
+    uint8_t* tmp = out_der;
+    return i2d_X509(cert.get(), &tmp);
+}
+
+int parsePemPrivateKey(const uint8_t* pem_buf, size_t pem_len, int* out_kind, int* out_ec_curve,
+                       uint8_t* out_der, size_t out_der_cap) {
+    if (!pem_buf || pem_len == 0 || !out_kind || !out_ec_curve || !out_der) {
+        return 0;
+    }
+    bssl::UniquePtr<BIO> bio(BIO_new_mem_buf(pem_buf, static_cast<int>(pem_len)));
+    if (!bio) {
+        return 0;
+    }
+    bssl::UniquePtr<EVP_PKEY> pkey(PEM_read_bio_PrivateKey(bio.get(), nullptr, nullptr, nullptr));
+    if (!pkey) {
+        return 0;
+    }
+    int key_type = EVP_PKEY_id(pkey.get());
+    if (key_type == EVP_PKEY_EC) {
+        EC_KEY* ec = EVP_PKEY_get0_EC_KEY(pkey.get());
+        if (!ec || !EC_KEY_get0_group(ec)) {
+            return 0;
+        }
+        int nid = EC_GROUP_get_curve_name(EC_KEY_get0_group(ec));
+        int curve_code = 0;
+        switch (nid) {
+        case NID_secp224r1:
+            curve_code = 1;
+            break;
+        case NID_X9_62_prime256v1:
+            curve_code = 2;
+            break;
+        case NID_secp384r1:
+            curve_code = 3;
+            break;
+        case NID_secp521r1:
+            curve_code = 4;
+            break;
+        default:
+            return 0;
+        }
+        *out_kind = 1;
+        *out_ec_curve = curve_code;
+        int der_len = i2d_ECPrivateKey(ec, nullptr);
+        if (der_len <= 0) {
+            return 0;
+        }
+        if (static_cast<size_t>(der_len) > out_der_cap) {
+            return -der_len;
+        }
+        uint8_t* tmp = out_der;
+        return i2d_ECPrivateKey(ec, &tmp);
+    }
+    if (key_type == EVP_PKEY_RSA) {
+        RSA* rsa = EVP_PKEY_get0_RSA(pkey.get());
+        if (!rsa) {
+            return 0;
+        }
+        *out_kind = 2;
+        *out_ec_curve = 0;
+        int der_len = i2d_RSAPrivateKey(rsa, nullptr);
+        if (der_len <= 0) {
+            return 0;
+        }
+        if (static_cast<size_t>(der_len) > out_der_cap) {
+            return -der_len;
+        }
+        uint8_t* tmp = out_der;
+        return i2d_RSAPrivateKey(rsa, &tmp);
+    }
+    return 0;
+}
+
+bool verifyCertMatchesPrivateKey(const uint8_t* cert_der, size_t cert_len, int priv_kind,
+                                 const uint8_t* priv_der, size_t priv_der_len) {
+    if (!cert_der || cert_len == 0) {
+        return false;
+    }
+    const uint8_t* p = cert_der;
+    bssl::UniquePtr<X509> cert(d2i_X509(nullptr, &p, static_cast<long>(cert_len)));
+    if (!cert) {
+        return false;
+    }
+    bssl::UniquePtr<EVP_PKEY> pkey = loadPrivateKeyFromDer(priv_kind, priv_der, priv_der_len);
+    if (!pkey) {
+        return false;
+    }
+    return X509_check_private_key(cert.get(), pkey.get()) == 1;
+}
+
+bool verifyCertSignature(const uint8_t* cert_der, size_t cert_len, const uint8_t* issuer_cert_der,
+                         size_t issuer_cert_len) {
+    if (!cert_der || cert_len == 0 || !issuer_cert_der || issuer_cert_len == 0) {
+        return false;
+    }
+    const uint8_t* cp = cert_der;
+    bssl::UniquePtr<X509> cert(d2i_X509(nullptr, &cp, static_cast<long>(cert_len)));
+    const uint8_t* ip = issuer_cert_der;
+    bssl::UniquePtr<X509> issuer(d2i_X509(nullptr, &ip, static_cast<long>(issuer_cert_len)));
+    if (!cert || !issuer) {
+        return false;
+    }
+    EVP_PKEY* pub = X509_get0_pubkey(issuer.get());
+    if (!pub) {
+        return false;
+    }
+    return X509_verify(cert.get(), pub) == 1;
+}
+
+int extractExtensionFromCertificate(const uint8_t* cert_der, size_t cert_len, const char* oid_cstr,
+                                    uint8_t* out_octets, size_t out_cap) {
+    if (!cert_der || cert_len == 0 || !oid_cstr || !out_octets) {
+        return 0;
+    }
+    const uint8_t* p = cert_der;
+    bssl::UniquePtr<X509> cert(d2i_X509(nullptr, &p, static_cast<long>(cert_len)));
+    if (!cert) {
+        return 0;
+    }
+    bssl::UniquePtr<ASN1_OBJECT> obj(OBJ_txt2obj(oid_cstr, 1));
+    if (!obj) {
+        return 0;
+    }
+    int idx = X509_get_ext_by_OBJ(cert.get(), obj.get(), -1);
+    if (idx < 0) {
+        return 0;
+    }
+    X509_EXTENSION* ext = X509_get_ext(cert.get(), idx);
+    if (!ext) {
+        return 0;
+    }
+    ASN1_OCTET_STRING* data = X509_EXTENSION_get_data(ext);
+    if (!data) {
+        return 0;
+    }
+    int len = ASN1_STRING_length(data);
+    const uint8_t* bytes = ASN1_STRING_get0_data(data);
+    if (len <= 0 || !bytes) {
+        return 0;
+    }
+    if (static_cast<size_t>(len) > out_cap) {
+        return -len;
+    }
+    memcpy(out_octets, bytes, static_cast<size_t>(len));
+    return len;
+}
+
+int resignLeafCertificate(const uint8_t* leaf_der, size_t leaf_len, const uint8_t* issuer_cert_der,
+                          size_t issuer_cert_len, int priv_kind, const uint8_t* priv_der,
+                          size_t priv_der_len, const char* oid_cstr,
+                          const uint8_t* attest_ext_octets, size_t attest_ext_len,
+                          uint8_t* out_der, size_t out_cap) {
+    if (!leaf_der || leaf_len == 0 || !issuer_cert_der || issuer_cert_len == 0 || !oid_cstr ||
+        !attest_ext_octets || attest_ext_len == 0 || !out_der) {
+        return 0;
+    }
+    const uint8_t* p = leaf_der;
+    bssl::UniquePtr<X509> leaf(d2i_X509(nullptr, &p, static_cast<long>(leaf_len)));
+    if (!leaf) {
+        return 0;
+    }
+    const uint8_t* ip = issuer_cert_der;
+    bssl::UniquePtr<X509> issuer(d2i_X509(nullptr, &ip, static_cast<long>(issuer_cert_len)));
+    if (!issuer) {
+        return 0;
+    }
+    bssl::UniquePtr<EVP_PKEY> pkey = loadPrivateKeyFromDer(priv_kind, priv_der, priv_der_len);
+    if (!pkey) {
+        return 0;
+    }
+    X509_NAME* issuer_subject = X509_get_subject_name(issuer.get());
+    if (!issuer_subject || !X509_set_issuer_name(leaf.get(), issuer_subject)) {
+        return 0;
+    }
+
+    bssl::UniquePtr<ASN1_OBJECT> obj(OBJ_txt2obj(oid_cstr, 1));
+    if (!obj) {
+        return 0;
+    }
+    int idx = X509_get_ext_by_OBJ(leaf.get(), obj.get(), -1);
+    if (idx < 0) {
+        return 0;
+    }
+    X509_EXTENSION* existing_ext = X509_get_ext(leaf.get(), idx);
+    if (!existing_ext) {
+        return 0;
+    }
+    bssl::UniquePtr<ASN1_OCTET_STRING> new_oct(ASN1_OCTET_STRING_new());
+    if (!new_oct || !ASN1_OCTET_STRING_set(new_oct.get(), attest_ext_octets,
+                                           static_cast<int>(attest_ext_len))) {
+        return 0;
+    }
+    if (!X509_EXTENSION_set_data(existing_ext, new_oct.get())) {
+        return 0;
+    }
+
+    // Update or strip AuthorityKeyIdentifier so it matches the new issuer rather than OEM CA.
+    int aki_idx = X509_get_ext_by_NID(leaf.get(), NID_authority_key_identifier, -1);
+    if (aki_idx >= 0) {
+        bssl::UniquePtr<X509_EXTENSION> old_aki(X509_delete_ext(leaf.get(), aki_idx));
+        bssl::UniquePtr<ASN1_OCTET_STRING> issuer_ski(static_cast<ASN1_OCTET_STRING*>(
+            X509_get_ext_d2i(issuer.get(), NID_subject_key_identifier, nullptr, nullptr)));
+        if (issuer_ski) {
+            bssl::UniquePtr<AUTHORITY_KEYID> aki(AUTHORITY_KEYID_new());
+            if (aki) {
+                aki->keyid = ASN1_OCTET_STRING_dup(issuer_ski.get());
+                if (aki->keyid) {
+                    if (!X509_add1_ext_i2d(leaf.get(), NID_authority_key_identifier, aki.get(),
+                                           0 /* not critical */, 0)) {
+                        return 0;
+                    }
+                }
+            }
+        }
+    }
+
+    if (!X509_sign(leaf.get(), pkey.get(), signingDigestForKey(pkey.get()))) {
+        return 0;
+    }
+
+    int der_len = i2d_X509(leaf.get(), nullptr);
+    if (der_len <= 0) {
+        return 0;
+    }
+    if (static_cast<size_t>(der_len) > out_cap) {
+        return -der_len;
+    }
+    uint8_t* tmp = out_der;
+    return i2d_X509(leaf.get(), &tmp);
+}
