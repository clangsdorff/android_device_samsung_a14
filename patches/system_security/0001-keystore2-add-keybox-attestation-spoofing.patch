+
+    fn setAdditionalAttestationInfo(&self, info: &[KeyParameter]) -> binder::Result<()> {
+        if let Ok(mut map) = SOFT_INSTANCES.lock() {
+            if let Some(entry) = map.get_mut(&self.sec_level.0) {
+                let _ = entry.device.setAdditionalAttestationInfo(info);
+                entry.module_hash_sent = true;
+            }
+        }
+        self.real.setAdditionalAttestationInfo(info)
+    }
+}
