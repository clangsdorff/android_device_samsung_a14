+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub(crate) struct TeeBaseline {
+    pub(crate) verified_boot_key: Option<[u8; 32]>,
+    pub(crate) verified_boot_hash: Option<[u8; 32]>,
+    pub(crate) os_version: Option<u32>,
+    pub(crate) os_patchlevel: Option<u32>,
+    pub(crate) vendor_patchlevel: Option<u32>,
+    pub(crate) boot_patchlevel: Option<u32>,
+    pub(crate) module_hash: Option<Vec<u8>>,
+}
+
+static TEE_BASELINE: OnceLock<Option<TeeBaseline>> = OnceLock::new();
+
+fn parse_der_u32(tlv_val: &[u8]) -> Option<u32> {
+    let (tag, _, inner, rest) = read_next_tlv(tlv_val).ok()?;
+    if tag != 2 || !rest.is_empty() || inner.is_empty() || inner.len() > 5 {
+        return None;
+    }
+    if inner[0] & 0x80 != 0 {
+        return None;
+    }
+    let slice = if inner.len() > 4 && inner[0] == 0 { &inner[1..] } else { inner };
+    if slice.len() > 4 {
+        return None;
+    }
+    let mut v = 0u32;
+    for &b in slice {
+        v = (v << 8) | u32::from(b);
+    }
+    Some(v)
+}
+
+pub(crate) fn parse_tee_baseline_from_cert(cert_der: &[u8]) -> Option<TeeBaseline> {
+    let ext_octets = extract_extension_from_certificate(cert_der, ATTESTATION_OID_CSTR).ok()?;
+    let elems = parse_sequence_elements(&ext_octets).ok()?;
+    if elems.len() != 8 {
+        return None;
+    }
+    let list6 = parse_sequence_elements(elems[6].1).ok()?;
+    let list7 = parse_sequence_elements(elems[7].1).ok()?;
+    let tee_in_6 = list6.iter().any(|(t, _, _)| *t == 704);
+    let (sw_elems, tee_elems) = if tee_in_6 { (list7, list6) } else { (list6, list7) };
+
+    let mut out = TeeBaseline::default();
+    for (tag_no, _, inner) in sw_elems {
+        if tag_no == 724 {
+            if let Ok((4, _, bytes, _)) = read_next_tlv(inner) {
+                if !bytes.is_empty() {
+                    out.module_hash = Some(bytes.to_vec());
+                }
+            }
+        }
+    }
+    for (tag_no, _, inner) in tee_elems {
+        match tag_no {
+            704 => {
+                let (vbk, vbh) = parse_rot_fields(inner);
+                out.verified_boot_key = vbk.as_deref().and_then(non_zero_32);
+                out.verified_boot_hash = vbh.as_deref().and_then(non_zero_32);
+            }
+            705 => out.os_version = parse_der_u32(inner),
+            706 => out.os_patchlevel = parse_der_u32(inner),
+            718 => out.vendor_patchlevel = parse_der_u32(inner),
+            719 => out.boot_patchlevel = parse_der_u32(inner),
+            _ => {}
+        }
+    }
+    Some(out)
+}
+
+/// Probes the real hardware TEE once with an ephemeral EC key to capture real
+/// `verifiedBootKey`, `verifiedBootHash`, patch levels, and `moduleHash`.
+pub fn ensure_tee_baseline(keymint: &dyn IKeyMintDevice, sec_level: SecurityLevel) {
+    if sec_level != SecurityLevel::TRUSTED_ENVIRONMENT {
+        return;
+    }
+    TEE_BASELINE.get_or_init(|| {
+        let mut challenge = vec![0x54u8; 16];
+        if let Ok(rnd) = generate_random_data(16) {
+            if rnd.len() == 16 {
+                challenge = rnd;
+            }
+        }
+        let now_ms = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|d| d.as_millis() as i64)
+            .unwrap_or(1_700_000_000_000);
+        let probe_params = [
+            KeyParameter {
+                tag: Tag::ALGORITHM,
+                value: KeyParameterValue::Algorithm(Algorithm::EC),
+            },
+            KeyParameter {
+                tag: Tag::EC_CURVE,
+                value: KeyParameterValue::EcCurve(
+                    android_hardware_security_keymint::aidl::android::hardware::security::keymint::EcCurve::EcCurve::P_256,
+                ),
+            },
+            KeyParameter {
+                tag: Tag::PURPOSE,
+                value: KeyParameterValue::KeyPurpose(KeyPurpose::SIGN),
+            },
+            KeyParameter {
+                tag: Tag::DIGEST,
+                value: KeyParameterValue::Digest(
+                    android_hardware_security_keymint::aidl::android::hardware::security::keymint::Digest::Digest::SHA_2_256,
+                ),
+            },
+            KeyParameter {
+                tag: Tag::NO_AUTH_REQUIRED,
+                value: KeyParameterValue::BoolValue(true),
+            },
+            KeyParameter {
+                tag: Tag::CERTIFICATE_NOT_BEFORE,
+                value: KeyParameterValue::DateTime(0),
+            },
+            KeyParameter {
+                tag: Tag::CERTIFICATE_NOT_AFTER,
+                value: KeyParameterValue::DateTime(253402300799000),
+            },
+            KeyParameter {
+                tag: Tag::CREATION_DATETIME,
+                value: KeyParameterValue::DateTime(now_ms),
+            },
+            KeyParameter {
+                tag: Tag::ATTESTATION_CHALLENGE,
+                value: KeyParameterValue::Blob(challenge),
+            },
+        ];
+        let res = keymint.generateKey(&probe_params, None).ok()?;
+        let _ = keymint.deleteKey(&res.keyBlob);
+        let leaf = res.certificateChain.first()?;
+        let baseline = parse_tee_baseline_from_cert(&leaf.encodedCertificate);
+        if let Some(b) = &baseline {
+            info!(
+                "TEE baseline captured: boot_key={} boot_hash={} os_ver={:?} os_patch={:?} vendor_patch={:?} boot_patch={:?} module_hash={}",
+                b.verified_boot_key.is_some(),
+                b.verified_boot_hash.is_some(),
+                b.os_version,
+                b.os_patchlevel,
+                b.vendor_patchlevel,
+                b.boot_patchlevel,
+                b.module_hash.is_some(),
+            );
+        }
+        baseline
+    });
+}
+
+fn cached_tee_baseline() -> Option<&'static TeeBaseline> {
+    TEE_BASELINE.get().and_then(|o| o.as_ref())
+}
+
+fn resolve_root_of_trust_values(
+    dir: &Path,
+    orig_boot_key: Option<&[u8]>,
+    orig_boot_hash: Option<&[u8]>,
+) -> ([u8; 32], [u8; 32]) {
+    let secrets = load_or_create_secrets_at(dir);
+    let base = cached_tee_baseline();
+    let boot_key = parse_prop_hex32("ro.boot.vbmeta.public_key_digest", false)
+        .or_else(|| orig_boot_key.and_then(non_zero_32))
+        .or_else(|| base.and_then(|b| b.verified_boot_key))
+        .unwrap_or(secrets.fallback_boot_key);
+    let boot_hash = parse_prop_hex32("ro.boot.vbmeta.digest", true)
+        .or_else(|| orig_boot_hash.and_then(non_zero_32))
+        .or_else(|| base.and_then(|b| b.verified_boot_hash))
+        .unwrap_or(secrets.fallback_boot_hash);
+    (boot_key, boot_hash)
+}
+
+fn der_encode_len(len: usize, out: &mut Vec<u8>) {
+    if len < 0x80 {
+        out.push(len as u8);
+    } else if len <= 0xff {
+        out.push(0x81);
+        out.push(len as u8);
+    } else if len <= 0xffff {
+        out.push(0x82);
+        out.push((len >> 8) as u8);
+        out.push(len as u8);
+    } else {
+        out.push(0x83);
+        out.push((len >> 16) as u8);
+        out.push((len >> 8) as u8);
+        out.push(len as u8);
+    }
+}
+
+fn der_wrap(tag_bytes: &[u8], content: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(tag_bytes.len() + 5 + content.len());
+    out.extend_from_slice(tag_bytes);
+    der_encode_len(content.len(), &mut out);
+    out.extend_from_slice(content);
+    out
+}
+
+fn der_encode_context_explicit(tag_no: u32, inner_tlv: &[u8]) -> Vec<u8> {
+    let mut tag_bytes = Vec::with_capacity(4);
+    if tag_no < 31 {
+        tag_bytes.push(0xa0 | (tag_no as u8));
+    } else {
+        tag_bytes.push(0xbf);
+        let mut tmp = [0u8; 5];
+        let mut n = 0usize;
+        let mut v = tag_no;
+        while v > 0 {
+            tmp[n] = (v & 0x7f) as u8;
+            v >>= 7;
+            n += 1;
+        }
+        for i in (0..n).rev() {
+            let b = tmp[i] | if i > 0 { 0x80 } else { 0x00 };
+            tag_bytes.push(b);
+        }
+    }
+    der_wrap(&tag_bytes, inner_tlv)
+}
+
+fn der_encode_integer_i64(v: i64) -> Result<Vec<u8>> {
+    v.to_der().map_err(|e| anyhow!("der integer encode failed: {e:?}"))
+}
+
+fn der_encode_octet_string(bytes: &[u8]) -> Result<Vec<u8>> {
+    der::asn1::OctetStringRef::new(bytes)
+        .and_then(|o| o.to_der())
+        .map_err(|e| anyhow!("der octet string encode failed: {e:?}"))
+}
+
+type DerNextTlv<'a> = (u32, &'a [u8], &'a [u8], &'a [u8]);
+type DerTlv<'a> = (u32, &'a [u8], &'a [u8]);
+
+fn read_next_tlv(buf: &[u8]) -> Result<DerNextTlv<'_>> {
+    if buf.is_empty() {
+        return Err(anyhow!("unexpected EOF in DER"));
+    }
+    let first = buf[0];
+    let mut idx = 1usize;
+    let tag_num = if (first & 0x1f) == 0x1f {
+        let mut acc: u32 = 0;
+        loop {
+            if idx >= buf.len() {
+                return Err(anyhow!("truncated high-tag-number in DER"));
+            }
+            let b = buf[idx];
+            idx += 1;
+            acc = (acc << 7) | u32::from(b & 0x7f);
+            if (b & 0x80) == 0 {
+                break;
+            }
+        }
+        acc
+    } else {
+        u32::from(first & 0x1f)
+    };
+    if idx >= buf.len() {
+        return Err(anyhow!("truncated DER length"));
+    }
+    let len_byte = buf[idx];
+    idx += 1;
+    let content_len = if (len_byte & 0x80) == 0 {
+        len_byte as usize
+    } else {
+        let num_octets = (len_byte & 0x7f) as usize;
+        if num_octets == 0 || num_octets > 4 || idx + num_octets > buf.len() {
+            return Err(anyhow!("invalid DER length octets"));
+        }
+        let mut l: usize = 0;
+        for &b in &buf[idx..idx + num_octets] {
+            l = (l << 8) | (b as usize);
+        }
+        idx += num_octets;
+        l
+    };
+    let end = idx.checked_add(content_len).ok_or_else(|| anyhow!("DER length overflow"))?;
+    if end > buf.len() {
+        return Err(anyhow!("DER element exceeds buffer"));
+    }
+    Ok((tag_num, &buf[..end], &buf[idx..end], &buf[end..]))
+}
+
+fn parse_sequence_elements(seq_tlv: &[u8]) -> Result<Vec<DerTlv<'_>>> {
+    let (_, _, mut body, rest) = read_next_tlv(seq_tlv)?;
+    if !rest.is_empty() {
+        return Err(anyhow!("trailing bytes after DER sequence"));
+    }
+    let mut elems = Vec::new();
+    while !body.is_empty() {
+        let (tag_num, full_tlv, inner, next) = read_next_tlv(body)?;
+        elems.push((tag_num, full_tlv, inner));
+        body = next;
+    }
+    Ok(elems)
+}
+
+fn parse_rot_fields(rot_seq_tlv: &[u8]) -> (Option<Vec<u8>>, Option<Vec<u8>>) {
+    let Ok(elems) = parse_sequence_elements(rot_seq_tlv) else {
+        return (None, None);
+    };
+    let vbk = elems.first().map(|(_, _, inner)| inner.to_vec());
+    let vbh = elems.get(3).map(|(_, _, inner)| inner.to_vec());
+    (vbk, vbh)
+}
+
+fn encode_root_of_trust(boot_key: &[u8; 32], boot_hash: &[u8; 32]) -> Result<Vec<u8>> {
+    let mut seq_body = Vec::with_capacity(80);
+    seq_body.extend_from_slice(&der_encode_octet_string(boot_key)?);
+    seq_body.extend_from_slice(&[0x01, 0x01, 0xff]); // deviceLocked = TRUE
+    seq_body.extend_from_slice(&[0x0a, 0x01, 0x00]); // verifiedBootState = Verified (0)
+    seq_body.extend_from_slice(&der_encode_octet_string(boot_hash)?);
+    Ok(der_wrap(&[0x30], &seq_body))
+}
+
+pub(crate) fn patch_attestation_extension(
+    ext_octets: &[u8],
+    dir: &Path,
+    patch_levels: &ResolvedPatchLevels,
+    req_params: &[KeyParameter],
+) -> Result<Vec<u8>> {
+    let elems = parse_sequence_elements(ext_octets)?;
+    if elems.len() != 8 {
+        return Err(anyhow!("unexpected KeyDescription field count: {}", elems.len()));
+    }
+    // Check whether softwareEnforced and teeEnforced were swapped (some legacy Keymasters).
+    let list6 = parse_sequence_elements(elems[6].1)?;
+    let list7 = parse_sequence_elements(elems[7].1)?;
+    let tee_idx = if list6.iter().any(|(t, _, _)| *t == 704) { 6 } else { 7 };
+    let tee_raw_elems = if tee_idx == 6 { list6 } else { list7 };
+
+    let mut requested_ids: Vec<(u32, Vec<u8>)> = Vec::new();
+    for kp in req_params {
+        if let Some(tag_no) = attest_id_tag_number(kp.tag) {
+            if let KeyParameterValue::Blob(bytes) = &kp.value {
+                if !bytes.is_empty() && !requested_ids.iter().any(|(t, _)| *t == tag_no) {
+                    requested_ids.push((tag_no, bytes.clone()));
+                }
+            }
+        }
+    }
+
+    let mut orig_boot_key: Option<Vec<u8>> = None;
+    let mut orig_boot_hash: Option<Vec<u8>> = None;
+    let mut rebuilt: Vec<(u32, Vec<u8>)> =
+        Vec::with_capacity(tee_raw_elems.len() + requested_ids.len() + 4);
+
+    for (tag_no, full_tlv, inner) in tee_raw_elems {
+        match tag_no {
+            704 => {
+                let (k, h) = parse_rot_fields(inner);
+                orig_boot_key = k;
+                orig_boot_hash = h;
+            }
+            706 if !matches!(patch_levels.os, PatchValue::DeviceDefault) => {}
+            718 if !matches!(patch_levels.vendor, PatchValue::DeviceDefault) => {}
+            719 if !matches!(patch_levels.boot, PatchValue::DeviceDefault) => {}
+            t if requested_ids.iter().any(|(rt, _)| *rt == t) => {}
+            _ => rebuilt.push((tag_no, full_tlv.to_vec())),
+        }
+    }
+
+    let (boot_key, boot_hash) = resolve_root_of_trust_values(
+        dir,
+        orig_boot_key.as_deref(),
+        orig_boot_hash.as_deref(),
+    );
+    let rot_tlv = encode_root_of_trust(&boot_key, &boot_hash)?;
+    rebuilt.push((704, der_encode_context_explicit(704, &rot_tlv)));
+
+    if let PatchValue::Fixed(v) = patch_levels.os {
+        rebuilt.push((706, der_encode_context_explicit(706, &der_encode_integer_i64(i64::from(v))?)));
+    }
+    if let PatchValue::Fixed(v) = patch_levels.vendor {
+        rebuilt.push((718, der_encode_context_explicit(718, &der_encode_integer_i64(i64::from(v))?)));
+    }
+    if let PatchValue::Fixed(v) = patch_levels.boot {
+        rebuilt.push((719, der_encode_context_explicit(719, &der_encode_integer_i64(i64::from(v))?)));
+    }
+    for (tag_no, bytes) in requested_ids {
+        rebuilt.push((tag_no, der_encode_context_explicit(tag_no, &der_encode_octet_string(&bytes)?)));
+    }
+
+    rebuilt.sort_by_key(|(tag_no, _)| *tag_no);
+    let mut tee_body = Vec::new();
+    for (_, tlv) in rebuilt {
+        tee_body.extend_from_slice(&tlv);
+    }
+    let patched_tee = der_wrap(&[0x30], &tee_body);
+
+    let mut outer_body = Vec::with_capacity(ext_octets.len() + 64);
+    for (i, (_, full_tlv, _)) in elems.iter().enumerate() {
+        if i == tee_idx {
+            outer_body.extend_from_slice(&patched_tee);
+        } else {
+            outer_body.extend_from_slice(full_tlv);
+        }
+    }
+    Ok(der_wrap(&[0x30], &outer_body))
+}
+
+fn patch_key_characteristics(chars: &mut [KeyCharacteristics], patch_levels: &ResolvedPatchLevels) {
+    for kc in chars.iter_mut() {
+        let mut updated = Vec::with_capacity(kc.authorizations.len());
+        for mut kp in kc.authorizations.drain(..) {
+            let override_val = match kp.tag {
+                Tag::OS_PATCHLEVEL => &patch_levels.os,
+                Tag::VENDOR_PATCHLEVEL => &patch_levels.vendor,
+                Tag::BOOT_PATCHLEVEL => &patch_levels.boot,
+                _ => {
+                    updated.push(kp);
+                    continue;
+                }
+            };
+            match override_val {
+                PatchValue::DeviceDefault => updated.push(kp),
+                PatchValue::Omit => {}
+                PatchValue::Fixed(v) => {
+                    kp.value = KeyParameterValue::Integer(*v);
+                    updated.push(kp);
+                }
+            }
+        }
+        kc.authorizations = updated;
+    }
+}
+/// Patches `RootOfTrust` and re-signs a hardware TEE leaf certificate with the loaded keybox.
+pub fn patch_tee_creation_result(
+    caller_uid: AppUid,
+    req_params: &[KeyParameter],
+    creation_result: &mut KeyCreationResult,
+    _sec_level: SecurityLevel,
+) -> Result<bool> {
+    let dir = db_root();
+    let keybox = current_keybox_at(&dir);
+    if !keybox.is_loaded() || creation_result.certificateChain.is_empty() {
+        return Ok(false);
+    }
+    let leaf_der = &creation_result.certificateChain[0].encodedCertificate;
+    let Ok(ext_octets) = extract_extension_from_certificate(leaf_der, ATTESTATION_OID_CSTR) else {
+        return Ok(false);
+    };
+
+    let algo = detect_leaf_algorithm(&creation_result.keyCharacteristics);
+    let Some(kb) = keybox.pick_for_algorithm(algo) else {
+        return Ok(false);
+    };
+    let pkgs = packages_for_uid(caller_uid);
+    let patch_levels = resolve_patch_levels_for_pkgs(&dir, &pkgs);
+    let patched_ext = patch_attestation_extension(&ext_octets, &dir, &patch_levels, req_params)?;
+    let resigned_leaf = resign_leaf_certificate(
+        leaf_der,
+        &kb.certs_der[0],
+        &kb.priv_key,
+        ATTESTATION_OID_CSTR,
+        &patched_ext,
+    )
+    .context("re-signing leaf certificate with keybox")?;
+
+    let mut new_chain = Vec::with_capacity(1 + kb.certs_der.len());
+    new_chain.push(Certificate { encodedCertificate: resigned_leaf });
+    for c in &kb.certs_der {
+        new_chain.push(Certificate { encodedCertificate: c.clone() });
+    }
+    creation_result.certificateChain = new_chain;
+    patch_key_characteristics(&mut creation_result.keyCharacteristics, &patch_levels);
+    Ok(true)
+}
+
+type ResignedCertCache = Mutex<HashMap<([u8; 32], u64), (Vec<u8>, Vec<u8>)>>;
+
+static RESIGNED_CERT_CACHE: LazyLock<ResignedCertCache> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+fn detect_algorithm_from_extension(ext_octets: &[u8]) -> Algorithm {
+    let Ok(elems) = parse_sequence_elements(ext_octets) else {
+        return Algorithm::EC;
+    };
+    if elems.len() < 8 {
+        return Algorithm::EC;
+    }
+    for idx in [7usize, 6usize] {
+        if let Ok(list) = parse_sequence_elements(elems[idx].1) {
+            for (tag_no, _, inner) in list {
+                if tag_no == 2 {
+                    if let Some(1) = parse_der_u32(inner) {
+                        return Algorithm::RSA;
+                    }
+                    return Algorithm::EC;
+                }
+            }
+        }
+    }
+    Algorithm::EC
+}
+
+/// Re-patches persisted attested certificate chains in `get_key_entry` when the active
+/// keybox changed after key creation (for example Play Store's cached integrity key).
+pub fn patch_stored_cert_chain(
+    caller_uid: AppUid,
+    cert: &mut Option<Vec<u8>>,
+    cert_chain: &mut Option<Vec<u8>>,
+) {
+    let raw_uid = u32::try_from(caller_uid.0).unwrap_or(0);
+    if (raw_uid % AID_USER_OFFSET) < FIRST_APP_UID {
+        return;
+    }
+    let Some(leaf_der) = cert.as_deref() else {
+        return;
+    };
+    // Keys attested by a user ATTEST_KEY (or non-attested keys) have no stored cert_chain;
+    // their parent chain comes from the attest key itself, so re-rooting here would break them.
+    if cert_chain.as_deref().is_none_or(|c| c.is_empty()) {
+        return;
+    }
+    let dir = db_root();
+    let rules = current_target_rules(&dir);
+    let pkgs = packages_for_uid(caller_uid);
+    let mode = if !rules.has_file {
+        TargetMode::Auto
+    } else {
+        let mut matched = None;
+        for pkg in &pkgs {
+            if let Some(&m) = rules.packages.get(pkg) {
+                matched = Some(m);
+                break;
+            }
+        }
+        matched.or(rules.default_mode).unwrap_or(TargetMode::Ignore)
+    };
+    if mode == TargetMode::Ignore {
+        return;
+    }
+    let keybox = current_keybox_at(&dir);
+    if !keybox.is_loaded() {
+        return;
+    }
+    let Ok(ext_octets) = extract_extension_from_certificate(leaf_der, ATTESTATION_OID_CSTR) else {
+        return;
+    };
+    let algo = detect_algorithm_from_extension(&ext_octets);
+    let Some(kb) = keybox.pick_for_algorithm(algo) else {
+        return;
+    };
+    let expected_chain: Vec<u8> = kb.certs_der.iter().flat_map(|c| c.iter().copied()).collect();
+    if keystore2_crypto::verify_cert_signature(leaf_der, &kb.certs_der[0])
+        && cert_chain.as_deref() == Some(expected_chain.as_slice())
+    {
+        return;
+    }
+    let leaf_hash = digest::Sha256::hash(leaf_der);
+    let cache_key = (leaf_hash, keybox.generation);
+    if let Some((cached_leaf, cached_chain)) =
+        RESIGNED_CERT_CACHE.lock().unwrap().get(&cache_key).cloned()
+    {
+        *cert = Some(cached_leaf);
+        *cert_chain = Some(cached_chain);
+        return;
+    }
+    let patch_levels = resolve_patch_levels_for_pkgs(&dir, &pkgs);
+    let Ok(patched_ext) = patch_attestation_extension(&ext_octets, &dir, &patch_levels, &[]) else {
+        return;
+    };
+    let Ok(resigned_leaf) = resign_leaf_certificate(
+        leaf_der,
+        &kb.certs_der[0],
+        &kb.priv_key,
+        ATTESTATION_OID_CSTR,
+        &patched_ext,
+    ) else {
+        return;
+    };
+    {
+        let mut cache = RESIGNED_CERT_CACHE.lock().unwrap();
+        if cache.len() >= 64 {
+            cache.clear();
+        }
+        cache.insert(cache_key, (resigned_leaf.clone(), expected_chain.clone()));
+    }
+    *cert = Some(resigned_leaf);
+    *cert_chain = Some(expected_chain);
+}
+
+fn detect_leaf_algorithm(chars: &[KeyCharacteristics]) -> Algorithm {
+    for kc in chars {
+        for kp in &kc.authorizations {
+            if kp.tag == Tag::ALGORITHM {
+                if let KeyParameterValue::Algorithm(a) = kp.value {
+                    return a;
+                }
+            }
+        }
+    }
+    Algorithm::EC
+}
