+// Returns >0 bytes written, 0 on error, or -needed_bytes if out_cap is too small.
+int resignLeafCertificate(const uint8_t* leaf_der, size_t leaf_len,
+                          const uint8_t* issuer_cert_der, size_t issuer_cert_len,
+                          int priv_kind, const uint8_t* priv_der, size_t priv_der_len,
+                          const char* oid_cstr,
+                          const uint8_t* attest_ext_octets, size_t attest_ext_len,
+                          uint8_t* out_der, size_t out_cap);
