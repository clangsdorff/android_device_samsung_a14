From a3b6d596c15bb0130c4b43f264543d37e59dc6df Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:46:22 +0300
Subject: [PATCH 2/2] releasetools: build the non-ab ota package without a
 recovery

the a13 keeps the stock recovery and sets TARGET_NO_RECOVERY, so the
build drops the ota package and non_ab_ota refuses no_recovery
targets. keep the package when recovery is disabled on purpose and
skip the recovery image and recovery patch checks in the full ota.
without a recovery ramdisk there is no fstab either and the script
silently skips writing boot.img, so ship TARGET_RECOVERY_FSTAB in
META and load it from there. also honor the --backup value, since
--backup=false still enabled backuptool, and only unpack install
tools when backuptool is enabled.
---
 core/Makefile                               | 13 ++++++++---
 tools/releasetools/common.py                |  5 ++++
 tools/releasetools/non_ab_ota.py            | 26 +++++++++------------
 tools/releasetools/ota_from_target_files.py |  2 +-
 4 files changed, 27 insertions(+), 19 deletions(-)

diff --git a/core/Makefile b/core/Makefile
index 65c45cb835..86d9dee3cb 100644
--- a/core/Makefile
+++ b/core/Makefile
@@ -5889,9 +5889,11 @@ else
         build_ota_package := false
       endif
     endif # INSTALLED_BOOTIMAGE_TARGET == ""
-    ifeq ($(recovery_fstab),)
-      ifeq ($(filter $(TARGET_RECOVERY_ROOT_OUT)/system/etc/recovery.fstab,$(INTERNAL_RECOVERYIMAGE_FILES)),)
-        build_ota_package := false
+    ifneq ($(TARGET_NO_RECOVERY),true)
+      ifeq ($(recovery_fstab),)
+        ifeq ($(filter $(TARGET_RECOVERY_ROOT_OUT)/system/etc/recovery.fstab,$(INTERNAL_RECOVERYIMAGE_FILES)),)
+          build_ota_package := false
+        endif
       endif
     endif
   endif # PRODUCT_BUILD_GENERIC_OTA_PACKAGE
@@ -6975,6 +6977,11 @@ endif
 	$(hide) echo "$(PRODUCT_OTA_PUBLIC_KEYS)" > $(zip_root)/META/otakeys.txt
 	$(hide) cp $(SELINUX_FC) $(zip_root)/META/file_contexts.bin
 	$(hide) cp $(INSTALLED_MISC_INFO_TARGET) $(zip_root)/META/misc_info.txt
+ifeq ($(TARGET_NO_RECOVERY),true)
+ifneq ($(TARGET_RECOVERY_FSTAB),)
+	$(hide) cp $(TARGET_RECOVERY_FSTAB) $(zip_root)/META/recovery.fstab
+endif
+endif
 ifneq ($(INSTALLED_FASTBOOT_INFO_TARGET),)
 	$(hide) cp $(INSTALLED_FASTBOOT_INFO_TARGET) $(zip_root)/META/fastboot-info.txt
 endif
diff --git a/tools/releasetools/common.py b/tools/releasetools/common.py
index fef646f3ae..0c6058d0f4 100644
--- a/tools/releasetools/common.py
+++ b/tools/releasetools/common.py
@@ -1292,6 +1292,11 @@ def _FindAndLoadRecoveryFstab(info_dict, input_file, read_helper):
     return LoadRecoveryFSTab(
         read_helper, info_dict['fstab_version'], recovery_fstab_path)
 
+  if info_dict.get('no_recovery') == 'true' and \
+     DoesInputFileContain(input_file, 'META/recovery.fstab'):
+    return LoadRecoveryFSTab(
+        read_helper, info_dict['fstab_version'], 'META/recovery.fstab')
+
   return None
 
 
diff --git a/tools/releasetools/non_ab_ota.py b/tools/releasetools/non_ab_ota.py
index 2d1075eb81..d83dfb28a7 100644
--- a/tools/releasetools/non_ab_ota.py
+++ b/tools/releasetools/non_ab_ota.py
@@ -149,7 +149,8 @@ def WriteFullOTAPackage(input_zip, output_file):
       metadata=metadata,
       info_dict=OPTIONS.info_dict)
 
-  assert HasRecoveryPatch(input_zip, info_dict=OPTIONS.info_dict)
+  no_recovery = OPTIONS.info_dict.get("no_recovery") == "true"
+  assert no_recovery or HasRecoveryPatch(input_zip, info_dict=OPTIONS.info_dict)
 
   # Assertions (e.g. downgrade check, device properties check).
   #ts = target_info.GetBuildProp("ro.build.date.utc")
@@ -184,10 +185,11 @@ def WriteFullOTAPackage(input_zip, output_file):
   #    complete script normally
   #    (allow recovery to mark itself finished and reboot)
 
-  recovery_img = common.GetBootableImage("recovery.img", "recovery.img",
-                                         OPTIONS.input_tmp, "RECOVERY")
-  common.CheckSize(recovery_img.data, "recovery.img", target_info)
-  common.ZipWriteStr(output_zip, "recovery.img", recovery_img.data)
+  if not no_recovery:
+    recovery_img = common.GetBootableImage("recovery.img", "recovery.img",
+                                           OPTIONS.input_tmp, "RECOVERY")
+    common.CheckSize(recovery_img.data, "recovery.img", target_info)
+    common.ZipWriteStr(output_zip, "recovery.img", recovery_img.data)
   if OPTIONS.two_step:
     if not target_info.get("multistage_support"):
       assert False, "two-step packages not supported by this build"
@@ -216,12 +218,11 @@ else if get_stage("%(bcb_dev)s") == "3/3" then
 
   device_specific.FullOTA_InstallBegin()
 
-  CopyInstallTools(output_zip)
-  script.UnpackPackageDir("install", "/tmp/install")
-  script.SetPermissionsRecursive("/tmp/install", 0, 0, 0o755, 0o644, None, None)
-  script.SetPermissionsRecursive("/tmp/install/bin", 0, 0, 0o755, 0o755, None, None)
-
   if OPTIONS.backuptool:
+    CopyInstallTools(output_zip)
+    script.UnpackPackageDir("install", "/tmp/install")
+    script.SetPermissionsRecursive("/tmp/install", 0, 0, 0o755, 0o644, None, None)
+    script.SetPermissionsRecursive("/tmp/install/bin", 0, 0, 0o755, 0o755, None, None)
     script.RunBackup("backup", target_info.get('use_dynamic_partitions') == "true")
 
   # All other partitions as well as the data wipe use 10% of the progress, and
@@ -573,11 +574,6 @@ endif;
 
 def GenerateNonAbOtaPackage(target_file, output_file, source_file=None):
   """Generates a non-A/B OTA package."""
-  # Check the loaded info dicts first.
-  if OPTIONS.info_dict.get("no_recovery") == "true":
-    raise common.ExternalError(
-        "--- target build has specified no recovery ---")
-
   # Non-A/B OTAs rely on /cache partition to store temporary files.
   cache_size = OPTIONS.info_dict.get("cache_size")
   if cache_size is None:
