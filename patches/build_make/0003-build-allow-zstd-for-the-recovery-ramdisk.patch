From 0d2e1cd5ec05da5eaa18235b365fe51776cb8114 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Wed, 18 Nov 2026 15:26:47 +0000
Subject: [PATCH 3/4] build: allow zstd for the recovery ramdisk

the a13 recovery partition is ~53 MB and the lz4 recovery ramdisk does
not fit next to the kernel and modules. add
BOARD_RECOVERY_RAMDISK_USE_ZSTD to compress only the recovery ramdisk
with zstd -19, the boot ramdisk keeps the board compression.

Change-Id: If4e076ee752a4cd7aa567b86ac69d3f655903be5
---
 core/Makefile                |  9 +++++++++
 tools/releasetools/common.py | 13 ++++++++++---
 2 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/core/Makefile b/core/Makefile
index 86d9dee3cb..9468220db7 100644
--- a/core/Makefile
+++ b/core/Makefile
@@ -2785,9 +2785,15 @@ $(recovery_uncompressed_ramdisk): $(INTERNAL_RECOVERY_RAMDISK_FILES_TIMESTAMP)
 	@echo ----- Making uncompressed recovery ramdisk ------
 	$(MKBOOTFS) -d $(TARGET_OUT) $(TARGET_RECOVERY_ROOT_OUT) > $@
 
+ifeq ($(BOARD_RECOVERY_RAMDISK_USE_ZSTD),true)
+$(recovery_ramdisk): $(recovery_uncompressed_ramdisk) $(ZSTD)
+	@echo ----- Making compressed recovery ramdisk ------
+	$(ZSTD) -19 -T0 -f -c < $(recovery_uncompressed_ramdisk) > $@
+else
 $(recovery_ramdisk): $(recovery_uncompressed_ramdisk) $(COMPRESSION_COMMAND_DEPS)
 	@echo ----- Making compressed recovery ramdisk ------
 	$(COMPRESSION_COMMAND) < $(recovery_uncompressed_ramdisk) > $@
+endif
 
 # $(1): output file
 # $(2): optional kernel file
@@ -6130,6 +6136,9 @@ endif
 ifeq ($(BOARD_RAMDISK_USE_XZ),true)
 	echo "xz_ramdisks=true" >> $@
 endif
+ifeq ($(BOARD_RECOVERY_RAMDISK_USE_ZSTD),true)
+	echo "zstd_recovery_ramdisk=true" >> $@
+endif
 ifneq ($(INSTALLED_VENDOR_BOOTIMAGE_TARGET),)
 	echo "vendor_boot=true" >> $@
 	echo "vendor_boot_size=$(BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE)" >> $@
diff --git a/tools/releasetools/common.py b/tools/releasetools/common.py
index 0c6058d0f4..38a62aea5f 100644
--- a/tools/releasetools/common.py
+++ b/tools/releasetools/common.py
@@ -843,9 +843,13 @@ class RamdiskFormat(object):
   LZ4 = 1
   GZ = 2
   XZ = 3
+  ZSTD = 4
 
 
-def GetRamdiskFormat(info_dict):
+def GetRamdiskFormat(info_dict, partition_name=None):
+  if (partition_name == 'recovery' and
+      info_dict.get('zstd_recovery_ramdisk') == 'true'):
+    return RamdiskFormat.ZSTD
   if info_dict.get('lz4_ramdisks') == 'true':
     ramdisk_format = RamdiskFormat.LZ4
   elif info_dict.get('xz_ramdisks') == 'true':
@@ -1739,8 +1743,11 @@ def _MakeRamdisk(sourcedir, fs_config_file=None,
              stdout=ramdisk_img.file.fileno())
   elif ramdisk_format == RamdiskFormat.GZ:
     p2 = Run(["gzip"], stdin=p1.stdout, stdout=ramdisk_img.file.fileno())
+  elif ramdisk_format == RamdiskFormat.ZSTD:
+    p2 = Run(["zstd", "-19", "-T0", "-f", "-c"], stdin=p1.stdout,
+             stdout=ramdisk_img.file.fileno())
   else:
-    raise ValueError("Only support lz4, xz or gzip ramdisk format.")
+    raise ValueError("Only support lz4, xz, gzip or zstd ramdisk format.")
 
   p2.wait()
   p1.wait()
@@ -1792,7 +1799,7 @@ def _BuildBootableImage(image_name, sourcedir, fs_config_file,
   img = tempfile.NamedTemporaryFile()
 
   if has_ramdisk:
-    ramdisk_format = GetRamdiskFormat(info_dict)
+    ramdisk_format = GetRamdiskFormat(info_dict, partition_name)
     ramdisk_img = _MakeRamdisk(sourcedir, fs_config_file, dev_node_file,
                                ramdisk_format=ramdisk_format)
 
