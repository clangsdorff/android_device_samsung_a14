From 59c2f77f0ffc3af5dbf898dc265860866b62b25a Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Wed, 11 Nov 2026 22:26:14 +0300
Subject: [PATCH 3/3] config: make extra los cli utils opt out

Signed-off-by: fukiame <fukiame@proton.me>
---
 config/common.mk | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/config/common.mk b/config/common.mk
index 9c26242..bd54f3e 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -167,6 +167,7 @@ PRODUCT_PACKAGES += \
     SimpleDeviceConfig \
     SimpleSettingsConfig
 
+ifneq ($(TARGET_EXCLUDE_LOS_EXTRA_CLI_UTILS),true)
 # Extra tools in Lineage
 PRODUCT_PACKAGES += \
     bash \
@@ -177,13 +178,16 @@ PRODUCT_PACKAGES += \
     setcap \
     vim
 
+PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
+    system/bin/curl \
+    system/bin/getcap \
+    system/bin/setcap
+endif
+
 PRODUCT_PACKAGES += \
     nano_recovery
 
 PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
-    system/bin/curl \
-    system/bin/getcap \
-    system/bin/setcap \
     system/%/libzstd.so
 
 # fastbootd
@@ -209,6 +213,7 @@ PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
 PRODUCT_COPY_FILES += \
     vendor/lineage/prebuilt/common/bin/wipe-frp.sh:$(TARGET_COPY_OUT_RECOVERY)/root/system/bin/wipe-frp
 
+ifneq ($(TARGET_EXCLUDE_LOS_EXTRA_CLI_UTILS),true)
 # Openssh
 PRODUCT_PACKAGES += \
     scp \
@@ -221,14 +226,17 @@ PRODUCT_PACKAGES += \
 
 PRODUCT_COPY_FILES += \
     vendor/lineage/prebuilt/common/etc/init/init.openssh.rc:$(TARGET_COPY_OUT_PRODUCT)/etc/init/init.openssh.rc
+endif
 
 # OverlayFS
 PRODUCT_PACKAGES_DEBUG += \
     disable-overlays
 
+ifneq ($(TARGET_EXCLUDE_LOS_EXTRA_CLI_UTILS),true)
 # rsync
 PRODUCT_PACKAGES += \
     rsync
+endif
 
 # Storage manager
 PRODUCT_PRODUCT_PROPERTIES += \
-- 
2.56.0

