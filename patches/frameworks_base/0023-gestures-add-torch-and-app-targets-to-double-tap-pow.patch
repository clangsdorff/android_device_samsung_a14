From 60a9350dc9070c0ac0443fbe6819fec888f2e309 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Fri, 20 Nov 2026 22:10:05 +0000
Subject: [PATCH] gestures: add torch and app targets to double tap power

double tap power only offers camera or wallet in multi target mode, so
the gesture can not toggle the flashlight or open another app.

accept 2 (torch) and 3 (app) in double_tap_power_button_gesture, keep
the app package in double_tap_power_button_gesture_app and handle both
in GestureLauncherService next to the wallet target.
---
 core/java/android/provider/Settings.java      |  11 ++
 .../settings/backup/SecureSettings.java       |   1 +
 .../validators/SecureSettingsValidators.java  |   3 +-
 .../server/GestureLauncherService.java        | 113 +++++++++++++++++-
 4 files changed, 126 insertions(+), 2 deletions(-)

diff --git a/core/java/android/provider/Settings.java b/core/java/android/provider/Settings.java
index 6a656c2fb963..3961ae0ccff5 100644
--- a/core/java/android/provider/Settings.java
+++ b/core/java/android/provider/Settings.java
@@ -11971,12 +11971,23 @@ public final class Settings {
          * Double tap power button gesture behavior.
          * 0 = Camera launch
          * 1 = Wallet launch
+         * 2 = Torch toggle
+         * 3 = Launch the app in {@link #DOUBLE_TAP_POWER_BUTTON_GESTURE_APP}
          * @hide
          */
         @Readable
         public static final String DOUBLE_TAP_POWER_BUTTON_GESTURE =
                 "double_tap_power_button_gesture";
 
+        /**
+         * Package name launched by the double tap power button gesture.
+         *
+         * @hide
+         */
+        @Readable
+        public static final String DOUBLE_TAP_POWER_BUTTON_GESTURE_APP =
+                "double_tap_power_button_gesture_app";
+
         /**
          * Whether the camera launch gesture to double tap the power button when the screen is off
          * should be disabled.
diff --git a/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java b/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java
index 5c6a49d98ace..8c1f6b8c8516 100644
--- a/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java
+++ b/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java
@@ -122,6 +122,7 @@ public class SecureSettings {
         Settings.Secure.CAMERA_DOUBLE_TWIST_TO_FLIP_ENABLED,
         Settings.Secure.DOUBLE_TAP_POWER_BUTTON_GESTURE_ENABLED,
         Settings.Secure.DOUBLE_TAP_POWER_BUTTON_GESTURE,
+        Settings.Secure.DOUBLE_TAP_POWER_BUTTON_GESTURE_APP,
         Settings.Secure.CAMERA_DOUBLE_TAP_POWER_GESTURE_DISABLED,
         Settings.Secure.SYSTEM_NAVIGATION_KEYS_ENABLED,
         // ACCESSIBILITY_QS_TARGETS needs to be restored after ENABLED_ACCESSIBILITY_SERVICES
diff --git a/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java b/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java
index 19b5fb47bd70..263f62d26258 100644
--- a/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java
+++ b/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java
@@ -187,7 +187,8 @@ public class SecureSettingsValidators {
         VALIDATORS.put(Secure.CAMERA_DOUBLE_TWIST_TO_FLIP_ENABLED, BOOLEAN_VALIDATOR);
         VALIDATORS.put(Secure.DOUBLE_TAP_POWER_BUTTON_GESTURE_ENABLED, BOOLEAN_VALIDATOR);
         VALIDATORS.put(Secure.DOUBLE_TAP_POWER_BUTTON_GESTURE,
-                new InclusiveIntegerRangeValidator(0, 1));
+                new InclusiveIntegerRangeValidator(0, 3));
+        VALIDATORS.put(Secure.DOUBLE_TAP_POWER_BUTTON_GESTURE_APP, PACKAGE_NAME_VALIDATOR);
         VALIDATORS.put(Secure.CAMERA_DOUBLE_TAP_POWER_GESTURE_DISABLED, BOOLEAN_VALIDATOR);
         VALIDATORS.put(Secure.SYSTEM_NAVIGATION_KEYS_ENABLED, BOOLEAN_VALIDATOR);
         VALIDATORS.put(Secure.QS_TILES, TILE_LIST_VALIDATOR);
diff --git a/services/core/java/com/android/server/GestureLauncherService.java b/services/core/java/com/android/server/GestureLauncherService.java
index 3be867f0e1f2..4b61ee526fe8 100644
--- a/services/core/java/com/android/server/GestureLauncherService.java
+++ b/services/core/java/com/android/server/GestureLauncherService.java
@@ -38,6 +38,9 @@ import android.hardware.SensorEventListener;
 import android.hardware.SensorManager;
 import android.hardware.TriggerEvent;
 import android.hardware.TriggerEventListener;
+import android.hardware.camera2.CameraAccessException;
+import android.hardware.camera2.CameraCharacteristics;
+import android.hardware.camera2.CameraManager;
 import android.os.Bundle;
 import android.os.Handler;
 import android.os.PowerManager;
@@ -48,6 +51,7 @@ import android.os.Trace;
 import android.os.UserHandle;
 import android.provider.Settings;
 import android.service.quickaccesswallet.QuickAccessWalletClient;
+import android.text.TextUtils;
 import android.util.MutableBoolean;
 import android.util.Slog;
 import android.view.KeyEvent;
@@ -125,6 +129,12 @@ public class GestureLauncherService extends SystemService {
     /** Indicates wallet launch is selected as target action for multi target double tap power. */
     @VisibleForTesting static final int LAUNCH_WALLET_ON_DOUBLE_TAP_POWER = 1;
 
+    /** Indicates torch toggle is selected as target action for multi target double tap power. */
+    @VisibleForTesting static final int TOGGLE_TORCH_ON_DOUBLE_TAP_POWER = 2;
+
+    /** Indicates app launch is selected as target action for multi target double tap power. */
+    @VisibleForTesting static final int LAUNCH_APP_ON_DOUBLE_TAP_POWER = 3;
+
     /** Number of taps required to launch the double tap shortcut (either camera or wallet). */
     public static final int DOUBLE_POWER_TAP_COUNT_THRESHOLD = 2;
 
@@ -194,6 +204,21 @@ public class GestureLauncherService extends SystemService {
     /** Whether wallet double tap power button gesture is currently enabled. */
     private boolean mWalletDoubleTapPowerEnabled;
 
+    /** Torch or app target action of the double tap power gesture, -1 when neither is set. */
+    private int mExtraDoubleTapPowerAction = -1;
+
+    private String mTorchCameraId;
+    private volatile boolean mTorchEnabled;
+
+    private final CameraManager.TorchCallback mTorchCallback = new CameraManager.TorchCallback() {
+        @Override
+        public void onTorchModeChanged(String cameraId, boolean enabled) {
+            if (cameraId.equals(mTorchCameraId)) {
+                mTorchEnabled = enabled;
+            }
+        }
+    };
+
     /**
      * Whether emergency gesture is currently enabled
      */
@@ -281,6 +306,7 @@ public class GestureLauncherService extends SystemService {
             updateCameraDoubleTapPowerEnabled();
             if (launchWalletOptionOnPowerDoubleTap()) {
                 updateWalletDoubleTapPowerEnabled();
+                updateExtraDoubleTapPowerAction();
             }
             updateEmergencyGestureEnabled();
             updateEmergencyGesturePowerButtonCooldownPeriodMs();
@@ -355,6 +381,23 @@ public class GestureLauncherService extends SystemService {
         }
     }
 
+    @VisibleForTesting
+    void updateExtraDoubleTapPowerAction() {
+        int action = -1;
+        if (getDoubleTapPowerGestureMode(mContext.getResources())
+                == DOUBLE_TAP_POWER_MULTI_TARGET_MODE
+                && isMultiTargetDoubleTapPowerGestureSettingEnabled(mContext, mUserId)) {
+            int selected = getDoubleTapPowerGestureAction(mContext, mUserId);
+            if (selected == TOGGLE_TORCH_ON_DOUBLE_TAP_POWER
+                    || selected == LAUNCH_APP_ON_DOUBLE_TAP_POWER) {
+                action = selected;
+            }
+        }
+        synchronized (this) {
+            mExtraDoubleTapPowerAction = action;
+        }
+    }
+
     @VisibleForTesting
     void updateEmergencyGestureEnabled() {
         boolean enabled = isEmergencyGestureSettingEnabled(mContext, mUserId);
@@ -668,6 +711,7 @@ public class GestureLauncherService extends SystemService {
         }
         boolean launchCamera = false;
         boolean launchWallet = false;
+        int extraAction = -1;
         boolean launchEmergencyGesture = false;
         boolean intercept = false;
         long powerTapInterval;
@@ -734,6 +778,12 @@ public class GestureLauncherService extends SystemService {
                     && mPowerButtonConsecutiveTaps == DOUBLE_POWER_TAP_COUNT_THRESHOLD) {
                 launchWallet = true;
                 intercept = interactive;
+            } else if (launchWalletOptionOnPowerDoubleTap()
+                    && mExtraDoubleTapPowerAction != -1
+                    && powerTapInterval < POWER_DOUBLE_TAP_MAX_TIME_MS
+                    && mPowerButtonConsecutiveTaps == DOUBLE_POWER_TAP_COUNT_THRESHOLD) {
+                extraAction = mExtraDoubleTapPowerAction;
+                intercept = interactive;
             }
         }
         if (mPowerButtonConsecutiveTaps > 1 || mPowerButtonSlowConsecutiveTaps > 1) {
@@ -760,6 +810,13 @@ public class GestureLauncherService extends SystemService {
             if (launchWallet) {
                 mUiEventLogger.log(GestureLauncherEvent.GESTURE_WALLET_DOUBLE_TAP_POWER);
             }
+        } else if (extraAction != -1) {
+            Slog.i(TAG, "Power button double tap gesture detected, action=" + extraAction
+                    + " Interval=" + powerTapInterval + "ms");
+            if (!(extraAction == TOGGLE_TORCH_ON_DOUBLE_TAP_POWER
+                    ? toggleTorch() : launchSelectedApp())) {
+                extraAction = -1;
+            }
         } else if (launchEmergencyGesture) {
             Slog.i(TAG, "Emergency gesture detected, launching.");
             launchEmergencyGesture = handleEmergencyGesture();
@@ -775,12 +832,64 @@ public class GestureLauncherService extends SystemService {
                 mPowerButtonSlowConsecutiveTaps);
         mMetricsLogger.histogram("power_double_tap_interval", (int) powerTapInterval);
 
-        outLaunched.value = launchCamera || launchEmergencyGesture || launchWallet;
+        outLaunched.value = launchCamera || launchEmergencyGesture || launchWallet
+                || extraAction != -1;
         // Intercept power key event if the press is part of a gesture (camera, eGesture) and the
         // user has completed setup.
         return intercept && isUserSetupComplete();
     }
 
+    private boolean toggleTorch() {
+        CameraManager cameraManager = mContext.getSystemService(CameraManager.class);
+        if (cameraManager == null) {
+            return false;
+        }
+        try {
+            if (mTorchCameraId == null) {
+                for (String id : cameraManager.getCameraIdList()) {
+                    CameraCharacteristics c = cameraManager.getCameraCharacteristics(id);
+                    if (Boolean.TRUE.equals(c.get(CameraCharacteristics.FLASH_INFO_AVAILABLE))
+                            && Integer.valueOf(CameraCharacteristics.LENS_FACING_BACK)
+                                    .equals(c.get(CameraCharacteristics.LENS_FACING))) {
+                        mTorchCameraId = id;
+                        break;
+                    }
+                }
+                if (mTorchCameraId == null) {
+                    Slog.w(TAG, "No back camera with a flash, ignoring torch gesture.");
+                    return false;
+                }
+                cameraManager.registerTorchCallback(mContext.getMainExecutor(), mTorchCallback);
+            }
+            cameraManager.setTorchMode(mTorchCameraId, !mTorchEnabled);
+            return true;
+        } catch (CameraAccessException | IllegalArgumentException e) {
+            Slog.w(TAG, "Unable to toggle the torch", e);
+            return false;
+        }
+    }
+
+    private boolean launchSelectedApp() {
+        String packageName = Settings.Secure.getStringForUser(mContext.getContentResolver(),
+                Settings.Secure.DOUBLE_TAP_POWER_BUTTON_GESTURE_APP, mUserId);
+        if (TextUtils.isEmpty(packageName) || !isUserSetupComplete()) {
+            return false;
+        }
+        Intent intent = mContext.getPackageManager().getLaunchIntentForPackage(packageName);
+        if (intent == null) {
+            Slog.w(TAG, "No launch intent for " + packageName + ", ignoring app gesture.");
+            return false;
+        }
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED);
+        try {
+            mContext.startActivityAsUser(intent, UserHandle.of(mUserId));
+            return true;
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Unable to launch " + packageName, e);
+            return false;
+        }
+    }
+
     /**
      * Fetches and sends gestureTargetActivityPendingIntent from QuickAccessWallet, which is a
      * specific activity that QuickAccessWalletService has defined to be launch on detection of the
@@ -951,6 +1060,7 @@ public class GestureLauncherService extends SystemService {
                 updateCameraDoubleTapPowerEnabled();
                 if (launchWalletOptionOnPowerDoubleTap()) {
                     updateWalletDoubleTapPowerEnabled();
+                    updateExtraDoubleTapPowerAction();
                 }
                 updateEmergencyGestureEnabled();
                 updateEmergencyGesturePowerButtonCooldownPeriodMs();
@@ -965,6 +1075,7 @@ public class GestureLauncherService extends SystemService {
                 updateCameraDoubleTapPowerEnabled();
                 if (launchWalletOptionOnPowerDoubleTap()) {
                     updateWalletDoubleTapPowerEnabled();
+                    updateExtraDoubleTapPowerAction();
                 }
                 updateEmergencyGestureEnabled();
                 updateEmergencyGesturePowerButtonCooldownPeriodMs();
