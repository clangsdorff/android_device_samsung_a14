From 7477b73d0fde06171bd0fddc5d5dc1cbe45e3749 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sun, 15 Nov 2026 16:57:12 +0000
Subject: [PATCH 12/13] display: port the stock user brightness offset

aosp turns a slider change in auto mode into a gamma for the whole
curve, and the adjustment setting keeps that gamma after a reboot, so
dimming in a dark room also dims the screen outdoors.

like stock one ui, keep the change as a local offset that fades out
between lux/2.5 and lux*2.5, smooth the curve around it and stop the
adjustment from bending the curve.

Change-Id: I02345c542bf33e5fdfd0b5525775fd491d51cf5e
---
 .../display/BrightnessMappingStrategy.java    | 137 +++++++++++++++++-
 1 file changed, 135 insertions(+), 2 deletions(-)

diff --git a/services/core/java/com/android/server/display/BrightnessMappingStrategy.java b/services/core/java/com/android/server/display/BrightnessMappingStrategy.java
index 19195d8bbf2d..8513f44316f5 100644
--- a/services/core/java/com/android/server/display/BrightnessMappingStrategy.java
+++ b/services/core/java/com/android/server/display/BrightnessMappingStrategy.java
@@ -624,6 +624,7 @@ public abstract class BrightnessMappingStrategy {
         private float mUserLux;
         private float mUserBrightness;
         private long mShortTermModelTimeout;
+        private final ArrayList<UserPoint> mUserPoints = new ArrayList<>();
 
         private SimpleMappingStrategy(float[] lux, float[] brightness, float maxGamma,
                 long timeout, @AutomaticBrightnessController.AutomaticBrightnessMode int mode,
@@ -738,6 +739,10 @@ public abstract class BrightnessMappingStrategy {
             mAutoBrightnessAdjustment = adjustment;
             mUserLux = lux;
             mUserBrightness = brightness;
+            final UserPoint point = new UserPoint(lux, brightness - unadjustedBrightness);
+            mUserPoints.removeIf(p -> point.contains(p.lux));
+            mUserPoints.add(point);
+            mUserPoints.sort((a, b) -> Float.compare(a.lux, b.lux));
             computeSpline();
         }
 
@@ -752,6 +757,7 @@ public abstract class BrightnessMappingStrategy {
                 mAutoBrightnessAdjustment = 0;
                 mUserLux = INVALID_LUX;
                 mUserBrightness = PowerManager.BRIGHTNESS_INVALID_FLOAT;
+                mUserPoints.clear();
                 computeSpline();
             }
         }
@@ -785,6 +791,9 @@ public abstract class BrightnessMappingStrategy {
             pw.println("  mUserLux=" + mUserLux);
             pw.println("  mUserBrightness=" + mUserBrightness);
             pw.println("  mShortTermModelTimeout=" + mShortTermModelTimeout);
+            for (int i = 0; i < mUserPoints.size(); i++) {
+                pw.println("  mUserPoints[" + i + "]=" + mUserPoints.get(i));
+            }
         }
 
         @Override
@@ -807,16 +816,140 @@ public abstract class BrightnessMappingStrategy {
             return mUserBrightness;
         }
 
+        // stock one ui: the user change is a local offset around its lux, not a global gamma
         private void computeSpline() {
-            Pair<float[], float[]> curve = getAdjustedCurve(mLux, mBrightness, mUserLux,
-                    mUserBrightness, mAutoBrightnessAdjustment, mMaxGamma);
+            Pair<float[], float[]> curve = getOffsetAdjustedCurve();
             mSpline = Spline.createSpline(curve.first, curve.second);
         }
 
+        private Pair<float[], float[]> getOffsetAdjustedCurve() {
+            float[] lux = mLux;
+            float[] brightness = Arrays.copyOf(mBrightness, mBrightness.length);
+            if (mUserPoints.isEmpty()) {
+                return Pair.create(lux, brightness);
+            }
+
+            final int n = mUserPoints.size();
+            final ArrayList<Float> offsetLux = new ArrayList<>();
+            final ArrayList<Float> offsetValue = new ArrayList<>();
+            for (int i = 0; i < n; i++) {
+                final UserPoint p = mUserPoints.get(i);
+                if (i == 0 || !mUserPoints.get(i - 1).contains(p.lower)) {
+                    offsetLux.add(p.lower);
+                    offsetValue.add(0f);
+                }
+                offsetLux.add(p.lux);
+                offsetValue.add(p.offset);
+                if (i == n - 1 || !mUserPoints.get(i + 1).contains(p.upper)) {
+                    offsetLux.add(p.upper);
+                    offsetValue.add(0f);
+                }
+            }
+            final float[] ox = new float[offsetLux.size()];
+            final float[] oy = new float[offsetValue.size()];
+            for (int i = 0; i < ox.length; i++) {
+                ox[i] = offsetLux.get(i);
+                oy[i] = offsetValue.get(i);
+            }
+
+            final Spline base = Spline.createSpline(mLux, mBrightness);
+            final Spline offset = Spline.createLinearSpline(ox, oy);
+            for (int i = 0; i < brightness.length; i++) {
+                if (brightness[i] > 1.0f) {
+                    break;
+                }
+                brightness[i] = Math.min(brightness[i] + offset.interpolate(lux[i]), 1.0f);
+            }
+
+            for (int i = 0; i < ox.length; i++) {
+                if (ox[i] < 0) {
+                    continue;
+                }
+                final float value = base.interpolate(ox[i]) + oy[i];
+                int idx = 0;
+                while (idx < lux.length && ox[i] > lux[idx]) {
+                    idx++;
+                }
+                if (idx < lux.length && lux[idx] == ox[i]) {
+                    brightness[idx] = value;
+                    continue;
+                }
+                final float[] newLux = new float[lux.length + 1];
+                final float[] newBrightness = new float[brightness.length + 1];
+                System.arraycopy(lux, 0, newLux, 0, idx);
+                System.arraycopy(brightness, 0, newBrightness, 0, idx);
+                newLux[idx] = ox[i];
+                newBrightness[idx] = value;
+                System.arraycopy(lux, idx, newLux, idx + 1, lux.length - idx);
+                System.arraycopy(brightness, idx, newBrightness, idx + 1, brightness.length - idx);
+                lux = newLux;
+                brightness = newBrightness;
+            }
+
+            int idx = 0;
+            while (idx < lux.length && mUserLux > lux[idx]) {
+                idx++;
+            }
+            if (idx < lux.length) {
+                float prevLux = lux[idx];
+                float prevBrightness = brightness[idx];
+                for (int i = idx + 1; i < lux.length; i++) {
+                    prevBrightness = Math.min(Math.max(brightness[i],
+                            permissibleMinimumRatio(lux[i], prevLux) * prevBrightness), 1.0f);
+                    brightness[i] = prevBrightness;
+                    prevLux = lux[i];
+                }
+                prevLux = lux[idx];
+                prevBrightness = brightness[idx];
+                for (int i = idx - 1; i >= 0; i--) {
+                    prevBrightness = Math.min(brightness[i],
+                            permissibleMinimumRatio(lux[i], prevLux) * prevBrightness);
+                    brightness[i] = prevBrightness;
+                    prevLux = lux[i];
+                }
+            }
+            if (mLoggingEnabled) {
+                PLOG.logCurve("user offset curve", lux, brightness);
+            }
+            return Pair.create(lux, brightness);
+        }
+
+        private static float permissibleMinimumRatio(float currLux, float prevLux) {
+            if (currLux < 3.0f && prevLux < 3.0f) {
+                return 1.0f;
+            }
+            return MathUtils.exp((MathUtils.log(currLux + 0.25f)
+                    - MathUtils.log(prevLux + 0.25f)) * 0.05f);
+        }
+
         private float getUnadjustedBrightness(float lux) {
             Spline spline = Spline.createSpline(mLux, mBrightness);
             return spline.interpolate(lux);
         }
+
+        private static final class UserPoint {
+            final float lux;
+            final float offset;
+            final float lower;
+            final float upper;
+
+            UserPoint(float lux, float offset) {
+                this.lux = lux;
+                this.offset = offset;
+                lower = Math.min(lux / 2.5f, lux - 10.0f);
+                upper = Math.max(lux * 2.5f, lux + 10.0f);
+            }
+
+            boolean contains(float l) {
+                return lower <= l && l <= upper;
+            }
+
+            @Override
+            public String toString() {
+                return String.format(Locale.US, "%.1f (%+.4f) @ %.1f < %.1f < %.1f",
+                        lux, offset, lower, lux, upper);
+            }
+        }
     }
 
     /** A {@link BrightnessMappingStrategy} that maps from ambient room brightness to the physical
