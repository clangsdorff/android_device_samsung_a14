From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Mon, 16 Nov 2026 03:03:26 +0000
Subject: [PATCH 10/10] meta: spoof the build identity for meta apps

meta apps pick the software av1 and vp9 decoder thread count per
device model, and the a14 identity only gets 2 threads, which stutters
video playback.

add MetaPropsHooks and call it from handleBindApplication, before any
app code runs. for the instagram and facebook packages it sets MODEL,
DEVICE, PRODUCT, BRAND, MANUFACTURER and FINGERPRINT to a galaxy a16
one ui 9 build. HARDWARE, BOARD and SOC_MODEL stay untouched.

art write protects the static finals of android.os.Build, so
Field.set throws. write the fields with jdk.internal.misc.Unsafe
putReference on the class static base and field offset instead.
---
 core/java/android/app/ActivityThread.java     |  3 +
 .../android/internal/util/MetaPropsHooks.java | 74 +++++++++++++++++++
 2 files changed, 77 insertions(+)
 create mode 100644 core/java/com/android/internal/util/MetaPropsHooks.java

diff --git a/core/java/android/app/ActivityThread.java b/core/java/android/app/ActivityThread.java
index b7d9f6530..49d11ce08 100644
--- a/core/java/android/app/ActivityThread.java
+++ b/core/java/android/app/ActivityThread.java
@@ -261,6 +261,7 @@ import com.android.internal.policy.DecorView;
 import com.android.internal.protolog.ProtoLog;
 import com.android.internal.util.ArrayUtils;
 import com.android.internal.util.FastPrintWriter;
+import com.android.internal.util.MetaPropsHooks;
 import com.android.internal.util.Preconditions;
 import com.android.internal.util.function.pooled.PooledLambda;
 import com.android.org.conscrypt.TrustedCertificateStore;
@@ -8219,6 +8220,8 @@ public final class ActivityThread extends ClientTransactionHandler
             TrafficStats.init(appContext);
         }
 
+        MetaPropsHooks.setProps(data.appInfo.packageName);
+
         // Continue loading instrumentation.
         if (ii != null) {
             initInstrumentation(ii, data, appContext);
diff --git a/core/java/com/android/internal/util/MetaPropsHooks.java b/core/java/com/android/internal/util/MetaPropsHooks.java
new file mode 100644
index 000000000..b9a126d43
--- /dev/null
+++ b/core/java/com/android/internal/util/MetaPropsHooks.java
@@ -0,0 +1,74 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.internal.util;
+
+import android.os.Build;
+import android.util.Log;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.Map;
+
+public final class MetaPropsHooks {
+    private static final String TAG = "MetaPropsHooks";
+
+    private static final String[] PACKAGES = {
+        "com.instagram.android",
+        "com.instagram.barcelona",
+        "com.facebook.katana",
+        "com.facebook.orca",
+    };
+
+    private static final Map<String, String> PROPS = Map.of(
+        "MODEL", "SM-A166B",
+        "DEVICE", "a16x",
+        "PRODUCT", "a16xxx",
+        "BRAND", "samsung",
+        "MANUFACTURER", "samsung",
+        "FINGERPRINT",
+        "samsung/a16xxx/a16x:17/CP2A.260605.016/A166BXXUAEZJ5:user/release-keys");
+
+    private MetaPropsHooks() {}
+
+    public static void setProps(String packageName) {
+        if (packageName == null) {
+            return;
+        }
+        boolean match = false;
+        for (String pkg : PACKAGES) {
+            if (pkg.equals(packageName)) {
+                match = true;
+                break;
+            }
+        }
+        if (!match) {
+            return;
+        }
+        Log.d(TAG, "spoofing Build fields for " + packageName);
+        try {
+            // art rejects Field.set on android.os.Build static finals, unsafe does not check
+            Class<?> unsafeClass = Class.forName("jdk.internal.misc.Unsafe");
+            Field theOne = unsafeClass.getDeclaredField("THE_ONE");
+            theOne.setAccessible(true);
+            Object unsafe = theOne.get(null);
+            Method offsetOf = unsafeClass.getMethod("staticFieldOffset", Field.class);
+            Method baseOf = unsafeClass.getMethod("staticFieldBase", Field.class);
+            Method put = unsafeClass.getMethod("putReference",
+                    Object.class, long.class, Object.class);
+            for (Map.Entry<String, String> e : PROPS.entrySet()) {
+                try {
+                    Field f = Build.class.getDeclaredField(e.getKey());
+                    put.invoke(unsafe, baseOf.invoke(unsafe, f),
+                            offsetOf.invoke(unsafe, f), e.getValue());
+                } catch (ReflectiveOperationException ex) {
+                    Log.e(TAG, "failed to set " + e.getKey(), ex);
+                }
+            }
+        } catch (ReflectiveOperationException ex) {
+            Log.e(TAG, "failed to get unsafe", ex);
+        }
+    }
+}
