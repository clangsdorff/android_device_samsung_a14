From 9be0734d9c7aae6f006eccb6ef2cfb4405990e97 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Mon, 9 Nov 2026 01:14:22 +0300
Subject: [PATCH 11/11] display: port the stock auto brightness filtering

without a display device config the debounces are never loaded and
stay at -1, so every lux change moves the screen at once. the ambient
horizons are hardcoded and the percentage hysteresis wakes up on any
small change in the dark.

load the debounces from config.xml, make the horizons configurable
and add the absolute lux hysteresis tables that stock uses.
---
 core/res/res/values/config.xml                | 17 ++++++++
 core/res/res/values/symbols.xml               |  6 +++
 .../server/display/DisplayDeviceConfig.java   |  9 ++++
 .../display/config/HysteresisLevels.java      | 42 ++++++++++++++++++-
 4 files changed, 73 insertions(+), 1 deletion(-)

diff --git a/core/res/res/values/config.xml b/core/res/res/values/config.xml
index a19202f..29cc462 100644
--- a/core/res/res/values/config.xml
+++ b/core/res/res/values/config.xml
@@ -1663,6 +1663,11 @@
     <!-- Light sensor event rate in milliseconds for automatic brightness control. -->
     <integer name="config_autoBrightnessLightSensorRate">250</integer>
 
+    <!-- Long and short ambient light horizons in milliseconds, used when there is no display
+         device config. -->
+    <integer name="config_autoBrightnessAmbientLightHorizonLong">10000</integer>
+    <integer name="config_autoBrightnessAmbientLightHorizonShort">2000</integer>
+
     <!-- The maximum range of gamma adjustment possible using the screen
          auto-brightness adjustment setting. -->
     <fraction name="config_autoBrightnessAdjustmentMaxGamma">300%</fraction>
@@ -1945,6 +1950,18 @@
         <item>200</item>
     </integer-array>
 
+    <!-- Absolute ambient hysteresis, maps the current lux to the lux that triggers a change.
+         When set these replace the percentage thresholds above. Input and output must have the
+         same length, input must be strictly increasing. -->
+    <integer-array name="config_HysteresisBrightInputLux">
+    </integer-array>
+    <integer-array name="config_HysteresisBrightOutputLux">
+    </integer-array>
+    <integer-array name="config_HysteresisDarkInputLux">
+    </integer-array>
+    <integer-array name="config_HysteresisDarkOutputLux">
+    </integer-array>
+
     <!-- Array of screen brightness threshold values. This is used for determining hysteresis
          constraint values by calculating the index to use for lookup and then setting the
          constraint value to the corresponding value of the array. The new brightening hysteresis
