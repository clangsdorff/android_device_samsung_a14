diff --git a/services/core/java/com/android/server/display/DisplayDeviceConfig.java b/services/core/java/com/android/server/display/DisplayDeviceConfig.java
index f25b593..c0c9dfa 100644
--- a/services/core/java/com/android/server/display/DisplayDeviceConfig.java
+++ b/services/core/java/com/android/server/display/DisplayDeviceConfig.java
@@ -2888,6 +2888,15 @@ public class DisplayDeviceConfig {
     private void loadAutoBrightnessConfigsFromConfigXml() {
         mDisplayBrightnessMapping = new DisplayBrightnessMappingConfig(mContext, mFlags,
                 /* autoBrightnessConfig= */ null, getBacklightToBrightnessSpline());
+        // Idle must be loaded after interactive, it falls back to it.
+        loadAutoBrightnessBrighteningLightDebounce(/* autoBrightnessConfig= */ null);
+        loadAutoBrightnessDarkeningLightDebounce(/* autoBrightnessConfig= */ null);
+        loadAutoBrightnessBrighteningLightDebounceIdle(/* autoBrightnessConfig= */ null);
+        loadAutoBrightnessDarkeningLightDebounceIdle(/* autoBrightnessConfig= */ null);
+        mAmbientHorizonLong = mContext.getResources().getInteger(
+                com.android.internal.R.integer.config_autoBrightnessAmbientLightHorizonLong);
+        mAmbientHorizonShort = mContext.getResources().getInteger(
+                com.android.internal.R.integer.config_autoBrightnessAmbientLightHorizonShort);
     }
 
     private void loadBrightnessChangeThresholdsFromXml() {
diff --git a/services/core/java/com/android/server/display/config/HysteresisLevels.java b/services/core/java/com/android/server/display/config/HysteresisLevels.java
index e659d88..6987b68 100644
--- a/services/core/java/com/android/server/display/config/HysteresisLevels.java
+++ b/services/core/java/com/android/server/display/config/HysteresisLevels.java
@@ -21,6 +21,7 @@ import android.annotation.Nullable;
 import android.content.res.Resources;
 import android.util.Pair;
 import android.util.Slog;
+import android.util.Spline;
 
 import com.android.internal.annotations.VisibleForTesting;
 import com.android.server.display.utils.DebugUtils;
@@ -95,6 +96,10 @@ public class HysteresisLevels {
      */
     private final float mMinBrightening;
 
+    // Absolute lux thresholds, these replace the percentages when set.
+    @Nullable private Spline mBrighteningLuxSpline;
+    @Nullable private Spline mDarkeningLuxSpline;
+
     /**
      * Creates a {@code HysteresisLevels} object with the given equal-length
      * float arrays.
@@ -132,6 +137,10 @@ public class HysteresisLevels {
      * Return the brightening hysteresis threshold for the given value level.
      */
     public float getBrighteningThreshold(float value) {
+        if (mBrighteningLuxSpline != null) {
+            return Math.round(mBrighteningLuxSpline.interpolate(value));
+        }
+
         final float brightConstant = getReferenceLevel(value,
                 mBrighteningThresholdLevels, mBrighteningThresholdsPercentages);
 
@@ -149,6 +158,10 @@ public class HysteresisLevels {
      * Return the darkening hysteresis threshold for the given value level.
      */
     public float getDarkeningThreshold(float value) {
+        if (mDarkeningLuxSpline != null) {
+            return Math.max(Math.round(mDarkeningLuxSpline.interpolate(value)), -1);
+        }
+
         final float darkConstant = getReferenceLevel(value,
                 mDarkeningThresholdLevels, mDarkeningThresholdsPercentages);
         float darkThreshold = value * (1.0f - darkConstant);
@@ -242,7 +255,7 @@ public class HysteresisLevels {
      */
     public static HysteresisLevels loadAmbientBrightnessConfig(
             @Nullable DisplayConfiguration config, @Nullable Resources resources) {
-        return createHysteresisLevels(
+        final HysteresisLevels levels = createHysteresisLevels(
                 config == null ? null : config.getAmbientBrightnessChangeThresholds(),
                 com.android.internal.R.array.config_ambientThresholdLevels,
                 com.android.internal.R.array.config_ambientBrighteningThresholds,
@@ -251,6 +264,33 @@ public class HysteresisLevels {
                 DEFAULT_AMBIENT_BRIGHTENING_THRESHOLDS,
                 DEFAULT_AMBIENT_DARKENING_THRESHOLDS,
                 resources, /* potentialOldBrightnessScale= */ false);
+        if (config == null && resources != null) {
+            levels.mBrighteningLuxSpline = createLuxSpline(resources,
+                    com.android.internal.R.array.config_HysteresisBrightInputLux,
+                    com.android.internal.R.array.config_HysteresisBrightOutputLux);
+            levels.mDarkeningLuxSpline = createLuxSpline(resources,
+                    com.android.internal.R.array.config_HysteresisDarkInputLux,
+                    com.android.internal.R.array.config_HysteresisDarkOutputLux);
+        }
+        return levels;
+    }
+
+    @Nullable
+    private static Spline createLuxSpline(Resources resources, @ArrayRes int inputLux,
+            @ArrayRes int outputLux) {
+        final int[] input = resources.getIntArray(inputLux);
+        final int[] output = resources.getIntArray(outputLux);
+        if (input == null || output == null || input.length == 0
+                || input.length != output.length) {
+            return null;
+        }
+        final float[] x = new float[input.length];
+        final float[] y = new float[output.length];
+        for (int i = 0; i < input.length; i++) {
+            x[i] = input[i];
+            y[i] = output[i];
+        }
+        return Spline.createSpline(x, y);
     }
 
