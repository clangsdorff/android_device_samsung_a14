From 7d60f5d776187f5a887b283781882318640214b2 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Tue, 10 Nov 2026 22:34:53 +0300
Subject: [PATCH 14/14] SystemUI: remove legacy navbar space when the gesture
 hint is hidden

instagram keeps 24dp of empty space below its tabs when the lineage
navigation bar hint is hidden, even though the reported navigation bar
insets are zero, because it reads the legacy navigation_bar_height
dimensions. follow the navigation_bar_hint setting with
NavigationBarNoHintOverlay, which zeros those dimensions, and turn it
off again when the hint is shown or button navigation is selected. the
overlay is reconciled on boot and on user switch, and devices without
it keep their current behavior.
---
 .../NavigationModeController.java             | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/packages/SystemUI/src/com/android/systemui/navigationbar/NavigationModeController.java b/packages/SystemUI/src/com/android/systemui/navigationbar/NavigationModeController.java
index 5b9750f..7a18b60 100644
--- a/packages/SystemUI/src/com/android/systemui/navigationbar/NavigationModeController.java
+++ b/packages/SystemUI/src/com/android/systemui/navigationbar/NavigationModeController.java
@@ -17,14 +17,17 @@
 package com.android.systemui.navigationbar;
 
 import static android.content.Intent.ACTION_OVERLAY_CHANGED;
+import static android.view.WindowManagerPolicyConstants.NAV_BAR_MODE_GESTURAL;
 
 import android.content.BroadcastReceiver;
 import android.content.Context;
 import android.content.Intent;
 import android.content.IntentFilter;
 import android.content.om.IOverlayManager;
+import android.content.om.OverlayInfo;
 import android.content.pm.PackageManager;
 import android.content.res.ApkAssets;
+import android.database.ContentObserver;
 import android.os.PatternMatcher;
 import android.os.RemoteException;
 import android.os.ServiceManager;
@@ -50,6 +53,8 @@ import java.util.concurrent.Executor;
 
 import javax.inject.Inject;
 
+import lineageos.providers.LineageSettings;
+
 /**
  * Controller for tracking the current navigation bar mode.
  */
@@ -58,6 +63,8 @@ public class NavigationModeController implements Dumpable {
 
     private static final String TAG = NavigationModeController.class.getSimpleName();
     private static final boolean DEBUG = true;
+    private static final String NAV_BAR_NO_HINT_OVERLAY =
+            "com.android.internal.systemui.navbar.nohint";
 
     public interface ModeChangedListener {
         void onNavigationModeChanged(int mode);
@@ -68,6 +75,7 @@ public class NavigationModeController implements Dumpable {
     private final IOverlayManager mOverlayManager;
     private final Executor mUiBgExecutor;
     private final UserTracker mUserTracker;
+    private final ContentObserver mNavigationBarHintObserver;
 
     private ArrayList<ModeChangedListener> mListeners = new ArrayList<>();
 
@@ -113,6 +121,16 @@ public class NavigationModeController implements Dumpable {
         mUiBgExecutor = uiBgExecutor;
         dumpManager.registerDumpable(getClass().getSimpleName(), this);
 
+        mNavigationBarHintObserver = new ContentObserver(null) {
+            @Override
+            public void onChange(boolean selfChange) {
+                mainExecutor.execute(NavigationModeController.this::updateNavigationBarHintOverlay);
+            }
+        };
+        mContext.getContentResolver().registerContentObserver(
+                LineageSettings.System.getUriFor(LineageSettings.System.NAVIGATION_BAR_HINT),
+                false, mNavigationBarHintObserver, UserHandle.USER_ALL);
+
         IntentFilter overlayFilter = new IntentFilter(ACTION_OVERLAY_CHANGED);
         overlayFilter.addDataScheme("package");
         overlayFilter.addDataSchemeSpecificPart("android", PatternMatcher.PATTERN_LITERAL);
@@ -135,6 +153,7 @@ public class NavigationModeController implements Dumpable {
         Trace.beginSection("NMC#updateCurrentInteractionMode");
         mCurrentUserContext = getCurrentUserContext();
         int mode = getCurrentInteractionMode(mCurrentUserContext);
+        updateNavigationBarHintOverlay();
         mUiBgExecutor.execute(() ->
             Settings.Secure.putString(mCurrentUserContext.getContentResolver(),
                     Secure.NAVIGATION_MODE, String.valueOf(mode)));
@@ -151,6 +170,34 @@ public class NavigationModeController implements Dumpable {
         Trace.endSection();
     }
 
+    private void updateNavigationBarHintOverlay() {
+        final Context userContext = getCurrentUserContext();
+        mUiBgExecutor.execute(() -> {
+            final int userId = userContext.getUserId();
+            // Read the latest mode and setting when this task runs, including on boot/user switch.
+            final boolean hideHint = getCurrentInteractionMode(userContext) == NAV_BAR_MODE_GESTURAL
+                    && LineageSettings.System.getIntForUser(userContext.getContentResolver(),
+                            LineageSettings.System.NAVIGATION_BAR_HINT, 1, userId) == 0;
+            try {
+                final OverlayInfo info = mOverlayManager.getOverlayInfo(
+                        NAV_BAR_NO_HINT_OVERLAY, userId);
+                if (info == null || info.isEnabled() == hideHint) {
+                    return;
+                }
+                // Override the gesture-mode overlay's legacy 24dp dimensions as well as insets.
+                if (hideHint && !mOverlayManager.setHighestPriority(NAV_BAR_NO_HINT_OVERLAY, userId)) {
+                    Log.w(TAG, "Failed to prioritize navigation bar hint overlay for user " + userId);
+                    return;
+                }
+                if (!mOverlayManager.setEnabled(NAV_BAR_NO_HINT_OVERLAY, hideHint, userId)) {
+                    Log.w(TAG, "Failed to update navigation bar hint overlay for user " + userId);
+                }
+            } catch (RemoteException | SecurityException e) {
+                Log.w(TAG, "Failed to update navigation bar hint overlay for user " + userId, e);
+            }
+        });
+    }
+
     public int addListener(ModeChangedListener listener) {
         mListeners.add(listener);
         return getCurrentInteractionMode(mCurrentUserContext);
