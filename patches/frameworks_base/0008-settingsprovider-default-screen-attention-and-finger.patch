From 95d7c98003b0d0177a4cab4edeab46d6bbb3f45a Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sat, 7 Nov 2026 19:37:17 +0300
Subject: [PATCH 08/14] settingsprovider: default screen attention and
 fingerprint swipe on

screen attention and the fingerprint swipe navigation gesture should be
enabled out of the box. seed both secure settings to 1 when the secure
settings database is initialized.
---
 .../src/com/android/providers/settings/DatabaseHelper.java      | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java b/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
index dc2285f3eaee..3ebae08f676c 100644
--- a/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
+++ b/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
@@ -2187,6 +2187,8 @@ class DatabaseHelper extends SQLiteOpenHelper {
                     "1".equals(SystemProperties.get("ro.allow.mock.location")) ? 1 : 0);
 
             loadSecure35Settings(stmt);
+            loadSetting(stmt, Settings.Secure.ADAPTIVE_SLEEP, 1);
+            loadSetting(stmt, Settings.Secure.SYSTEM_NAVIGATION_KEYS_ENABLED, 1);
 
             loadBooleanSetting(stmt, Settings.Secure.MOUNT_PLAY_NOTIFICATION_SND,
                     R.bool.def_mount_play_notification_snd);
-- 
