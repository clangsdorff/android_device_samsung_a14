+    public static String parseLatestVersionPath(String html) {
+        if (html == null) {
+            return null;
+        }
+        Matcher preview = Pattern.compile(
+                "data-icon=\"preview\".*?href=\"(/about/versions/[^\"]+)\"",
+                Pattern.DOTALL).matcher(html);
+        if (preview.find()) {
+            return preview.group(1);
+        }
+        Matcher num = Pattern.compile("href=\"(/about/versions/[0-9]+)\"").matcher(html);
+        String best = null;
+        int bestVer = -1;
+        while (num.find()) {
+            String path = num.group(1);
+            int idx = path.lastIndexOf('/');
+            try {
+                int v = Integer.parseInt(path.substring(idx + 1));
+                if (v > bestVer) {
+                    bestVer = v;
+                    best = path;
+                }
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        return best;
+    }
+
+    public static String parseDownloadPath(String html) {
+        if (html == null) {
+            return null;
+        }
+        Matcher m = Pattern.compile("href=\"([^\"]*download[^\"]*)\"").matcher(html);
+        String bestNonOta = null;
+        String bestOta = null;
+        while (m.find()) {
+            String path = m.group(1);
+            if (path.contains("ota")) {
+                if (bestOta == null || path.compareTo(bestOta) > 0) {
+                    bestOta = path;
+                }
+            } else if (bestNonOta == null || path.compareTo(bestNonOta) > 0) {
+                bestNonOta = path;
+            }
+        }
+        return (bestNonOta != null) ? bestNonOta : bestOta;
+    }
+
+    public static List<String[]> parseDevices(String html) {
+        List<String[]> out = new ArrayList<>();
+        if (html == null) {
+            return out;
+        }
+        Matcher m = Pattern.compile(
+                "<tr id=\"([^\"]+)\">\\s*<td>([^<]+)</td>").matcher(html);
+        while (m.find()) {
+            String dev = m.group(1).trim();
+            String model = m.group(2).trim();
+            if (!dev.isEmpty() && !model.isEmpty()) {
+                out.add(new String[] { dev, model });
+            }
+        }
+        return out;
+    }
+
+    public static String parseFlashApiKey(String html) {
+        if (html == null) {
+            return null;
+        }
+        Matcher m = Pattern.compile("data-client-config=\"[^;]*;([^&\"]+)").matcher(html);
+        return m.find() ? m.group(1) : null;
+    }
+
+    public static String[] parseCanaryBuild(String jsonText) {
+        if (jsonText == null || jsonText.isEmpty()) {
+            return null;
+        }
+        try {
+            JSONObject root = new JSONObject(jsonText);
+            JSONArray builds = root.optJSONArray("flashstationBuild");
+            if (builds == null) {
+                return null;
+            }
+            for (int i = builds.length() - 1; i >= 0; i--) {
+                JSONObject b = builds.optJSONObject(i);
+                if (b == null) {
+                    continue;
+                }
+                JSONObject meta = b.optJSONObject("previewMetadata");
+                if (meta == null || !meta.optBoolean("canary", false)) {
+                    continue;
+                }
+                String canaryId = meta.optString("id", "");
+                String rc = b.optString("releaseCandidateName", "");
+                String buildId = b.optString("buildId", "");
+                if (!canaryId.isEmpty() && !rc.isEmpty() && !buildId.isEmpty()) {
+                    return new String[] { canaryId, rc, buildId };
+                }
+            }
+        } catch (JSONException e) {
+            Slog.w(TAG, "failed parsing flashstation JSON", e);
+        }
+        return null;
+    }
+
+    public static String extractYearMonth(String canaryId) {
+        if (canaryId == null) {
+            return null;
+        }
+        Matcher m = Pattern.compile("canary-(\\d{4})(\\d{2})").matcher(canaryId);
+        return m.find() ? (m.group(1) + "-" + m.group(2)) : null;
+    }
+
+    public static String parseSecurityPatch(String html, String yearMonth) {
+        if (html != null && yearMonth != null) {
+            Matcher m = Pattern.compile(
+                    "<td>(" + Pattern.quote(yearMonth) + "-[0-9]{2})</td>").matcher(html);
+            if (m.find()) {
+                return m.group(1);
+            }
+        }
+        return yearMonth + "-05";
+    }
