+    private static PifProfile readDiskProfile() {
+        File f = cacheFile();
+        if (!f.exists()) {
+            return null;
+        }
+        AtomicFile af = new AtomicFile(f);
+        try (FileInputStream fis = af.openRead()) {
+            byte[] data = fis.readAllBytes();
+            return PifProfile.fromJsonString(new String(data, StandardCharsets.UTF_8));
+        } catch (IOException e) {
+            Slog.w(TAG, "failed reading " + f, e);
+            return null;
+        }
+    }
+
+    private static void writeDiskProfile(PifProfile profile) {
+        File f = cacheFile();
+        AtomicFile af = new AtomicFile(f);
+        FileOutputStream fos = null;
+        try {
+            fos = af.startWrite();
+            fos.write(profile.toJsonString().getBytes(StandardCharsets.UTF_8));
+            af.finishWrite(fos);
+            f.setReadable(false, false);
+            f.setReadable(true, true);
+            f.setWritable(false, false);
+            f.setWritable(true, true);
+        } catch (IOException | JSONException e) {
+            Slog.w(TAG, "failed writing " + f, e);
+            if (fos != null) {
+                af.failWrite(fos);
+            }
+        }
+    }
