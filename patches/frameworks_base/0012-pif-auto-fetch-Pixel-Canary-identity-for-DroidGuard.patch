+
+    private void enforcePlayIntegritySettingsPermission(String op) {
+        mContext.enforceCallingOrSelfPermission(
+                android.Manifest.permission.WRITE_SECURE_SETTINGS, op);
+        mContext.enforceCallingOrSelfPermission(
+                android.Manifest.permission.MANAGE_USERS, op);
+    }
+
+    @Override
+    public String[] getPifProfile() {
+        final int callingPid = Binder.getCallingPid();
+        final int callingUid = Binder.getCallingUid();
+        final ProcessRecord proc;
+        synchronized (mPidsSelfLocked) {
+            proc = mPidsSelfLocked.get(callingPid);
+        }
+        if (proc == null || proc.uid != callingUid || proc.info == null) {
+            return null;
+        }
+        final boolean isDroidGuard = "com.google.android.gms".equals(proc.info.packageName)
+                && "com.google.android.gms.unstable".equals(proc.processName);
+        final boolean isVending = "com.android.vending".equals(proc.info.packageName)
+                && "com.android.vending".equals(proc.processName);
+        if (!isDroidGuard && !isVending) {
+            return null;
+        }
+        return PifAutoUpdater.getCurrentFlatPairs();
+    }
+
+    @Override
+    public String[] getPifStatus() {
+        enforcePlayIntegritySettingsPermission("getPifStatus");
+        final long token = Binder.clearCallingIdentity();
+        try {
+            return PifAutoUpdater.getStatusPairs();
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    @Override
+    public void setPifEnabled(boolean enabled) {
+        enforcePlayIntegritySettingsPermission("setPifEnabled");
+        final long token = Binder.clearCallingIdentity();
+        try {
+            PifAutoUpdater.setEnabled(enabled, this);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    @Override
+    public boolean refreshPifProfile() {
+        enforcePlayIntegritySettingsPermission("refreshPifProfile");
+        final long token = Binder.clearCallingIdentity();
+        try {
+            return PifAutoUpdater.refreshNow(this);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    @Override
+    public int setKeyboxXml(String xml) {
+        enforcePlayIntegritySettingsPermission("setKeyboxXml");
+        if (xml == null) {
+            return -1;
+        }
+        final long token = Binder.clearCallingIdentity();
+        try {
+            int res = android.security.AndroidKeyStoreMaintenance.setKeyboxXml(xml);
+            if (res >= 0) {
+                PifAutoUpdater.restartDroidGuard(this);
+            }
+            return res;
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    @Override
+    public int getKeyboxStatus() {
+        enforcePlayIntegritySettingsPermission("getKeyboxStatus");
+        final long token = Binder.clearCallingIdentity();
+        try {
+            return android.security.AndroidKeyStoreMaintenance.getKeyboxStatus();
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    @Override
+    public String[] getKeyboxDetails(boolean checkOnline) {
+        enforcePlayIntegritySettingsPermission("getKeyboxDetails");
+        final long token = Binder.clearCallingIdentity();
+        try {
+            return PifAutoUpdater.getKeyboxDetails(checkOnline);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
 }
