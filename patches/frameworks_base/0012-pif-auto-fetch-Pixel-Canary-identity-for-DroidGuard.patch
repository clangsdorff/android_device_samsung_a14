+    public static String[] getKeyboxDetails(boolean checkOnline) {
+        int statusMask = android.security.AndroidKeyStoreMaintenance.getKeyboxStatus();
+        if (statusMask <= 0) {
+            return new String[] { "0", "NONE", "", "0", "0" };
+        }
+        String[] certsHex = android.security.AndroidKeyStoreMaintenance.getKeyboxCertsHex();
+        JSONObject crl = getCrlEntries(checkOnline);
+        return inspectKeyboxCerts(statusMask, certsHex, crl, System.currentTimeMillis());
+    }
+
+    private static JSONObject getCrlEntries(boolean checkOnline) {
+        long now = System.currentTimeMillis();
+        JSONObject cached = sCrlEntries;
+        if (cached != null && (now - sCrlFetchedAtMs) < CRL_CACHE_TTL_MS) {
+            return cached;
+        }
+        if (!checkOnline) {
+            return cached;
+        }
+        try {
+            String json = httpGet(URL_ATTESTATION_STATUS, null);
+            JSONObject root = new JSONObject(json);
+            JSONObject entries = root.optJSONObject("entries");
+            if (entries != null) {
+                sCrlEntries = entries;
+                sCrlFetchedAtMs = System.currentTimeMillis();
+                return entries;
+            }
+        } catch (Throwable t) {
+            Slog.w(TAG, "failed fetching Google attestation CRL", t);
+        }
+        return cached;
+    }
+
+    public static String[] inspectKeyboxCerts(
+            int statusMask, String[] certsHex, JSONObject crlEntries, long nowMs) {
+        if (statusMask <= 0 || certsHex == null || certsHex.length == 0) {
+            return new String[] {
+                String.valueOf(Math.max(0, statusMask)), "NONE", "", "0", "0"
+            };
+        }
+        long earliestExpiryMs = Long.MAX_VALUE;
+        boolean expired = false;
+        boolean notYetValid = false;
+        boolean isAospTest = false;
+        boolean isRkp = false;
+        String revokedDetail = null;
+
+        try {
+            CertificateFactory cf = CertificateFactory.getInstance("X.509");
+            HexFormat hexFmt = HexFormat.of();
+            for (String hex : certsHex) {
+                if (hex == null || hex.isEmpty()) {
+                    continue;
+                }
+                byte[] der = hexFmt.parseHex(hex);
+                X509Certificate cert = (X509Certificate)
+                        cf.generateCertificate(new ByteArrayInputStream(der));
+                long notBefore = cert.getNotBefore().getTime();
+                long notAfter = cert.getNotAfter().getTime();
+                if (notAfter < earliestExpiryMs) {
+                    earliestExpiryMs = notAfter;
+                }
+                if (nowMs > notAfter) {
+                    expired = true;
+                } else if (nowMs < notBefore) {
+                    notYetValid = true;
+                }
+                String subj = cert.getSubjectX500Principal().getName();
+                String iss = cert.getIssuerX500Principal().getName();
+                if (subj.contains("Android Keystore Software Attestation")
+                        || iss.contains("Android Keystore Software Attestation")) {
+                    isAospTest = true;
+                }
+                if (cert.getExtensionValue(RKP_METADATA_OID) != null) {
+                    isRkp = true;
+                }
+                if (crlEntries != null && revokedDetail == null) {
+                    BigInteger serial = cert.getSerialNumber();
+                    String hexKey = serial.toString(16).toLowerCase(Locale.ROOT);
+                    String decKey = serial.toString(10);
+                    JSONObject entry = crlEntries.optJSONObject(hexKey);
+                    if (entry == null) {
+                        entry = crlEntries.optJSONObject(decKey);
+                    }
+                    if (entry != null) {
+                        String st = entry.optString("status", "REVOKED");
+                        String reason = entry.optString("reason", "");
+                        revokedDetail = reason.isEmpty() ? st : (st + ": " + reason);
+                    }
+                }
+            }
+        } catch (Throwable t) {
+            Slog.w(TAG, "failed inspecting keybox certs", t);
+        }
+
+        if (earliestExpiryMs == Long.MAX_VALUE) {
+            earliestExpiryMs = 0L;
+        }
+        final String verdict;
+        final String detail;
+        if (revokedDetail != null) {
+            verdict = "REVOKED";
+            detail = revokedDetail;
+        } else if (expired) {
+            verdict = "EXPIRED";
+            detail = "";
+        } else if (notYetValid) {
+            verdict = "NOT_YET_VALID";
+            detail = "";
+        } else if (isAospTest) {
+            verdict = "AOSP_TEST";
+            detail = "";
+        } else if (crlEntries == null) {
+            verdict = "OFFLINE";
+            detail = "";
+        } else {
+            verdict = "VALID";
+            detail = "";
+        }
+        return new String[] {
+            String.valueOf(statusMask),
+            verdict,
+            detail,
+            Long.toString(earliestExpiryMs),
+            isRkp ? "1" : "0",
+        };
+    }
+
+    private static String httpGet(String urlStr, String referer) throws IOException {
+        HttpURLConnection conn = (HttpURLConnection) new URL(urlStr).openConnection();
+        conn.setConnectTimeout(HTTP_TIMEOUT_MS);
+        conn.setReadTimeout(HTTP_TIMEOUT_MS);
+        conn.setRequestProperty("User-Agent", "Mozilla/5.0");
+        if (referer != null) {
+            conn.setRequestProperty("Referer", referer);
+        }
+        try {
+            int code = conn.getResponseCode();
+            if (code != HttpURLConnection.HTTP_OK) {
+                throw new IOException("HTTP " + code + " for " + urlStr);
+            }
+            try (InputStream is = conn.getInputStream();
+                 ByteArrayOutputStream baos = new ByteArrayOutputStream()) {
+                byte[] buf = new byte[8192];
+                int n;
+                while ((n = is.read(buf)) >= 0) {
+                    baos.write(buf, 0, n);
+                }
+                return baos.toString(StandardCharsets.UTF_8);
+            }
+        } finally {
+            conn.disconnect();
+        }
+    }
+}
