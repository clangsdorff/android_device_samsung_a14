+    public static PifProfile fetchLatestCanary(long nowMs) throws IOException {
+        String versionsHtml = httpGet(URL_VERSIONS, null);
+        String latestBetaPath = parseLatestVersionPath(versionsHtml);
+        if (latestBetaPath == null) {
+            return null;
+        }
+
+        String latestHtml = httpGet("https://developer.android.com" + latestBetaPath, null);
+        String dlPath = parseDownloadPath(latestHtml);
+        if (dlPath == null) {
+            return null;
+        }
+        String dlUrl = dlPath.startsWith("http")
+                ? dlPath : ("https://developer.android.com" + dlPath);
+        String dlHtml = httpGet(dlUrl, null);
+        List<String[]> devices = parseDevices(dlHtml);
+        if (devices.isEmpty()) {
+            return null;
+        }
+
+        String flashHtml = httpGet(URL_FLASH, null);
+        String apiKey = parseFlashApiKey(flashHtml);
+        if (apiKey == null) {
+            return null;
+        }
+
+        // Prefer devices with first_api_level <= 35 (avoid RKP-only >= 36 devices when possible).
+        List<String[]> ordered = new ArrayList<>();
+        for (String[] dm : devices) {
+            if (FIRST_API_MAP.containsKey(dm[0])) {
+                ordered.add(dm);
+            }
+        }
+        for (String[] dm : devices) {
+            if (!FIRST_API_MAP.containsKey(dm[0])) {
+                ordered.add(dm);
+            }
+        }
+
+        String secBullHtml = null;
+        for (String[] dm : ordered) {
+            String dev = dm[0];
+            String model = dm[1];
+            String prod = dev + "_beta";
+            String buildsUrl = String.format(URL_FLASH_BUILDS, prod, apiKey);
+            String buildsJson = httpGet(buildsUrl, "https://flash.android.com");
+            String[] parsed = parseCanaryBuild(buildsJson);
+            if (parsed == null) {
+                continue;
+            }
+            String canaryId = parsed[0];
+            String id = parsed[1];
+            String incr = parsed[2];
+            String ym = extractYearMonth(canaryId);
+            if (ym == null) {
+                continue;
+            }
+            if (secBullHtml == null) {
+                try {
+                    secBullHtml = httpGet(URL_SECURITY_BULLETIN, null);
+                } catch (IOException ignored) {
+                    secBullHtml = "";
+                }
+            }
+            String patch = parseSecurityPatch(secBullHtml, ym);
+            String firstApi = FIRST_API_MAP.getOrDefault(dev, "35");
+            String fp = "google/" + prod + "/" + dev + ":CANARY/" + id + "/" + incr
+                    + ":user/release-keys";
+            return new PifProfile("Google", "google", model, dev, prod, id, incr,
+                    "CANARY", "user", "release-keys", fp, patch, firstApi, nowMs);
+        }
+        return null;
+    }
