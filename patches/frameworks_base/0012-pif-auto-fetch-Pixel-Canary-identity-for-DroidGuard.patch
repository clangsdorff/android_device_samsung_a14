+    private static void killDroidGuardProcess(ActivityManagerService ams) {
+        synchronized (ams.mPidsSelfLocked) {
+            for (int i = 0; i < ams.mPidsSelfLocked.size(); i++) {
+                ProcessRecord pr = ams.mPidsSelfLocked.valueAt(i);
+                if (pr != null && "com.google.android.gms.unstable".equals(pr.processName)) {
+                    int pid = pr.getPid();
+                    if (pid > 0) {
+                        Slog.i(TAG, "restarting DroidGuard pid=" + pid + " for new PIF profile");
+                        Process.killProcess(pid);
+                    }
+                }
+            }
+        }
+    }
