diff --git a/core/java/com/android/internal/util/PifHooks.java b/core/java/com/android/internal/util/PifHooks.java
new file mode 100644
index 000000000000..bd99b6a47a08
--- /dev/null
+++ b/core/java/com/android/internal/util/PifHooks.java
@@ -0,0 +1,230 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.internal.util;
+
+import android.app.ActivityManager;
+import android.os.Build;
+import android.os.Process;
+import android.os.SystemProperties;
+import android.util.Log;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+
+/**
+ * Applies dynamically updated Play Integrity Fix properties inside DroidGuard
+ * ({@code com.google.android.gms.unstable}) before application code executes.
+ *
+ * @hide
+ */
+public final class PifHooks {
+    private static final String TAG = "PifHooks";
+    private static final String DROIDGUARD_PROCESS = "com.google.android.gms.unstable";
+    private static final String VENDING_PROCESS = "com.android.vending";
+
+    private PifHooks() {}
+
+    public static void setProps(String processName) {
+        if (Process.isIsolated()) {
+            return;
+        }
+        final boolean isDroidGuard = DROIDGUARD_PROCESS.equals(processName);
+        final boolean isVending = VENDING_PROCESS.equals(processName);
+        if (!isDroidGuard && !isVending) {
+            return;
+        }
+        final String[] kv;
+        try {
+            kv = ActivityManager.getService().getPifProfile();
+        } catch (Throwable t) {
+            Log.w(TAG, "failed to fetch pif profile", t);
+            return;
+        }
+        if (kv == null || kv.length < 2 || (kv.length & 1) != 0) {
+            return;
+        }
+
+        String manufacturer = null;
+        String brand = null;
+        String model = null;
+        String device = null;
+        String product = null;
+        String id = null;
+        String incremental = null;
+        String release = null;
+        String type = null;
+        String tags = null;
+        String fingerprint = null;
+        String securityPatch = null;
+        String firstApi = null;
+
+        for (int i = 0; i < kv.length; i += 2) {
+            String k = kv[i];
+            String v = kv[i + 1];
+            if (k == null || v == null || v.isEmpty()) {
+                continue;
+            }
+            switch (k) {
+                case "MANUFACTURER": manufacturer = v; break;
+                case "BRAND": brand = v; break;
+                case "MODEL": model = v; break;
+                case "DEVICE": device = v; break;
+                case "PRODUCT": product = v; break;
+                case "ID": id = v; break;
+                case "INCREMENTAL": incremental = v; break;
+                case "RELEASE": release = v; break;
+                case "TYPE": type = v; break;
+                case "TAGS": tags = v; break;
+                case "FINGERPRINT": fingerprint = v; break;
+                case "SECURITY_PATCH": securityPatch = v; break;
+                case "DEVICE_INITIAL_SDK_INT": firstApi = v; break;
+                default: break;
+            }
+        }
+        if (isVending) {
+            if (fingerprint != null) {
+                SystemProperties.setProcessOverride("ro.build.fingerprint", fingerprint);
+                setSingleBuildField(Build.class, "FINGERPRINT", fingerprint);
+            }
+            return;
+        }
+
+        if ("CANARY".equalsIgnoreCase(release)) {
+            String ownRelease = Build.VERSION.RELEASE;
+            release = (ownRelease != null && !ownRelease.isEmpty()) ? ownRelease : null;
+        }
+
+
+        // Override bionic system properties first so both Java SystemProperties and native
+        // __system_property_get / __system_property_read_callback see the spoofed values.
+        if (fingerprint != null) {
+            SystemProperties.setProcessOverride("ro.build.fingerprint", fingerprint);
+            SystemProperties.setProcessOverride("ro.system.build.fingerprint", fingerprint);
+            SystemProperties.setProcessOverride("ro.system_ext.build.fingerprint", fingerprint);
+            SystemProperties.setProcessOverride("ro.product.build.fingerprint", fingerprint);
+            SystemProperties.setProcessOverride("ro.vendor.build.fingerprint", fingerprint);
+            SystemProperties.setProcessOverride("ro.odm.build.fingerprint", fingerprint);
+            SystemProperties.setProcessOverride("ro.bootimage.build.fingerprint", fingerprint);
+        }
+        if (id != null) {
+            SystemProperties.setProcessOverride("ro.build.id", id);
+            SystemProperties.setProcessOverride("ro.build.display.id", id);
+        }
+        if (type != null) {
+            SystemProperties.setProcessOverride("ro.build.type", type);
+        }
+        if (tags != null) {
+            SystemProperties.setProcessOverride("ro.build.tags", tags);
+        }
+        if (device != null) {
+            SystemProperties.setProcessOverride("ro.product.device", device);
+            SystemProperties.setProcessOverride("ro.product.system.device", device);
+            SystemProperties.setProcessOverride("ro.product.vendor.device", device);
+            SystemProperties.setProcessOverride("ro.product.product.device", device);
+        }
+        if (product != null) {
+            SystemProperties.setProcessOverride("ro.product.name", product);
+            SystemProperties.setProcessOverride("ro.product.system.name", product);
+            SystemProperties.setProcessOverride("ro.product.vendor.name", product);
+            SystemProperties.setProcessOverride("ro.product.product.name", product);
+            SystemProperties.setProcessOverride("ro.build.flavor", product + "-user");
+        }
+        if (model != null) {
+            SystemProperties.setProcessOverride("ro.product.model", model);
+            SystemProperties.setProcessOverride("ro.product.system.model", model);
+            SystemProperties.setProcessOverride("ro.product.vendor.model", model);
+            SystemProperties.setProcessOverride("ro.product.product.model", model);
+        }
+        if (brand != null) {
+            SystemProperties.setProcessOverride("ro.product.brand", brand);
+            SystemProperties.setProcessOverride("ro.product.system.brand", brand);
+            SystemProperties.setProcessOverride("ro.product.vendor.brand", brand);
+            SystemProperties.setProcessOverride("ro.product.product.brand", brand);
+        }
+        if (manufacturer != null) {
+            SystemProperties.setProcessOverride("ro.product.manufacturer", manufacturer);
+            SystemProperties.setProcessOverride("ro.product.system.manufacturer", manufacturer);
+            SystemProperties.setProcessOverride("ro.product.vendor.manufacturer", manufacturer);
+            SystemProperties.setProcessOverride("ro.product.product.manufacturer", manufacturer);
+        }
+        if (release != null) {
+            SystemProperties.setProcessOverride("ro.build.version.release", release);
+            SystemProperties.setProcessOverride("ro.build.version.release_or_codename", release);
+        }
+        if (incremental != null) {
+            SystemProperties.setProcessOverride("ro.build.version.incremental", incremental);
+        }
+        if (securityPatch != null) {
+            SystemProperties.setProcessOverride("ro.build.version.security_patch", securityPatch);
+            SystemProperties.setProcessOverride("ro.vendor.build.security_patch", securityPatch);
+            SystemProperties.setProcessOverride("ro.system.build.version.security_patch",
+                    securityPatch);
+            SystemProperties.setProcessOverride("ro.product.build.version.security_patch",
+                    securityPatch);
+        }
+        if (firstApi != null) {
+            SystemProperties.setProcessOverride("ro.product.first_api_level", firstApi);
+            SystemProperties.setProcessOverride("ro.board.first_api_level", firstApi);
+        }
+
+        // Write static final Build and Build.VERSION fields through Unsafe.
+        try {
+            Class<?> unsafeClass = Class.forName("jdk.internal.misc.Unsafe");
+            Field theOne = unsafeClass.getDeclaredField("THE_ONE");
+            theOne.setAccessible(true);
+            Object unsafe = theOne.get(null);
+            Method offsetOf = unsafeClass.getMethod("staticFieldOffset", Field.class);
+            Method baseOf = unsafeClass.getMethod("staticFieldBase", Field.class);
+            Method putRef = unsafeClass.getMethod("putReference",
+                    Object.class, long.class, Object.class);
+
+            setBuildField(unsafe, offsetOf, baseOf, putRef, Build.class, "MANUFACTURER", manufacturer);
+            setBuildField(unsafe, offsetOf, baseOf, putRef, Build.class, "BRAND", brand);
+            setBuildField(unsafe, offsetOf, baseOf, putRef, Build.class, "MODEL", model);
+            setBuildField(unsafe, offsetOf, baseOf, putRef, Build.class, "DEVICE", device);
+            setBuildField(unsafe, offsetOf, baseOf, putRef, Build.class, "PRODUCT", product);
+            setBuildField(unsafe, offsetOf, baseOf, putRef, Build.class, "ID", id);
+            setBuildField(unsafe, offsetOf, baseOf, putRef, Build.class, "DISPLAY", id);
+            setBuildField(unsafe, offsetOf, baseOf, putRef, Build.class, "FINGERPRINT", fingerprint);
+            setBuildField(unsafe, offsetOf, baseOf, putRef, Build.class, "TYPE", type);
+            setBuildField(unsafe, offsetOf, baseOf, putRef, Build.class, "TAGS", tags);
+            setBuildField(unsafe, offsetOf, baseOf, putRef, Build.VERSION.class, "RELEASE", release);
+            setBuildField(unsafe, offsetOf, baseOf, putRef, Build.VERSION.class, "INCREMENTAL", incremental);
+            setBuildField(unsafe, offsetOf, baseOf, putRef, Build.VERSION.class, "SECURITY_PATCH", securityPatch);
+        } catch (ReflectiveOperationException ex) {
+            Log.e(TAG, "failed to update Build fields", ex);
+        }
+    }
+
+    private static void setBuildField(Object unsafe, Method offsetOf, Method baseOf,
+            Method putRef, Class<?> target, String name, String value) {
+        if (value == null) {
+            return;
+        }
+        try {
+            Field f = target.getDeclaredField(name);
+            putRef.invoke(unsafe, baseOf.invoke(unsafe, f), offsetOf.invoke(unsafe, f), value);
+        } catch (ReflectiveOperationException ex) {
+            Log.e(TAG, "failed to set " + target.getSimpleName() + "." + name, ex);
+        }
+    }
+
+    private static void setSingleBuildField(Class<?> target, String name, String value) {
+        try {
+            Class<?> unsafeClass = Class.forName("jdk.internal.misc.Unsafe");
+            Field theOne = unsafeClass.getDeclaredField("THE_ONE");
+            theOne.setAccessible(true);
+            Object unsafe = theOne.get(null);
+            Method offsetOf = unsafeClass.getMethod("staticFieldOffset", Field.class);
+            Method baseOf = unsafeClass.getMethod("staticFieldBase", Field.class);
+            Method putRef = unsafeClass.getMethod("putReference",
+                    Object.class, long.class, Object.class);
+            setBuildField(unsafe, offsetOf, baseOf, putRef, target, name, value);
+        } catch (ReflectiveOperationException ex) {
+            Log.e(TAG, "failed to update " + target.getSimpleName() + "." + name, ex);
+        }
+    }
+}
