+    public static void start(Context context, ActivityManagerService ams) {
+        if (!sStarted.compareAndSet(false, true)) {
+            return;
+        }
+        getOrLoadProfile();
+        final Handler handler = BackgroundThread.getHandler();
+
+        ConnectivityManager cm = context.getSystemService(ConnectivityManager.class);
+        if (cm != null) {
+            NetworkRequest req = new NetworkRequest.Builder()
+                    .addCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
+                    .addCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED)
+                    .build();
+            cm.registerNetworkCallback(req, new ConnectivityManager.NetworkCallback() {
+                @Override
+                public void onAvailable(Network network) {
+                    sHasValidatedNet = true;
+                    scheduleCheckIfDue(ams, handler, 2_000L);
+                }
+
+                @Override
+                public void onLost(Network network) {
+                    sHasValidatedNet = false;
+                }
+            });
+        }
+        scheduleCheckIfDue(ams, handler, 15_000L);
+    }
+
+    private static void scheduleCheckIfDue(ActivityManagerService ams, Handler handler, long delayMs) {
+        handler.postDelayed(() -> {
+            PifProfile cur = getOrLoadProfile();
+            if (!cur.enabled) {
+                return;
+            }
+            long now = System.currentTimeMillis();
+            boolean fresh = cur.fetchedAtMs > 0L
+                    && cur.fetchedAtMs <= now + 86_400_000L
+                    && (now - cur.fetchedAtMs) < REFRESH_INTERVAL_MS;
+            if (fresh) {
+                long remaining = REFRESH_INTERVAL_MS - (now - cur.fetchedAtMs);
+                handler.postDelayed(() -> scheduleCheckIfDue(ams, handler, 0L),
+                        Math.max(remaining, 60_000L));
+                return;
+            }
+            if (!sHasValidatedNet) {
+                return;
+            }
+            triggerFetchAsync(ams, handler);
+        }, delayMs);
+    }
+
+    private static void triggerFetchAsync(ActivityManagerService ams, Handler handler) {
+        if (!sFetching.compareAndSet(false, true)) {
+            return;
+        }
+        new Thread(() -> {
+            try {
+                PifProfile fetched = fetchLatestCanary(System.currentTimeMillis());
+                if (fetched != null) {
+                    boolean identityChanged;
+                    synchronized (LOCK) {
+                        PifProfile cur = getOrLoadProfile();
+                        identityChanged = !fetched.sameIdentity(cur);
+                        sCurrentProfile = fetched.withEnabled(cur.enabled);
+                        writeDiskProfile(sCurrentProfile);
+                    }
+                    sRetryBackoffMs = RETRY_INITIAL_MS;
+                    Slog.i(TAG, "updated PIF profile: " + fetched.fingerprint
+                            + " (" + fetched.securityPatch + ")");
+                    if (identityChanged && ams != null) {
+                        killDroidGuardProcess(ams);
+                    }
+                    handler.postDelayed(() -> scheduleCheckIfDue(ams, handler, 0L),
+                            REFRESH_INTERVAL_MS);
+                } else {
+                    scheduleRetry(ams, handler);
+                }
+            } catch (Throwable t) {
+                Slog.w(TAG, "PIF auto-update failed", t);
+                scheduleRetry(ams, handler);
+            } finally {
+                sFetching.set(false);
+            }
+        }, "PifAutoUpdater").start();
+    }
+
+    private static void scheduleRetry(ActivityManagerService ams, Handler handler) {
+        long delay = sRetryBackoffMs;
+        sRetryBackoffMs = Math.min(sRetryBackoffMs * 2L, RETRY_MAX_MS);
+        handler.postDelayed(() -> scheduleCheckIfDue(ams, handler, 0L), delay);
+    }
