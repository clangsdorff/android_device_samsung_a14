From 373c9524fc09854f389e768b85a41e5dfef16d2b Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Mon, 16 Nov 2026 15:10:50 +0300
Subject: [PATCH] display: support camera light sensor fallback

devices without a hardware light sensor cannot drive aosp auto
brightness on their own. allow AutomaticBrightnessController to bind a
configured system service when mLightSensor is null and feed lux samples
from the front camera.
---
 core/res/res/values/config.xml                |   4 +
 core/res/res/values/symbols.xml               |   1 +
 .../AutomaticBrightnessController.java        | 136 +++++++++++++++++-
 3 files changed, 134 insertions(+), 7 deletions(-)

diff --git a/core/res/res/values/config.xml b/core/res/res/values/config.xml
index 29cc462..5d0f076 100644
--- a/core/res/res/values/config.xml
+++ b/core/res/res/values/config.xml
@@ -5203,6 +5203,10 @@
     -->
     <string name="config_defaultAttentionService" translatable="false"></string>
 
+    <!-- Component name for a camera-based fallback light sensor service used when
+         no hardware light sensor is present. -->
+    <string name="config_cameraLightService" translatable="false"></string>
+
     <!-- The component name for the default system rotation resolver service.
         This service must be trusted, as it can be activated without explicit consent of the user.
         See android.service.rotationresolver.RotationResolverService.
diff --git a/core/res/res/values/symbols.xml b/core/res/res/values/symbols.xml
