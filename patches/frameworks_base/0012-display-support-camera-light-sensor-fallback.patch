     }
@@ -1067,7 +1111,11 @@ public class AutomaticBrightnessController {
             mCallbacks.updateBrightness();
         }
         if (mAutoBrightnessOneShot) {
-            mSensorManager.unregisterListener(mLightSensorListener);
+            if (mLightSensor != null) {
