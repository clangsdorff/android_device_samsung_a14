+
     // Callbacks for requesting updates to the display's power state
     private final Callbacks mCallbacks;
 
@@ -123,6 +133,12 @@ public class AutomaticBrightnessController {
     // The light sensor, or null if not available or needed.
     private final Sensor mLightSensor;
 
+    private final ComponentName mCameraLightComponent;
+    private final Messenger mCameraLightIncoming;
+    private Messenger mCameraLightOutbound;
+    private boolean mCameraLightBound;
+    private boolean mCameraLightEnabled;
+
     // The mapper to translate ambient lux to screen brightness in the range [0, 1.0].
     @NonNull
     private BrightnessMappingStrategy mCurrentBrightnessMapper;
@@ -371,6 +387,13 @@ public class AutomaticBrightnessController {
             mLightSensor = lightSensor;
         }
 
+        String cameraLight = mLightSensor == null ? context.getString(
+                com.android.internal.R.string.config_cameraLightService) : null;
+        mCameraLightComponent = cameraLight != null && !cameraLight.isEmpty()
+                ? ComponentName.unflattenFromString(cameraLight) : null;
+        mCameraLightIncoming = mCameraLightComponent != null
+                ? new Messenger(new CameraLightHandler(looper)) : null;
+
         mActivityTaskManager = ActivityTaskManager.getService();
         mPackageManager = mContext.getPackageManager();
         mTaskStackListener = new TaskStackListenerImpl();
@@ -498,6 +521,7 @@ public class AutomaticBrightnessController {
 
     public void stop() {
         setLightSensorEnabled(false);
+        unbindCameraLight();
     }
 
     public boolean hasUserDataPoints() {
@@ -547,10 +571,18 @@ public class AutomaticBrightnessController {
 
     private void handleSettingsChange(boolean autoBrightnessOneShot) {
         if (mAutoBrightnessOneShot && !autoBrightnessOneShot) {
-            mSensorManager.registerListener(mLightSensorListener, mLightSensor,
-                    mCurrentLightSensorRate * 1000, mHandler);
+            if (mLightSensor != null) {
+                mSensorManager.registerListener(mLightSensorListener, mLightSensor,
+                        mCurrentLightSensorRate * 1000, mHandler);
+            } else if (mCameraLightComponent != null) {
+                setCameraLightEnabled(true);
+            }
         } else if (!mAutoBrightnessOneShot && autoBrightnessOneShot) {
-            mSensorManager.unregisterListener(mLightSensorListener);
