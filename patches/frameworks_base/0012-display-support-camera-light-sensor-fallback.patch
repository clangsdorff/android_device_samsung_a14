@@ -1450,6 +1498,80 @@ public class AutomaticBrightnessController {
         }
     }
 
+    private void setCameraLightEnabled(boolean enable) {
+        if (mCameraLightComponent == null || mCameraLightEnabled == enable) {
+            return;
+        }
+        mCameraLightEnabled = enable;
+        if (enable) {
+            if (!mCameraLightBound) {
+                Intent intent = new Intent().setComponent(mCameraLightComponent);
+                mCameraLightBound = mContext.bindServiceAsUser(
+                        intent, mCameraLightConnection, Context.BIND_AUTO_CREATE,
+                        UserHandle.SYSTEM);
+            }
+            sendCameraLightCommand(MSG_CAMERA_LIGHT_START);
+        } else {
+            sendCameraLightCommand(MSG_CAMERA_LIGHT_STOP);
+        }
+    }
+
+    private void unbindCameraLight() {
+        if (mCameraLightBound) {
+            mCameraLightBound = false;
+            mCameraLightOutbound = null;
+            mContext.unbindService(mCameraLightConnection);
+        }
+    }
+
+    private void sendCameraLightCommand(int what) {
+        if (mCameraLightOutbound == null) {
+            return;
+        }
+        try {
+            Message msg = Message.obtain(null, what);
+            if (what == MSG_CAMERA_LIGHT_START) {
+                msg.replyTo = mCameraLightIncoming;
+            }
+            mCameraLightOutbound.send(msg);
+        } catch (RemoteException e) {
+            Slog.w(TAG, "Failed to send command to camera light service", e);
+        }
+    }
+
+    private final ServiceConnection mCameraLightConnection = new ServiceConnection() {
+        @Override
+        public void onServiceConnected(ComponentName name, IBinder service) {
+            mHandler.post(() -> {
+                mCameraLightOutbound = new Messenger(service);
+                if (mCameraLightEnabled) {
+                    sendCameraLightCommand(MSG_CAMERA_LIGHT_START);
+                }
+            });
+        }
+
+        @Override
+        public void onServiceDisconnected(ComponentName name) {
+            mHandler.post(() -> mCameraLightOutbound = null);
+        }
+    };
+
+    private final class CameraLightHandler extends Handler {
+        CameraLightHandler(Looper looper) {
+            super(looper, null, true /*async*/);
+        }
+
+        @Override
+        public void handleMessage(Message msg) {
+            if (msg.what == MSG_CAMERA_LIGHT_LUX && mLightSensorEnabled) {
+                final float lux = Float.intBitsToFloat(msg.arg1);
+                if (!Float.isNaN(lux) && lux >= 0f) {
+                    handleLightSensorEvent(mClock.getSensorEventScaleTime(), lux);
+                }
+            }
+        }
+    }
+
     private final SensorEventListener mLightSensorListener = new SensorEventListener() {
         @Override
         public void onSensorChanged(SensorEvent event) {
