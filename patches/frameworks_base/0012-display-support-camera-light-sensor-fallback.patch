+                mSensorManager.unregisterListener(mLightSensorListener);
+            } else if (mCameraLightComponent != null) {
+                setCameraLightEnabled(false);
+            }
         }
         mAutoBrightnessOneShot = autoBrightnessOneShot;
     }
