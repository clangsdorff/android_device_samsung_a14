 import android.util.IndentingPrintWriter;
 import android.util.MathUtils;
@@ -114,6 +120,10 @@ public class AutomaticBrightnessController {
     private static final int MSG_RUN_UPDATE = 6;
     private static final int MSG_INVALIDATE_PAUSED_SHORT_TERM_MODEL = 7;
 
+    private static final int MSG_CAMERA_LIGHT_START = 1;
+    private static final int MSG_CAMERA_LIGHT_STOP = 2;
