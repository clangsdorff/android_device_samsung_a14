 core/res/res/drawable/ic_rom_dexopt.xml       |  11 ++
 core/res/res/values-tr/rom_strings.xml        |  12 ++
 core/res/res/values/rom_strings.xml           |  19 +++
 proto/src/system_messages.proto               |   4 +
 .../com/android/server/pm/DexOptHelper.java   |   1 +
 .../android/server/pm/RomDexoptRunner.java    | 161 ++++++++++++++++++
 7 files changed, 212 insertions(+)
 create mode 100644 core/res/res/drawable/ic_rom_dexopt.xml
 create mode 100644 core/res/res/values-tr/rom_strings.xml
 create mode 100644 core/res/res/values/rom_strings.xml
 create mode 100644 services/core/java/com/android/server/pm/RomDexoptRunner.java

