diff --git a/services/core/java/com/android/server/pm/RomDexoptRunner.java b/services/core/java/com/android/server/pm/RomDexoptRunner.java
new file mode 100644
index 0000000..f429785
--- /dev/null
+++ b/services/core/java/com/android/server/pm/RomDexoptRunner.java
@@ -0,0 +1,161 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Langsdorff
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.server.pm;
+
+import android.annotation.NonNull;
+import android.app.Notification;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.util.Slog;
+
+import com.android.internal.R;
+import com.android.internal.messages.nano.SystemMessageProto.SystemMessage;
+import com.android.internal.notification.SystemNotificationChannels;
+import com.android.internal.os.BackgroundThread;
+import com.android.server.art.ArtManagerLocal;
+import com.android.server.art.ReasonMapping;
+import com.android.server.art.model.DexoptResult;
+
+/** Runs the background dexopt job on request and reports it in a notification. */
+final class RomDexoptRunner implements ArtManagerLocal.DexoptDoneCallback {
+    private static final String TAG = "RomDexoptRunner";
+
+    static final String ACTION_START = "com.android.server.pm.action.ROM_DEXOPT_START";
+    static final String ACTION_CANCEL = "com.android.server.pm.action.ROM_DEXOPT_CANCEL";
+
+    private static final int NOTIF_ID = SystemMessage.NOTE_ROM_DEXOPT;
+    // The job reports its main and supplementary passes as separate results.
+    private static final long DONE_WINDOW_MS = 60_000;
+
+    private final Context mContext;
+    private final ArtManagerLocal mArtManager;
+    private final Object mLock = new Object();
+    private boolean mRunning;
+    private boolean mCancelled;
+    private long mDoneAt = -DONE_WINDOW_MS;
+    private int mUpdated;
+
+    private RomDexoptRunner(Context context, ArtManagerLocal artManager) {
+        mContext = context;
+        mArtManager = artManager;
+    }
+
+    static void register(@NonNull Context context, @NonNull ArtManagerLocal artManager) {
+        RomDexoptRunner runner = new RomDexoptRunner(context, artManager);
+        artManager.addDexoptDoneCallback(false /* onlyIncludeUpdates */,
+                BackgroundThread.getExecutor(), runner);
+        IntentFilter filter = new IntentFilter();
+        filter.addAction(ACTION_START);
+        filter.addAction(ACTION_CANCEL);
+        context.registerReceiver(new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context ctx, Intent intent) {
+                if (ACTION_START.equals(intent.getAction())) {
+                    runner.start();
+                } else if (ACTION_CANCEL.equals(intent.getAction())) {
+                    runner.cancel();
+                }
+            }
+        }, filter, null, BackgroundThread.getHandler(), Context.RECEIVER_NOT_EXPORTED);
+    }
+
+    private void start() {
+        synchronized (mLock) {
+            if (mRunning) {
+                return;
+            }
+            mRunning = true;
+            mCancelled = false;
+            mUpdated = 0;
+        }
+        Slog.i(TAG, "starting background dexopt on request");
+        showProgress();
+        mArtManager.startBackgroundDexoptJob();
+    }
+
+    private void cancel() {
+        synchronized (mLock) {
+            if (!mRunning) {
+                return;
+            }
+        }
+        Slog.i(TAG, "cancelling background dexopt on request");
+        mArtManager.cancelBackgroundDexoptJob();
+    }
+
+    @Override
+    public void onDexoptDone(@NonNull DexoptResult result) {
+        if (!ReasonMapping.REASON_BG_DEXOPT.equals(result.getReason())) {
+            return;
+        }
+        int updated;
+        boolean cancelled;
+        synchronized (mLock) {
+            long now = SystemClock.elapsedRealtime();
+            if (!mRunning && now - mDoneAt > DONE_WINDOW_MS) {
+                return;
+            }
+            mRunning = false;
+            mDoneAt = now;
+            for (DexoptResult.PackageDexoptResult pkg : result.getPackageDexoptResults()) {
+                if (pkg.hasUpdatedArtifacts()) {
+                    mUpdated++;
+                }
+            }
+            mCancelled |= result.getFinalStatus() == DexoptResult.DEXOPT_CANCELLED;
+            updated = mUpdated;
+            cancelled = mCancelled;
+        }
+        showDone(updated, cancelled);
+    }
+
+    private Notification.Builder builder() {
+        return new Notification.Builder(mContext, SystemNotificationChannels.SYSTEM_CHANGES)
+                .setSmallIcon(R.drawable.ic_rom_dexopt)
+                .setColor(mContext.getColor(R.color.system_notification_accent_color))
+                .setLocalOnly(true);
+    }
+
+    private void showProgress() {
+        Intent cancel = new Intent(ACTION_CANCEL).setPackage(mContext.getPackageName());
+        PendingIntent pi = PendingIntent.getBroadcast(mContext, 0, cancel,
+                PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
+        Notification n = builder()
+                .setContentTitle(mContext.getString(R.string.rom_dexopt_running_title))
+                .setContentText(mContext.getString(R.string.rom_dexopt_running_text))
+                .setProgress(0, 0, true)
+                .setOngoing(true)
+                .setOnlyAlertOnce(true)
+                .addAction(0, mContext.getString(R.string.cancel), pi)
+                .build();
+        notify(n);
+    }
+
+    private void showDone(int updated, boolean cancelled) {
+        Notification n = builder()
+                .setContentTitle(mContext.getString(cancelled
+                        ? R.string.rom_dexopt_cancelled_title
+                        : R.string.rom_dexopt_done_title))
+                .setContentText(mContext.getString(R.string.rom_dexopt_done_text, updated))
+                .setOnlyAlertOnce(true)
+                .setAutoCancel(true)
+                .build();
+        notify(n);
+    }
+
+    private void notify(Notification n) {
+        NotificationManager nm = mContext.getSystemService(NotificationManager.class);
+        if (nm != null) {
+            nm.notifyAsUser(null, NOTIF_ID, n, UserHandle.ALL);
+        }
+    }
+}
