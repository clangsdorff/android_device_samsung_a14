+package com.android.server.wm;
+
+import android.content.Context;
+import android.database.ContentObserver;
+import android.os.Handler;
+import android.os.UserHandle;
+import android.provider.Settings;
+
+import java.util.HashSet;
+import java.util.Set;
+
+class GameListManager {
+    private static final String GAME_LIST_KEY = "gamespace_game_list";
+
+    private final Context mContext;
+    private final Set<String> mGames = new HashSet<>();
+
+    GameListManager(Context context) {
+        mContext = context;
+    }
+
+    void registerGameListObserver(Handler handler) {
+        mContext.getContentResolver().registerContentObserver(
+                Settings.System.getUriFor(GAME_LIST_KEY), false,
+                new ContentObserver(handler) {
+                    @Override
+                    public void onChange(boolean selfChange) {
+                        loadGameList();
+                    }
+                }, UserHandle.USER_ALL);
+        loadGameList();
+    }
+
+    void loadGameList() {
+        final String raw = Settings.System.getStringForUser(mContext.getContentResolver(),
+                GAME_LIST_KEY, UserHandle.USER_CURRENT);
+        final Set<String> parsed = new HashSet<>();
+        if (raw != null) {
+            for (String entry : raw.split(";")) {
+                final String name = entry.split("=", 2)[0].trim();
+                if (!name.isEmpty()) {
+                    parsed.add(name);
+                }
+            }
+        }
+        synchronized (mGames) {
+            mGames.clear();
+            mGames.addAll(parsed);
+        }
+    }
+
+    boolean isGame(String packageName) {
+        synchronized (mGames) {
+            return mGames.contains(packageName);
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/wm/GameSpaceService.java b/services/core/java/com/android/server/wm/GameSpaceService.java
