+package com.android.server.wm;
+
+import android.app.ActivityManager;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.os.RemoteException;
+import android.os.UserHandle;
+import android.util.Slog;
+
+class GameStateDispatcher {
+    private static final String TAG = "GameStateDispatcher";
+    private static final ComponentName SESSION_SERVICE = new ComponentName(
+            "io.chaldeaprjkt.gamespace", "io.chaldeaprjkt.gamespace.gamebar.SessionService");
+    private static final String ACTION_GAME_START = "game_start";
+    private static final String EXTRA_PACKAGE_NAME = "package_name";
+
+    private final Context mContext;
+
+    GameStateDispatcher(Context context) {
+        mContext = context;
+    }
+
+    void dispatchGameState(boolean active, String packageName) {
+        try {
+            if (active) {
+                final Intent intent = new Intent(ACTION_GAME_START)
+                        .setComponent(SESSION_SERVICE)
+                        .putExtra(EXTRA_PACKAGE_NAME, packageName);
+                if (ActivityManager.getService().startService(null, intent, null, false,
+                        mContext.getOpPackageName(), mContext.getAttributionTag(),
+                        UserHandle.USER_CURRENT) == null) {
+                    Slog.w(TAG, "GameSpace session service not found");
+                }
+            } else {
+                ActivityManager.getService().stopService(null,
+                        new Intent().setComponent(SESSION_SERVICE), null,
+                        UserHandle.USER_CURRENT);
+            }
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "Failed to update GameSpace session", e);
+        }
+    }
+}
