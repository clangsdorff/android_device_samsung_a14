From 5f9a1be76178e279a6f774aa4ef8d490c1786a62 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Fri, 20 Nov 2026 22:05:59 +0000
Subject: [PATCH 5/6] gamespace: avoid crash when panel exceeds available height

When the panel is taller than the screen minus the margin, the upper
bound passed to coerceIn goes negative and throws
IllegalArgumentException. Clamp the upper bound to zero.
---
 app/src/main/java/io/chaldeaprjkt/gamespace/widget/PanelView.kt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/app/src/main/java/io/chaldeaprjkt/gamespace/widget/PanelView.kt b/app/src/main/java/io/chaldeaprjkt/gamespace/widget/PanelView.kt
index 67a0656..d574a65 100644
--- a/app/src/main/java/io/chaldeaprjkt/gamespace/widget/PanelView.kt
+++ b/app/src/main/java/io/chaldeaprjkt/gamespace/widget/PanelView.kt
@@ -53,7 +53,7 @@ class PanelView @JvmOverloads constructor(
             val params = layoutParams as ViewGroup.MarginLayoutParams
             
             // Ensure the panel doesn't go off-screen
-            val maxMargin = screenHeight - panelHeight - 16.dp
+            val maxMargin = (screenHeight - panelHeight - 16.dp).coerceAtLeast(0)
             val adjustedMargin = targetMargin.coerceIn(0, maxMargin)
             
             val animator = ValueAnimator.ofInt(params.topMargin, adjustedMargin)
-- 
2.43.0

