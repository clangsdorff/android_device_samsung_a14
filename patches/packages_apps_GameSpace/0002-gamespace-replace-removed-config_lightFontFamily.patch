From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Wed, 18 Nov 2026 14:53:00 +0300
Subject: [PATCH 2/6] gamespace: replace removed config_lightFontFamily

android:string/config_lightFontFamily was removed from framework-res in
Android 17. Use sans-serif-light directly in panel_view.xml.

---
 app/src/main/res/layout/panel_view.xml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/app/src/main/res/layout/panel_view.xml b/app/src/main/res/layout/panel_view.xml
index 0000000..1111111 100644
--- a/app/src/main/res/layout/panel_view.xml
+++ b/app/src/main/res/layout/panel_view.xml
@@ -45,7 +45,7 @@
                     android:layout_height="wrap_content"
                     android:layout_marginHorizontal="4dp"
                     android:layout_alignParentStart="true" 
-                    android:fontFamily="@*android:string/config_lightFontFamily"
+                    android:fontFamily="sans-serif-light"
                     android:gravity="start|center_vertical"
                     android:text="@string/settings_title"
                     android:textSize="24sp" />
@@ -57,7 +57,7 @@
                     android:layout_height="wrap_content"
                     android:layout_marginHorizontal="4dp"
                     android:layout_alignParentEnd="true" 
                     android:layout_toEndOf="@id/title_view"
-                    android:fontFamily="@*android:string/config_lightFontFamily"
+                    android:fontFamily="sans-serif-light"
                     android:gravity="end|center_vertical"
                     android:format12Hour="h:mm"
                     android:format24Hour="kk:mm"
