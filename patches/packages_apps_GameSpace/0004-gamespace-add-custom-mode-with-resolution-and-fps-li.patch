             PREF_USE_ANGLE -> {
                 val newModes = GameConfig.ModeBuilder.apply {
                     useAngle = newValue as Boolean
@@ -122,8 +145,69 @@ class PerAppSettingsFragment : Hilt_PerAppSettingsFragment(),
         return false
     }
 
+    private fun setupCustomPreferences() {
+        val info = currentGame?.packageName?.let { gameManager?.getGameModeInfo(it) }
+        val config = customConfig
+        findPreference<ListPreference>(PREF_RESOLUTION)?.apply {
+            val scaling = config?.scalingFactor?.takeIf { it > 0f } ?: 1f
+            value = "%.1f".format(java.util.Locale.ROOT, (scaling * 10).roundToInt() / 10f)
+            if (info?.isDownscalingAllowed == false) {
+                isEnabled = false
+                summary = context.getString(R.string.per_app_custom_unsupported)
+            }
+            onPreferenceChangeListener = this@PerAppSettingsFragment
+        }
+        findPreference<ListPreference>(PREF_FPS)?.apply {
+            val rates = supportedFrameRates()
+            entries = (listOf(context.getString(R.string.per_app_fps_none)) +
+                    rates.map { context.getString(R.string.per_app_fps_value, it) }).toTypedArray()
+            entryValues = (listOf(GameModeConfiguration.FPS_OVERRIDE_NONE) + rates)
+                .map { it.toString() }.toTypedArray()
+            val fps = config?.fpsOverride ?: GameModeConfiguration.FPS_OVERRIDE_NONE
+            value = (if (fps in rates) fps else GameModeConfiguration.FPS_OVERRIDE_NONE).toString()
+            if (info?.isFpsOverrideAllowed == false) {
+                isEnabled = false
+                summary = context.getString(R.string.per_app_custom_unsupported)
+            }
+            onPreferenceChangeListener = this@PerAppSettingsFragment
+        }
+    }
+
+    private fun updateCustomVisibility(mode: Int) {
+        val custom = mode == GameManager.GAME_MODE_CUSTOM
+        findPreference<Preference>(PREF_RESOLUTION)?.isVisible = custom
+        findPreference<Preference>(PREF_FPS)?.isVisible = custom
+    }
+
+    private fun supportedFrameRates(): List<Int> {
+        val display = context?.getSystemService(DisplayManager::class.java)
+            ?.getDisplay(Display.DEFAULT_DISPLAY) ?: return emptyList()
+        return display.supportedModes
+            .map { it.refreshRate.roundToInt() }
+            .flatMap { hz -> (1..hz / 30).map { hz / it }.filter { hz % it == 0 && it >= 30 } }
+            .distinct()
+            .sortedDescending()
+    }
+
+    private fun updateCustomConfig(
+        packageName: String,
+        scaling: Float? = null,
+        fps: Int? = null,
+    ): Boolean {
+        val manager = gameManager ?: return false
+        val current = customConfig
+        val config = GameModeConfiguration.Builder()
+            .setScalingFactor(scaling ?: current?.scalingFactor?.takeIf { it >= 0.1f } ?: 1f)
+            .setFpsOverride(fps ?: current?.fpsOverride ?: GameModeConfiguration.FPS_OVERRIDE_NONE)
+            .build()
+        return runCatching { manager.updateCustomGameModeConfiguration(packageName, config) }
+            .isSuccess
+    }
+
     companion object {
         const val PREF_PREFERRED_MODE = "per_app_preferred_mode"
+        const val PREF_RESOLUTION = "per_app_resolution"
+        const val PREF_FPS = "per_app_fps"
         const val PREF_USE_ANGLE = "per_app_use_angle"
         const val PREF_UNREGISTER = "per_app_unregister"
     }
