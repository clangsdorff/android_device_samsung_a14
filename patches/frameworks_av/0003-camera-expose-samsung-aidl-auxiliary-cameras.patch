From 6037a81739c577780d388aec08c3b734bbe5f62c Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sat, 7 Nov 2026 14:07:42 +0000
Subject: [PATCH] camera: expose samsung aidl auxiliary cameras

samsung aidl camera providers only return cameras with id below 20 on
the standard ICameraProvider::getCameraIdList() call. auxiliary sensors
such as macro (id 54) are only returned by the vendor binder extension
ISehCameraProvider::getCameraIdListAll().

query the vendor extension binder via AIBinder_getExtension and call
getCameraIdListAll() if present. also treat auxiliary cameras as public
so camera applications without system privileges can access macro mode.
---
 .../common/CameraProviderManager.cpp           |  8 --------
 .../common/aidl/AidlProviderInfo.cpp           | 18 ++++++++++++++++++
 2 files changed, 18 insertions(+), 8 deletions(-)

diff --git a/services/camera/libcameraservice/common/CameraProviderManager.cpp b/services/camera/libcameraservice/common/CameraProviderManager.cpp
index 019934c1e2..a78038846a 100644
--- a/services/camera/libcameraservice/common/CameraProviderManager.cpp
+++ b/services/camera/libcameraservice/common/CameraProviderManager.cpp
@@ -1133,14 +1133,6 @@ SystemCameraKind CameraProviderManager::ProviderInfo::DeviceInfo3::getSystemCame
         return SystemCameraKind::HIDDEN_SECURE_CAMERA;
     }
 
-    // Go through the capabilities and check if it has
-    // ANDROID_REQUEST_AVAILABLE_CAPABILITIES_SYSTEM_CAMERA
-    for (size_t i = 0; i < entryCap.count; ++i) {
-        uint8_t capability = entryCap.data.u8[i];
-        if (capability == ANDROID_REQUEST_AVAILABLE_CAPABILITIES_SYSTEM_CAMERA) {
-            return SystemCameraKind::SYSTEM_ONLY_CAMERA;
-        }
-    }
     return SystemCameraKind::PUBLIC;
 }
 
diff --git a/services/camera/libcameraservice/common/aidl/AidlProviderInfo.cpp b/services/camera/libcameraservice/common/aidl/AidlProviderInfo.cpp
index 4c19ccf20e..551f6c75a7 100644
--- a/services/camera/libcameraservice/common/aidl/AidlProviderInfo.cpp
+++ b/services/camera/libcameraservice/common/aidl/AidlProviderInfo.cpp
@@ -33,6 +33,8 @@
 #include <utils/AttributionAndPermissionUtils.h>
 #include <utils/SessionConfigurationUtils.h>
 #include <utils/Trace.h>
+#include <android/binder_libbinder.h>
+#include <binder/Parcel.h>
 
 namespace {
 const bool kEnableLazyHal(property_get_bool("ro.camera.enableLazyHal", false));
@@ -176,6 +178,22 @@ status_t AidlProviderInfo::initializeAidlProvider(
         return mapToStatusT(status);
     }
 
+    AIBinder *ext = nullptr;
+    if (AIBinder_getExtension(interface->asBinder().get(), &ext) == STATUS_OK && ext != nullptr) {
+        sp<IBinder> extBinder = AIBinder_toPlatformBinder(ext);
+        if (extBinder != nullptr) {
+            Parcel data, reply;
+            data.writeInterfaceToken(String16("vendor.samsung.hardware.camera.provider.ISehCameraProvider"));
+            status_t transactStatus = extBinder->transact(IBinder::FIRST_CALL_TRANSACTION, data, &reply);
+            if (transactStatus == OK && reply.readExceptionCode() == 0) {
+                std::vector<std::string> allDevices;
+                if (reply.readUtf8StringVector(&allDevices) == OK && !allDevices.empty()) {
+                    retDevices = std::move(allDevices);
+                }
+            }
+        }
+    }
+
     for (auto& name : retDevices) {
         uint16_t major, minor;
         std::string type, id;
-- 
