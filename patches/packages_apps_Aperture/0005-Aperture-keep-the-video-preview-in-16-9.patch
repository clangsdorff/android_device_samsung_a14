From da18d7a69192bbb0bc3b719de185e49ef06e8e16 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sun, 4 Oct 2026 23:18:26 +0300
Subject: [PATCH 5/6] Aperture: keep the video preview in 16:9

camerax defaults the preview stream to 4:3 even in video mode. samsung
hals only have 60fps sensor modes in 16:9 and fail or cap to 30fps when
a 4:3 preview stream is bound alongside a 16:9 video recorder, so
request a 16:9 preview resolution in video mode.
---
 .../main/java/org/lineageos/aperture/CameraActivity.kt | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/app/src/main/java/org/lineageos/aperture/CameraActivity.kt b/app/src/main/java/org/lineageos/aperture/CameraActivity.kt
index 1c343ab81401..bc17c1381df6 100644
--- a/app/src/main/java/org/lineageos/aperture/CameraActivity.kt
+++ b/app/src/main/java/org/lineageos/aperture/CameraActivity.kt
@@ -1536,6 +1536,8 @@ open class CameraActivity : AppCompatActivity(R.layout.activity_camera) {
             }) not supported by camera ${cameraConfiguration.camera.cameraId}"
         }
 
+        viewModel.cameraController.previewResolutionSelector = null
+
         // Initialize the use case we want and set its properties
         val cameraUseCases = when (cameraConfiguration) {
             is CameraConfiguration.Photo -> {
@@ -1622,6 +1624,14 @@ open class CameraActivity : AppCompatActivity(R.layout.activity_camera) {
                 viewModel.cameraController.videoCaptureQualitySelector =
                     QualitySelector.from(cameraConfiguration.videoQuality)
 
+                // Some HALs have no 4:3 sensor mode above 30fps
+                viewModel.cameraController.previewResolutionSelector =
+                    ResolutionSelector.Builder()
+                        .setAspectRatioStrategy(
+                            AspectRatioStrategy.RATIO_16_9_FALLBACK_AUTO_STRATEGY
+                        )
+                        .build()
+
                 // Set the dynamic range
                 viewModel.cameraController.videoCaptureDynamicRange =
                     cameraConfiguration.videoDynamicRange.dynamicRange
-- 
