+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    SPDX-FileCopyrightText: 2026 Langsdorff
+    SPDX-License-Identifier: Apache-2.0
+-->
+<PreferenceScreen
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:key="rom_settings_screen"
+    android:title="@string/rom_settings_title">
+
+    <SwitchPreferenceCompat
+        android:key="window_ignore_secure"
+        android:title="@string/rom_settings_ignore_secure_title"
+        android:summary="@string/rom_settings_ignore_secure_summary"
+        android:persistent="false" />
+
+    <ListPreference
+        android:key="rom_sound_pack"
+        android:title="@string/rom_settings_sound_pack_title"
+        android:summary="%s"
+        android:entries="@array/rom_settings_sound_pack_entries"
+        android:entryValues="@array/rom_settings_sound_pack_values"
+        android:persistent="false" />
+</PreferenceScreen>
