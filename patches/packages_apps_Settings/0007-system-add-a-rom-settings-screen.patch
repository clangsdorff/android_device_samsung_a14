diff --git a/src/com/android/settings/system/RomSettingsFragment.java b/src/com/android/settings/system/RomSettingsFragment.java
new file mode 100644
index 0000000..aaaf5a7
--- /dev/null
+++ b/src/com/android/settings/system/RomSettingsFragment.java
@@ -0,0 +1,168 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Langsdorff
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.system;
+
+import android.app.Activity;
+import android.app.settings.SettingsEnums;
+import android.content.ContentResolver;
+import android.content.ContentUris;
+import android.content.Context;
+import android.database.Cursor;
+import android.media.RingtoneManager;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.SystemProperties;
+import android.provider.MediaStore;
+import android.provider.Settings;
+import android.util.Log;
+import android.widget.Toast;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.dashboard.DashboardFragment;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+@SearchIndexable
+public class RomSettingsFragment extends DashboardFragment
+        implements Preference.OnPreferenceChangeListener {
+    private static final String TAG = "RomSettings";
+    private static final String KEY_IGNORE_SECURE = "window_ignore_secure";
+    private static final String KEY_SOUND_PACK = "rom_sound_pack";
+    private static final String PACK_LINEAGE = "lineage";
+    private static final String PACK_SAMSUNG = "samsung";
+
+    private static final String UI_LINEAGE = "/product/media/audio/ui/";
+    private static final String UI_SAMSUNG = "/product/media/audio/ui_samsung/";
+    private static final String[][] UI_SOUNDS = {
+            {Settings.Global.LOCK_SOUND, "Lock.ogg"},
+            {Settings.Global.UNLOCK_SOUND, "Unlock.ogg"},
+            {Settings.Global.CHARGING_STARTED_SOUND, "ChargingStarted.ogg"},
+            {Settings.Global.WIRELESS_CHARGING_STARTED_SOUND, "WirelessChargingStarted.ogg"},
+            {Settings.Global.LOW_BATTERY_SOUND, "LowBattery.ogg"},
+    };
+
+    private final ExecutorService mExecutor = Executors.newSingleThreadExecutor();
+    private SwitchPreferenceCompat mIgnoreSecure;
+    private ListPreference mSoundPack;
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.SETTINGS_SYSTEM_CATEGORY;
+    }
+
+    @Override
+    protected String getLogTag() {
+        return TAG;
+    }
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        return R.xml.rom_settings;
+    }
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        super.onCreatePreferences(savedInstanceState, rootKey);
+        ContentResolver cr = getContentResolver();
+        mIgnoreSecure = findPreference(KEY_IGNORE_SECURE);
+        if (mIgnoreSecure != null) {
+            mIgnoreSecure.setChecked(Settings.Secure.getInt(cr, KEY_IGNORE_SECURE, 0) != 0);
+            mIgnoreSecure.setOnPreferenceChangeListener(this);
+        }
+        mSoundPack = findPreference(KEY_SOUND_PACK);
+        if (mSoundPack != null) {
+            String pack = Settings.Secure.getString(cr, KEY_SOUND_PACK);
+            mSoundPack.setValue(PACK_SAMSUNG.equals(pack) ? PACK_SAMSUNG : PACK_LINEAGE);
+            mSoundPack.setOnPreferenceChangeListener(this);
+        }
+    }
+
+    @Override
+    public void onDestroy() {
+        super.onDestroy();
+        mExecutor.shutdown();
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        ContentResolver cr = getContentResolver();
+        if (preference == mIgnoreSecure) {
+            Settings.Secure.putInt(cr, KEY_IGNORE_SECURE, Boolean.TRUE.equals(newValue) ? 1 : 0);
+            return true;
+        }
+        if (preference == mSoundPack) {
+            final String pack = (String) newValue;
+            if (pack.equals(mSoundPack.getValue())) {
+                return true;
+            }
+            Settings.Secure.putString(cr, KEY_SOUND_PACK, pack);
+            final Context appContext = getContext().getApplicationContext();
+            mExecutor.execute(() -> applySoundPack(appContext, PACK_SAMSUNG.equals(pack)));
+            return true;
+        }
+        return false;
+    }
+
+    private void applySoundPack(Context ctx, boolean samsung) {
+        setDefault(ctx, RingtoneManager.TYPE_RINGTONE, MediaStore.Audio.AudioColumns.IS_RINGTONE,
+                samsung ? "Galaxy_Bells.ogg" : SystemProperties.get("ro.config.ringtone"));
+        setDefault(ctx, RingtoneManager.TYPE_NOTIFICATION,
+                MediaStore.Audio.AudioColumns.IS_NOTIFICATION,
+                samsung ? "Spaceline.ogg" : SystemProperties.get("ro.config.notification_sound"));
+        setDefault(ctx, RingtoneManager.TYPE_ALARM, MediaStore.Audio.AudioColumns.IS_ALARM,
+                samsung ? "Homecoming.ogg" : SystemProperties.get("ro.config.alarm_alert"));
+
+        ContentResolver cr = ctx.getContentResolver();
+        String dir = samsung ? UI_SAMSUNG : UI_LINEAGE;
+        for (String[] s : UI_SOUNDS) {
+            Settings.Global.putString(cr, s[0], dir + s[1]);
+        }
+        postOnUi(() -> {
+            Context c = getContext();
+            if (c != null) {
+                Toast.makeText(c, R.string.rom_settings_sound_pack_applied,
+                        Toast.LENGTH_SHORT).show();
+            }
+        });
+    }
+
+    private static void setDefault(Context ctx, int type, String typeColumn, String fileName) {
+        if (fileName == null || fileName.isEmpty()) {
+            return;
+        }
+        Uri base = MediaStore.Audio.Media.INTERNAL_CONTENT_URI;
+        try (Cursor c = ctx.getContentResolver().query(base,
+                new String[] {MediaStore.Audio.Media._ID},
+                typeColumn + "=1 AND " + MediaStore.Audio.Media.DISPLAY_NAME + "=?",
+                new String[] {fileName}, null)) {
+            if (c == null || !c.moveToFirst()) {
+                Log.w(TAG, "no internal media for " + fileName);
+                return;
+            }
+            RingtoneManager.setActualDefaultRingtoneUri(ctx, type,
+                    ContentUris.withAppendedId(base, c.getLong(0)));
+        } catch (RuntimeException e) {
+            Log.w(TAG, "failed to set default for " + fileName, e);
+        }
+    }
+
+    private void postOnUi(Runnable r) {
+        Activity act = getActivity();
+        if (act != null && !act.isFinishing() && !act.isDestroyed()) {
+            act.runOnUiThread(r);
+        }
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.rom_settings);
+}
