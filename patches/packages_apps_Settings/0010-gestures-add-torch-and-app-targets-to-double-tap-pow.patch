@@ -0,0 +1,190 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Langsdorff
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.gestures;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.database.ContentObserver;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.TextUtils;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.appcompat.app.AlertDialog;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settingslib.core.lifecycle.LifecycleObserver;
+import com.android.settingslib.core.lifecycle.events.OnStart;
+import com.android.settingslib.core.lifecycle.events.OnStop;
+import com.android.settingslib.widget.SelectorWithWidgetPreference;
+
+import java.text.Collator;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+/** Torch and app targets of the double tap power button gesture. */
+public class DoubleTapPowerForExtraActionPreferenceController extends BasePreferenceController
+        implements LifecycleObserver, OnStart, OnStop {
+
+    private static final String KEY_TORCH = "gesture_double_power_tap_torch";
+
+    private final int mAction;
+    @Nullable private SelectorWithWidgetPreference mPreference;
+
+    private final ContentObserver mSettingsObserver =
+            new ContentObserver(new Handler(Looper.getMainLooper())) {
+                @Override
+                public void onChange(boolean selfChange, @Nullable Uri uri) {
+                    if (mPreference != null) {
+                        updateState(mPreference);
+                    }
+                }
+            };
+
+    public DoubleTapPowerForExtraActionPreferenceController(
+            @NonNull Context context, @NonNull String preferenceKey) {
+        super(context, preferenceKey);
+        mAction = KEY_TORCH.equals(preferenceKey)
+                ? DoubleTapPowerSettingsUtils.DOUBLE_TAP_POWER_BUTTON_TORCH_VALUE
+                : DoubleTapPowerSettingsUtils.DOUBLE_TAP_POWER_BUTTON_APP_LAUNCH_VALUE;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        if (!DoubleTapPowerSettingsUtils
+                .isMultiTargetDoubleTapPowerButtonGestureAvailable(mContext)) {
+            return UNSUPPORTED_ON_DEVICE;
+        }
+        if (mAction == DoubleTapPowerSettingsUtils.DOUBLE_TAP_POWER_BUTTON_TORCH_VALUE
+                && !mContext.getPackageManager()
+                        .hasSystemFeature(PackageManager.FEATURE_CAMERA_FLASH)) {
+            return UNSUPPORTED_ON_DEVICE;
+        }
+        return DoubleTapPowerSettingsUtils.isDoubleTapPowerButtonGestureEnabled(mContext)
+                ? AVAILABLE
+                : DISABLED_DEPENDENT_SETTING;
+    }
+
+    @Override
+    public void displayPreference(@NonNull PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPreference = screen.findPreference(getPreferenceKey());
+        if (mPreference != null && isAppAction()) {
+            mPreference.setExtraWidgetOnClickListener(v -> showAppPicker());
+        }
+    }
+
+    @Override
+    public void updateState(@NonNull Preference preference) {
+        super.updateState(preference);
+        preference.setEnabled(
+                DoubleTapPowerSettingsUtils.isDoubleTapPowerButtonGestureEnabled(mContext));
+        if (preference instanceof SelectorWithWidgetPreference) {
+            ((SelectorWithWidgetPreference) preference).setChecked(
+                    DoubleTapPowerSettingsUtils.getDoubleTapPowerButtonTargetAction(mContext)
+                            == mAction);
+        }
+        if (isAppAction()) {
+            CharSequence label = getAppLabel(mContext);
+            preference.setSummary(label != null
+                    ? label : mContext.getText(R.string.double_tap_power_app_action_none));
+        }
+    }
+
+    @Override
+    public boolean handlePreferenceTreeClick(@NonNull Preference preference) {
+        if (!getPreferenceKey().equals(preference.getKey())) {
+            return false;
+        }
+        if (isAppAction() && getAppLabel(mContext) == null) {
+            showAppPicker();
+            return true;
+        }
+        DoubleTapPowerSettingsUtils.setDoubleTapPowerButtonTargetAction(mContext, mAction);
+        return true;
+    }
+
+    @Override
+    public void onStart() {
+        DoubleTapPowerSettingsUtils.registerObserver(mContext, mSettingsObserver);
+    }
+
+    @Override
+    public void onStop() {
+        DoubleTapPowerSettingsUtils.unregisterObserver(mContext, mSettingsObserver);
+    }
+
+    private boolean isAppAction() {
+        return mAction == DoubleTapPowerSettingsUtils.DOUBLE_TAP_POWER_BUTTON_APP_LAUNCH_VALUE;
+    }
+
+    private void showAppPicker() {
+        if (mPreference == null) {
+            return;
+        }
+        final Context context = mPreference.getContext();
+        final PackageManager pm = context.getPackageManager();
+        final Intent launcher =
+                new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER);
+        final List<ResolveInfo> apps = new ArrayList<>();
+        final List<String> seen = new ArrayList<>();
+        for (ResolveInfo info : pm.queryIntentActivities(launcher, 0)) {
+            if (!seen.contains(info.activityInfo.packageName)) {
+                seen.add(info.activityInfo.packageName);
+                apps.add(info);
+            }
+        }
+        final Collator collator = Collator.getInstance();
+        apps.sort(Comparator.comparing(i -> i.loadLabel(pm).toString(), collator));
+        final CharSequence[] labels = new CharSequence[apps.size()];
+        for (int i = 0; i < labels.length; i++) {
+            labels[i] = apps.get(i).loadLabel(pm);
+        }
+        new AlertDialog.Builder(context)
+                .setTitle(R.string.double_tap_power_app_action_picker_title)
+                .setItems(labels, (dialog, which) -> {
+                    DoubleTapPowerSettingsUtils.setDoubleTapPowerButtonApp(
+                            mContext, apps.get(which).activityInfo.packageName);
+                    DoubleTapPowerSettingsUtils.setDoubleTapPowerButtonTargetAction(
+                            mContext, mAction);
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    @Nullable
+    private static CharSequence getAppLabel(@NonNull Context context) {
+        final String packageName = DoubleTapPowerSettingsUtils.getDoubleTapPowerButtonApp(context);
+        if (TextUtils.isEmpty(packageName)) {
+            return null;
+        }
+        try {
+            final PackageManager pm = context.getPackageManager();
+            final ApplicationInfo info = pm.getApplicationInfo(packageName, 0);
+            return pm.getApplicationLabel(info);
+        } catch (PackageManager.NameNotFoundException e) {
+            return null;
+        }
+    }
+
+    /** Summary of the app target for the gestures list. */
+    @NonNull
+    static CharSequence getAppSummary(@NonNull Context context) {
+        final CharSequence label = getAppLabel(context);
+        return label != null
+                ? context.getString(R.string.double_tap_power_app_action_summary, label)
+                : context.getText(R.string.double_tap_power_app_action_none);
+    }
+}
