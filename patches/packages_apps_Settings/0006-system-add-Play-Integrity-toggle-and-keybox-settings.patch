diff --git a/src/com/android/settings/system/PlayIntegritySettingsFragment.java b/src/com/android/settings/system/PlayIntegritySettingsFragment.java
new file mode 100644
index 00000000000..10fa895cf04
--- /dev/null
+++ b/src/com/android/settings/system/PlayIntegritySettingsFragment.java
@@ -0,0 +1,345 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Langsdorff
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.system;
+
+import android.app.Activity;
+import android.app.ActivityManager;
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.RemoteException;
+import android.text.format.DateFormat;
+import android.util.Log;
+import android.widget.Toast;
+
+import androidx.annotation.Nullable;
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.dashboard.DashboardFragment;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.Date;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+@SearchIndexable
+public class PlayIntegritySettingsFragment extends DashboardFragment {
+    private static final String TAG = "PlayIntegritySettings";
+    private static final String KEY_PIF_ENABLED = "pif_enabled";
+    private static final String KEY_PIF_PROFILE = "pif_profile";
+    private static final String KEY_KEYBOX_INSTALL = "keybox_install";
+    private static final String KEY_KEYBOX_REMOVE = "keybox_remove";
+    private static final int REQ_PICK_KEYBOX = 9101;
+    private static final int MAX_KEYBOX_BYTES = 256 * 1024;
+
+    private final ExecutorService mExecutor = Executors.newSingleThreadExecutor();
+    private SwitchPreferenceCompat mPifToggle;
+    private Preference mPifProfilePref;
+    private Preference mKeyboxInstallPref;
+    private Preference mKeyboxRemovePref;
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.SETTINGS_SYSTEM_CATEGORY;
+    }
+
+    @Override
+    protected String getLogTag() {
+        return TAG;
+    }
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        return R.xml.play_integrity_settings;
+    }
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        super.onCreatePreferences(savedInstanceState, rootKey);
+        mPifToggle = findPreference(KEY_PIF_ENABLED);
+        mPifProfilePref = findPreference(KEY_PIF_PROFILE);
+        mKeyboxInstallPref = findPreference(KEY_KEYBOX_INSTALL);
+        mKeyboxRemovePref = findPreference(KEY_KEYBOX_REMOVE);
+
+        if (mPifToggle != null) {
+            mPifToggle.setOnPreferenceChangeListener((pref, newVal) -> {
+                boolean enabled = Boolean.TRUE.equals(newVal);
+                mExecutor.execute(() -> {
+                    try {
+                        ActivityManager.getService().setPifEnabled(enabled);
+                    } catch (RemoteException e) {
+                        Log.w(TAG, "setPifEnabled failed", e);
+                    }
+                    refreshStateAsync();
+                });
+                return true;
+            });
+        }
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        refreshStateAsync();
+    }
+
+    @Override
+    public void onDestroy() {
+        super.onDestroy();
+        mExecutor.shutdownNow();
+    }
+
+    @Override
+    public boolean onPreferenceTreeClick(Preference preference) {
+        String key = preference.getKey();
+        if (KEY_PIF_PROFILE.equals(key)) {
+            if (mPifProfilePref != null) {
+                mPifProfilePref.setSummary(R.string.play_integrity_pif_updating);
+                mPifProfilePref.setEnabled(false);
+            }
+            mExecutor.execute(() -> {
+                boolean ok = false;
+                try {
+                    ok = ActivityManager.getService().refreshPifProfile();
+                } catch (RemoteException e) {
+                    Log.w(TAG, "refreshPifProfile failed", e);
+                }
+                final boolean success = ok;
+                postOnUi(() -> {
+                    Context ctx = getContext();
+                    if (ctx != null) {
+                        Toast.makeText(ctx,
+                                success ? R.string.play_integrity_pif_updated
+                                        : R.string.play_integrity_pif_update_failed,
+                                Toast.LENGTH_SHORT).show();
+                    }
+                    if (mPifProfilePref != null) {
+                        mPifProfilePref.setEnabled(true);
+                    }
+                });
+                refreshStateAsync();
+            });
+            return true;
+        }
+        if (KEY_KEYBOX_INSTALL.equals(key)) {
+            Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+            intent.addCategory(Intent.CATEGORY_OPENABLE);
+            intent.setType("*/*");
+            startActivityForResult(intent, REQ_PICK_KEYBOX);
+            return true;
+        }
+        if (KEY_KEYBOX_REMOVE.equals(key)) {
+            mExecutor.execute(() -> {
+                int res = -1;
+                try {
+                    res = ActivityManager.getService().setKeyboxXml("");
+                } catch (RemoteException e) {
+                    Log.w(TAG, "remove keybox failed", e);
+                }
+                final boolean removed = (res == 0);
+                postOnUi(() -> {
+                    Context ctx = getContext();
+                    if (ctx != null && removed) {
+                        Toast.makeText(ctx, R.string.play_integrity_keybox_removed,
+                                Toast.LENGTH_SHORT).show();
+                    }
+                });
+                refreshStateAsync();
+            });
+            return true;
+        }
+        return super.onPreferenceTreeClick(preference);
+    }
+
+    @Override
+    public void onActivityResult(int requestCode, int resultCode, @Nullable Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode != REQ_PICK_KEYBOX || resultCode != Activity.RESULT_OK || data == null) {
+            return;
+        }
+        final Uri uri = data.getData();
+        if (uri == null) {
+            return;
+        }
+        mExecutor.execute(() -> installKeyboxFromUri(uri));
+    }
+
+    private void installKeyboxFromUri(Uri uri) {
+        Context ctx = getContext();
+        if (ctx == null) {
+            return;
+        }
+        final byte[] bytes;
+        try (InputStream is = ctx.getContentResolver().openInputStream(uri);
+             ByteArrayOutputStream baos = new ByteArrayOutputStream()) {
+            if (is == null) {
+                showToast(R.string.play_integrity_keybox_invalid);
+                return;
+            }
+            byte[] buf = new byte[4096];
+            int total = 0;
+            int n;
+            while ((n = is.read(buf)) >= 0) {
+                total += n;
+                if (total > MAX_KEYBOX_BYTES) {
+                    showToast(R.string.play_integrity_keybox_too_large);
+                    return;
+                }
+                baos.write(buf, 0, n);
+            }
+            bytes = baos.toByteArray();
+        } catch (IOException e) {
+            Log.w(TAG, "failed reading selected keybox", e);
+            showToast(R.string.play_integrity_keybox_invalid);
+            return;
+        }
+
+        String xml = new String(bytes, StandardCharsets.UTF_8);
+        int status = -1;
+        try {
+            status = ActivityManager.getService().setKeyboxXml(xml);
+        } catch (RemoteException e) {
+            Log.w(TAG, "setKeyboxXml failed", e);
+        }
+        showToast(status > 0 ? R.string.play_integrity_keybox_installed
+                : R.string.play_integrity_keybox_invalid);
+        refreshStateAsync();
+    }
+
+    private void refreshStateAsync() {
+        mExecutor.execute(() -> {
+            String[] pifStatus = null;
+            String[] kbDetails = null;
+            try {
+                pifStatus = ActivityManager.getService().getPifStatus();
+                kbDetails = ActivityManager.getService().getKeyboxDetails(true);
+            } catch (RemoteException e) {
+                Log.w(TAG, "refreshStateAsync failed", e);
+            }
+            final String[] pif = pifStatus;
+            final String[] kb = kbDetails;
+            postOnUi(() -> updateUi(pif, kb));
+        });
+    }
+
+    private void updateUi(@Nullable String[] pif, @Nullable String[] kbDetails) {
+        Context ctx = getContext();
+        if (ctx == null) {
+            return;
+        }
+        boolean enabled = pif != null && pif.length >= 9 && "1".equals(pif[0]);
+        if (mPifToggle != null) {
+            mPifToggle.setChecked(enabled);
+        }
+        if (mPifProfilePref != null) {
+            if (!enabled) {
+                mPifProfilePref.setSummary(R.string.play_integrity_pif_disabled);
+            } else if (pif != null && pif.length >= 9) {
+                String model = pif[1];
+                String id = pif[3];
+                String patch = pif[6];
+                long fetchedAt = 0L;
+                try {
+                    fetchedAt = Long.parseLong(pif[8]);
+                } catch (NumberFormatException ignored) {
+                }
+                StringBuilder sb = new StringBuilder();
+                sb.append(model).append(" (").append(id).append(") - ").append(patch);
+                if (fetchedAt > 0L) {
+                    sb.append('\n')
+                            .append(DateFormat.getDateFormat(ctx).format(new Date(fetchedAt)));
+                }
+                sb.append('\n').append(ctx.getString(R.string.play_integrity_pif_refresh_hint));
+                mPifProfilePref.setSummary(sb.toString());
+            }
+        }
+
+        int kbMask = 0;
+        if (kbDetails != null && kbDetails.length >= 5) {
+            try {
+                kbMask = Integer.parseInt(kbDetails[0]);
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        if (mKeyboxInstallPref != null) {
+            if (kbMask <= 0) {
+                mKeyboxInstallPref.setSummary(R.string.play_integrity_keybox_status_none);
+            } else {
+                String algoLabel;
+                if (kbMask == 3) {
+                    algoLabel = "ECDSA + RSA";
+                } else if (kbMask == 1) {
+                    algoLabel = "ECDSA";
+                } else {
+                    algoLabel = "RSA";
+                }
+                if ("1".equals(kbDetails[4])) {
+                    algoLabel = algoLabel + ", RKP";
+                }
+                String verdict = kbDetails[1];
+                String detail = kbDetails[2];
+                long expiryMs = 0L;
+                try {
+                    expiryMs = Long.parseLong(kbDetails[3]);
+                } catch (NumberFormatException ignored) {
+                }
+                String expStr = expiryMs > 0L
+                        ? DateFormat.getDateFormat(ctx).format(new Date(expiryMs))
+                        : "";
+                if ("REVOKED".equals(verdict)) {
+                    mKeyboxInstallPref.setSummary(ctx.getString(
+                            R.string.play_integrity_keybox_status_revoked, algoLabel, detail));
+                } else if ("EXPIRED".equals(verdict)) {
+                    mKeyboxInstallPref.setSummary(ctx.getString(
+                            R.string.play_integrity_keybox_status_expired, algoLabel, expStr));
+                } else if ("NOT_YET_VALID".equals(verdict)) {
+                    mKeyboxInstallPref.setSummary(ctx.getString(
+                            R.string.play_integrity_keybox_status_not_yet_valid, algoLabel));
+                } else if ("AOSP_TEST".equals(verdict)) {
+                    mKeyboxInstallPref.setSummary(ctx.getString(
+                            R.string.play_integrity_keybox_status_aosp_test, algoLabel));
+                } else if ("VALID".equals(verdict)) {
+                    mKeyboxInstallPref.setSummary(ctx.getString(
+                            R.string.play_integrity_keybox_status_valid, algoLabel, expStr));
+                } else {
+                    mKeyboxInstallPref.setSummary(ctx.getString(
+                            R.string.play_integrity_keybox_status_offline, algoLabel, expStr));
+                }
+            }
+        }
+        if (mKeyboxRemovePref != null) {
+            mKeyboxRemovePref.setEnabled(kbMask > 0);
+        }
+    }
+
+    private void showToast(int resId) {
+        postOnUi(() -> {
+            Context ctx = getContext();
+            if (ctx != null) {
+                Toast.makeText(ctx, resId, Toast.LENGTH_SHORT).show();
+            }
+        });
+    }
+
+    private void postOnUi(Runnable r) {
+        Activity act = getActivity();
+        if (act != null && !act.isFinishing() && !act.isDestroyed()) {
+            act.runOnUiThread(r);
+        }
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.play_integrity_settings);
+}
