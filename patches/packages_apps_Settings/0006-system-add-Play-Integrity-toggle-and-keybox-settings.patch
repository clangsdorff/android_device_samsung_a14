+    <string name="play_integrity_keybox_installed">Keybox geïnstalleer</string>
+    <string name="play_integrity_keybox_invalid">Ongeldige keybox.xml-lêer</string>
+    <string name="play_integrity_keybox_too_large">Lêer te groot (maks. 256 KB)</string>
+    <string name="play_integrity_keybox_remove_title">Verwyder keybox</string>
+    <string name="play_integrity_keybox_remove_summary">Keer terug na standaard hardeware-attestasie</string>
+    <string name="play_integrity_keybox_removed">Keybox verwyder</string>
+    <string name="play_integrity_footer_summary">As jy nie weet wat hierdie instellings doen nie, los dit uit. Play Integrity Fix werk outomaties op; pasgemaakte keyboxes is slegs vir gevorderde gebruikers. Bediener-kant skadu-verbod verskyn dalk nie in openbare CRL nie.</string>
+</resources>
