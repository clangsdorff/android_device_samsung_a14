+    <string name="play_integrity_pif_updating">Laai tans nuutste Pixel Canary-profiel...</string>
+    <string name="play_integrity_pif_updated">Toestelprofiel opgedateer</string>
+    <string name="play_integrity_pif_update_failed">Kon nie Pixel Canary-profiel laai nie</string>
