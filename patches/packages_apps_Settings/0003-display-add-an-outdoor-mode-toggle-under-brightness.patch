diff --git a/src/com/android/settings/display/OutdoorModePreferenceController.java b/src/com/android/settings/display/OutdoorModePreferenceController.java
new file mode 100644
index 0000000..43b94f3
--- /dev/null
+++ b/src/com/android/settings/display/OutdoorModePreferenceController.java
@@ -0,0 +1,47 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Langsdorff
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.display;
+
+import android.content.Context;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+import lineageos.hardware.LiveDisplayConfig;
+import lineageos.hardware.LiveDisplayManager;
+
+public class OutdoorModePreferenceController extends TogglePreferenceController {
+
+    private final LiveDisplayManager mLiveDisplay;
+
+    public OutdoorModePreferenceController(Context context, String key) {
+        super(context, key);
+        mLiveDisplay = LiveDisplayManager.getInstance(context);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        final LiveDisplayConfig config = mLiveDisplay.getConfig();
