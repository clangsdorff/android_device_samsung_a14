From 0055e84f9ce128d8b7f073146ebab170275c5567 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Mon, 9 Nov 2026 22:47:47 +0300
Subject: [PATCH 1/2] surfaceflinger: guard hwc backpressure and gate unsignaled
 latching

when the previous frame's present fence has not fired yet,
surfaceflinger drops the commit and retries on the next vsync, so one
late present turns into a run of skipped frames. conversely, forcing
unsignaled latching on multi-layer scenes floods the hwc with unrendered
buffers, leading to present fence slippage and massive frame misses.

guard hwc backpressure behind debug.sf.enable_hwc_backpressure so commits
are not dropped on transient present delays, and respect
debug.sf.latch_unsignaled while defaulting to AutoSingleLayer.
---
 services/surfaceflinger/SurfaceFlinger.cpp | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index 9128394aa1..884255da89 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -604,6 +604,10 @@ SurfaceFlinger::SurfaceFlinger(Factory& factory) : SurfaceFlinger(factory, SkipI
 }
 
 LatchUnsignaledConfig SurfaceFlinger::getLatchUnsignaledConfig() {
+    if (base::GetBoolProperty("debug.sf.latch_unsignaled"s, false)) {
+        return LatchUnsignaledConfig::Always;
+    }
+
     if (base::GetBoolProperty("debug.sf.auto_latch_unsignaled"s, true)) {
         return LatchUnsignaledConfig::AutoSingleLayer;
     }
@@ -3066,7 +3070,8 @@ bool SurfaceFlinger::commit(PhysicalDisplayId pacesetterId,
         }
     }
 
-    if (pacesetterFrameTargetPtr->wouldBackpressureHwc()) {
+    if (pacesetterFrameTargetPtr->wouldBackpressureHwc() &&
+            base::GetBoolProperty("debug.sf.enable_hwc_backpressure"s, false)) {
         if (mBackpressureGpuComposition || pacesetterFrameTargetPtr->didMissHwcFrame()) {
             mScheduler->getVsyncSchedule()->getTracker().onFrameMissed(
                     pacesetterFrameTargetPtr->expectedPresentTime());
