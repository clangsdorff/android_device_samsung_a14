From a6bcd2d8e580db1b8e615ac741e89cc00b6ae49b Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Wed, 11 Nov 2026 15:45:40 +0000
Subject: [PATCH 1/2] surfaceflinger: allow forcing unsignaled latching with a
 prop

latching every buffer before its acquire fence fires floods the exynos
850 hwc with unrendered buffers on multi-layer scenes and makes present
fences slip, so it can not be the default. keep the stock
AutoSingleLayer policy and add debug.sf.latch_unsignaled to force
Always for testing.
---
 services/surfaceflinger/SurfaceFlinger.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index 9128394aa1..fe2df15f89 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -604,6 +604,10 @@ SurfaceFlinger::SurfaceFlinger(Factory& factory) : SurfaceFlinger(factory, SkipI
 }
 
 LatchUnsignaledConfig SurfaceFlinger::getLatchUnsignaledConfig() {
+    if (base::GetBoolProperty("debug.sf.latch_unsignaled"s, false)) {
+        return LatchUnsignaledConfig::Always;
+    }
+
     if (base::GetBoolProperty("debug.sf.auto_latch_unsignaled"s, true)) {
         return LatchUnsignaledConfig::AutoSingleLayer;
     }
