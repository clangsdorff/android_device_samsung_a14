 import androidx.collection.ArrayMap;
@@ -147,6 +151,47 @@ public class SimContactDaoImpl extends SimContactDao {
         return results.toArray(new ContentProviderResult[results.size()]);
     }
 
+    /**
+     * Writes a single record to the ADN file of the given SIM, trimming the name to what the
+     * SIM can hold. Returns false if the SIM rejected the record, e.g. because it is full.
+     */
+    public boolean exportContact(SimCard sim, String name, String number) {
+        final int subscriptionId = sim.getSubscriptionId();
+        final int maxNameLength = getAdnNameMaxLength(subscriptionId);
+        String simName = name != null ? name : "";
+        while (maxNameLength >= 0 && !simName.isEmpty()
+                && SimRecords.getEncodedNameLength(mResolver, simName) > maxNameLength) {
+            simName = simName.substring(0, simName.offsetByCodePoints(simName.length(), -1));
+        }
+
+        final ContentValues values = new ContentValues();
+        values.put(SimRecords.NAME, simName);
+        values.put(SimRecords.PHONE_NUMBER, PhoneNumberUtils.stripSeparators(number));
+        synchronized (SIM_READ_LOCK) {
+            try {
+                return mResolver.insert(SimRecords.getContentUri(subscriptionId,
+                        ElementaryFiles.EF_ADN), values) != null;
+            } catch (IllegalArgumentException | IllegalStateException e) {
+                Log.w(TAG, "Failed to write SIM contact", e);
+                return false;
+            }
+        }
+    }
+
+    private int getAdnNameMaxLength(int subscriptionId) {
+        final Cursor cursor = mResolver.query(
+                ElementaryFiles.getItemUri(subscriptionId, ElementaryFiles.EF_ADN),
+                new String[]{ElementaryFiles.NAME_MAX_LENGTH}, null, null);
+        if (cursor == null) {
+            return -1;
+        }
+        try {
+            return cursor.moveToFirst() ? cursor.getInt(0) : -1;
+        } finally {
+            cursor.close();
+        }
+    }
+
     public void persistSimState(SimCard sim) {
         SharedPreferenceUtil.persistSimStates(mContext, Collections.singletonList(sim));
     }
