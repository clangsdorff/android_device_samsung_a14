+    private String getPrimaryPhoneNumber() {
+        String number = null;
+        for (RawContact rawContact : mContactData.getRawContacts()) {
+            for (DataItem dataItem : rawContact.getDataItems()) {
+                if (!(dataItem instanceof PhoneDataItem)) {
+                    continue;
+                }
+                if (dataItem.isSuperPrimary()) {
+                    return ((PhoneDataItem) dataItem).getNumber();
+                }
+                if (number == null) {
+                    number = ((PhoneDataItem) dataItem).getNumber();
+                }
+            }
+        }
+        return number;
+    }
+
+    private void copyContactToSim() {
+        final List<SimCard> sims = SimContactDao.create(this).getSimCards();
+        if (sims.isEmpty()) {
+            return;
+        }
+        if (sims.size() == 1) {
+            copyContactToSim(sims.get(0));
+            return;
+        }
+        final CharSequence[] simNames = new CharSequence[sims.size()];
+        for (int i = 0; i < sims.size(); i++) {
+            simNames[i] = sims.get(i).getDisplayName();
+        }
+        new AlertDialog.Builder(this)
+                .setTitle(R.string.copy_to_sim_choose)
+                .setItems(simNames, (dialog, which) -> copyContactToSim(sims.get(which)))
+                .show();
+    }
+
+    private void copyContactToSim(SimCard sim) {
+        final String name = mContactData.getDisplayName();
+        final String number = getPrimaryPhoneNumber();
+        final Context appContext = getApplicationContext();
+        new AsyncTask<Void, Void, Boolean>() {
+            @Override
+            protected Boolean doInBackground(Void... params) {
+                return new SimContactDaoImpl(appContext).exportContact(sim, name, number);
+            }
+
+            @Override
+            protected void onPostExecute(Boolean success) {
+                Toast.makeText(appContext,
+                        success ? R.string.copy_to_sim_done : R.string.copy_to_sim_failed,
+                        Toast.LENGTH_SHORT).show();
+            }
+        }.execute();
+    }
+
