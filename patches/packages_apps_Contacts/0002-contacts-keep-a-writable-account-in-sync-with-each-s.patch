+package com.android.contacts.database;
+
+import android.content.ContentProviderOperation;
+import android.content.ContentResolver;
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.OperationApplicationException;
+import android.content.pm.PackageManager;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.RemoteException;
+import android.provider.ContactsContract;
+import android.provider.ContactsContract.CommonDataKinds.Phone;
+import android.provider.ContactsContract.CommonDataKinds.StructuredName;
+import android.provider.ContactsContract.Data;
+import android.provider.ContactsContract.RawContacts;
+import android.provider.ContactsContract.SimAccount;
+import android.provider.ContactsContract.SimContacts;
+import android.telephony.PhoneNumberUtils;
+import android.telephony.SubscriptionInfo;
+import android.telephony.SubscriptionManager;
+import android.telephony.TelephonyManager;
+import android.text.TextUtils;
+import android.util.Log;
+import android.util.SparseArray;
+
+import com.android.contacts.model.SimContact;
+import com.android.contacts.util.PermissionsUtil;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * Keeps one CP2 account per inserted SIM in step with the SIM's ADN file.
+ *
+ * The SIM account behaves like a sync adapter account: the editor writes to CP2 as usual,
+ * which leaves raw contacts marked dirty or deleted. A sync first pushes those local changes
+ * to the SIM and then makes CP2 match the SIM, so a write the SIM rejected is rolled back.
+ * The ADN record number is kept in RawContacts.SOURCE_ID and the record as last synced in
+ * SYNC1 (name) and SYNC2 (number), so a record changed on another phone is not overwritten.
+ */
+public class SimContactSync {
+    private static final String TAG = "SimContactSync";
+
+    public static final String ACCOUNT_TYPE = "com.android.contacts.sim";
+
+    private static final String ACCOUNT_NAME_PREFIX = "sim";
+
+    private static final int MAX_BATCH_SIZE = 300;
+
+    private static final Uri RAW_CONTACTS_URI = asSyncAdapter(RawContacts.CONTENT_URI);
+    private static final Uri DATA_URI = asSyncAdapter(Data.CONTENT_URI);
+
+    private final Context mContext;
+    private final ContentResolver mResolver;
+    private final SimContactDaoImpl mSimDao;
+
+    private SimContactSync(Context context) {
+        mContext = context;
+        mResolver = context.getContentResolver();
+        mSimDao = new SimContactDaoImpl(context);
+    }
+
+    /**
+     * Registers an account for every active SIM, drops accounts of SIMs that are gone and
+     * syncs every SIM account. Returns the number of local changes the SIM rejected.
+     */
+    public static int sync(Context context) {
+        synchronized (SimContactSync.class) {
+            try {
+                return new SimContactSync(context).syncAll();
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Failed to sync SIM contacts", e);
+                return 0;
+            }
+        }
+    }
+
+    /**
+     * Same as {@link #sync} but returns right away unless a SIM contact was edited or deleted.
+     */
+    public static int syncIfDirty(Context context) {
+        synchronized (SimContactSync.class) {
+            try {
+                final SimContactSync sync = new SimContactSync(context);
+                return sync.hasLocalChanges() ? sync.syncAll() : 0;
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Failed to sync SIM contacts", e);
+                return 0;
+            }
+        }
+    }
+
+    private int syncAll() {
+        if (!mContext.getPackageManager().hasSystemFeature(PackageManager.FEATURE_TELEPHONY)
+                || !PermissionsUtil.hasContactsPermissions(mContext)
+                || !PermissionsUtil.hasPhonePermissions(mContext)) {
+            return 0;
+        }
+
+        final TelephonyManager telephonyManager = mContext.getSystemService(TelephonyManager.class);
+        final SubscriptionManager subscriptionManager =
+                mContext.getSystemService(SubscriptionManager.class);
+        final List<SubscriptionInfo> subscriptions =
+                subscriptionManager.getActiveSubscriptionInfoList();
+        final SparseArray<SubscriptionInfo> subscriptionsBySlot = new SparseArray<>();
+        if (subscriptions != null) {
+            for (SubscriptionInfo info : subscriptions) {
+                if (info.getSimSlotIndex() >= 0) {
+                    subscriptionsBySlot.put(info.getSimSlotIndex(), info);
+                }
+            }
+        }
+
+        // A new card gets a new subscription id, so keying the account on it keeps contacts of
+        // the old card from being pushed to the new one.
+        final SparseArray<String> registered = new SparseArray<>();
+        for (SimAccount account : SimContacts.getSimAccounts(mResolver)) {
+            if (!ACCOUNT_TYPE.equals(account.getAccountType())) {
+                continue;
+            }
+            final int slot = account.getSimSlotIndex();
+            final SubscriptionInfo info = subscriptionsBySlot.get(slot);
+            if (info != null && accountName(info).equals(account.getAccountName())) {
+                registered.put(slot, account.getAccountName());
+            } else if (info != null
+                    || telephonyManager.getSimState(slot) == TelephonyManager.SIM_STATE_ABSENT) {
+                // A SIM that is only still loading keeps its account. CP2 drops the raw
+                // contacts of a removed SIM account by itself.
+                SimContacts.removeSimAccounts(mResolver, slot);
+            }
+        }
+
+        int failures = 0;
+        for (int i = 0; i < subscriptionsBySlot.size(); i++) {
+            final int slot = subscriptionsBySlot.keyAt(i);
+            final SubscriptionInfo info = subscriptionsBySlot.valueAt(i);
+            if (telephonyManager.getSimState(slot) != TelephonyManager.SIM_STATE_READY) {
+                continue;
+            }
+            final String accountName = accountName(info);
+            if (registered.get(slot) == null) {
+                SimContacts.addSimAccount(mResolver, accountName, ACCOUNT_TYPE, slot,
+                        SimAccount.ADN_EF_TYPE);
+            }
+            try {
+                failures += syncAccount(info.getSubscriptionId(), accountName);
+            } catch (RemoteException | OperationApplicationException | RuntimeException e) {
+                Log.w(TAG, "Failed to sync SIM contacts of slot " + slot, e);
+            }
+        }
+        return failures;
+    }
+
+    private static String accountName(SubscriptionInfo info) {
+        return ACCOUNT_NAME_PREFIX + info.getSubscriptionId();
+    }
+
+    /** Returns the subscription id a SIM account belongs to, or -1. */
+    public static int getSubscriptionId(String accountName) {
+        if (accountName == null || !accountName.startsWith(ACCOUNT_NAME_PREFIX)) {
+            return SubscriptionManager.INVALID_SUBSCRIPTION_ID;
+        }
+        try {
+            return Integer.parseInt(accountName.substring(ACCOUNT_NAME_PREFIX.length()));
+        } catch (NumberFormatException e) {
+            return SubscriptionManager.INVALID_SUBSCRIPTION_ID;
+        }
+    }
+
+    private boolean hasLocalChanges() {
+        try (Cursor c = mResolver.query(RAW_CONTACTS_URI, new String[] {RawContacts._ID},
+                RawContacts.ACCOUNT_TYPE + "=? AND (" + RawContacts.DIRTY + "=1 OR "
+                        + RawContacts.DELETED + "=1)",
+                new String[] {ACCOUNT_TYPE}, null)) {
+            return c != null && c.getCount() > 0;
+        }
+    }
+
+    private int syncAccount(int subscriptionId, String accountName)
+            throws RemoteException, OperationApplicationException {
+        final Map<Long, LocalContact> local = loadLocalContacts(accountName);
+        SparseArray<SimContact> sim = loadSim(subscriptionId);
+        if (sim == null) {
+            return 0;
+        }
+
+        // Push local edits to the SIM. A record that changed since the last sync is left alone:
+        // a deletion is dropped and an edit goes to a new record, so both versions are kept.
+        int failures = 0;
+        boolean wrote = false;
+        for (LocalContact contact : local.values()) {
+            final boolean unchanged = contact.recordNumber > 0
+                    && isUnchangedOnSim(contact, sim.get(contact.recordNumber));
+            if (contact.deleted) {
+                if (unchanged) {
+                    mSimDao.deleteAdnRecord(subscriptionId, contact.recordNumber);
+                    wrote = true;
+                }
+            } else if (contact.dirty) {
+                final int recordNumber = mSimDao.writeAdnRecord(subscriptionId,
+                        unchanged ? contact.recordNumber : -1, contact.name, contact.number);
+                wrote = true;
+                if (recordNumber > 0 && recordNumber != contact.recordNumber) {
+                    // Stored right away so a sync that fails later doesn't add the record again.
+                    final ContentValues values = new ContentValues();
+                    values.put(RawContacts.SOURCE_ID, String.valueOf(recordNumber));
+                    values.putNull(RawContacts.SYNC1);
+                    values.putNull(RawContacts.SYNC2);
+                    mResolver.update(RAW_CONTACTS_URI.buildUpon()
+                            .appendPath(String.valueOf(contact.rawContactId)).build(),
+                            values, null, null);
+                    contact.recordNumber = recordNumber;
+                } else if (recordNumber <= 0) {
+                    failures++;
+                }
+            }
+        }
+
+        // Then make CP2 match the SIM.
+        if (wrote) {
+            sim = loadSim(subscriptionId);
+            if (sim == null) {
+                return failures;
+            }
+        }
+
+        final ArrayList<ContentProviderOperation> ops = new ArrayList<>();
+        final SparseArray<Long> recordToRawContact = new SparseArray<>();
+        for (LocalContact contact : local.values()) {
+            final SimContact simContact =
+                    contact.deleted || contact.recordNumber <= 0
+                            || recordToRawContact.get(contact.recordNumber) != null
+                    ? null : sim.get(contact.recordNumber);
+            applyIfFull(ops);
+            if (simContact == null) {
+                ops.add(ContentProviderOperation.newDelete(
+                        RAW_CONTACTS_URI.buildUpon()
+                                .appendPath(String.valueOf(contact.rawContactId)).build())
+                        .build());
+                continue;
+            }
+            recordToRawContact.put(contact.recordNumber, contact.rawContactId);
+            final boolean changed =
+                    !Objects.equals(contact.name, nullIfEmpty(simContact.getName()))
+                            || !Objects.equals(contact.number,
+                                    nullIfEmpty(simContact.getPhone()));
+            if (changed) {
+                ops.add(ContentProviderOperation.newDelete(DATA_URI)
+                        .withSelection(Data.RAW_CONTACT_ID + "=?",
+                                new String[] {String.valueOf(contact.rawContactId)})
+                        .build());
+                appendDataInserts(ops, contact.rawContactId, -1, simContact);
+            }
+            if (changed || contact.dirty || !isSyncedWith(contact, simContact)) {
+                ops.add(ContentProviderOperation.newUpdate(
+                        RAW_CONTACTS_URI.buildUpon()
+                                .appendPath(String.valueOf(contact.rawContactId)).build())
+                        .withValue(RawContacts.SOURCE_ID, String.valueOf(contact.recordNumber))
+                        .withValue(RawContacts.SYNC1, emptyIfNull(simContact.getName()))
+                        .withValue(RawContacts.SYNC2, emptyIfNull(simContact.getPhone()))
+                        .withValue(RawContacts.DIRTY, 0)
+                        .build());
+            }
+        }
+        for (int i = 0; i < sim.size(); i++) {
+            if (recordToRawContact.get(sim.keyAt(i)) != null) {
+                continue;
+            }
+            applyIfFull(ops);
+            final int rawContactOp = ops.size();
+            ops.add(ContentProviderOperation.newInsert(RAW_CONTACTS_URI)
+                    .withValue(RawContacts.ACCOUNT_NAME, accountName)
+                    .withValue(RawContacts.ACCOUNT_TYPE, ACCOUNT_TYPE)
+                    .withValue(RawContacts.SOURCE_ID, String.valueOf(sim.keyAt(i)))
+                    .withValue(RawContacts.SYNC1, emptyIfNull(sim.valueAt(i).getName()))
+                    .withValue(RawContacts.SYNC2, emptyIfNull(sim.valueAt(i).getPhone()))
+                    .build());
+            appendDataInserts(ops, -1, rawContactOp, sim.valueAt(i));
+        }
+
+        apply(ops);
+        return failures;
+    }
+
+    private SparseArray<SimContact> loadSim(int subscriptionId) {
+        final ArrayList<SimContact> records = mSimDao.loadAdnRecords(subscriptionId);
+        if (records == null) {
+            return null;
+        }
+        final SparseArray<SimContact> sim = new SparseArray<>();
+        for (SimContact simContact : records) {
+            sim.put(simContact.getRecordNumber(), simContact);
+        }
+        return sim;
+    }
+
+    private static boolean isUnchangedOnSim(LocalContact contact, SimContact simContact) {
+        // Contacts synced before SYNC1 was kept have no snapshot to compare with.
+        return simContact != null
+                && (contact.syncName == null || isSyncedWith(contact, simContact));
+    }
+
+    private static boolean isSyncedWith(LocalContact contact, SimContact simContact) {
+        return emptyIfNull(simContact.getName()).equals(emptyIfNull(contact.syncName))
+                && emptyIfNull(simContact.getPhone()).equals(emptyIfNull(contact.syncNumber));
+    }
+
+    private Map<Long, LocalContact> loadLocalContacts(String accountName) {
+        final Map<Long, LocalContact> contacts = new HashMap<>();
+        try (Cursor c = mResolver.query(RAW_CONTACTS_URI,
+                new String[] {RawContacts._ID, RawContacts.SOURCE_ID, RawContacts.DIRTY,
+                        RawContacts.DELETED, RawContacts.SYNC1, RawContacts.SYNC2},
+                RawContacts.ACCOUNT_TYPE + "=? AND " + RawContacts.ACCOUNT_NAME + "=?",
+                new String[] {ACCOUNT_TYPE, accountName}, null)) {
+            while (c != null && c.moveToNext()) {
+                final LocalContact contact = new LocalContact();
+                contact.rawContactId = c.getLong(0);
+                contact.recordNumber = parseRecordNumber(c.getString(1));
+                contact.dirty = c.getInt(2) != 0;
+                contact.deleted = c.getInt(3) != 0;
+                contact.syncName = c.getString(4);
+                contact.syncNumber = c.getString(5);
+                contacts.put(contact.rawContactId, contact);
+            }
+        }
+
+        try (Cursor c = mResolver.query(DATA_URI,
+                new String[] {Data.RAW_CONTACT_ID, Data.MIMETYPE, Data.DATA1,
+                        Data.IS_SUPER_PRIMARY},
+                RawContacts.ACCOUNT_TYPE + "=? AND " + RawContacts.ACCOUNT_NAME + "=? AND "
+                        + Data.MIMETYPE + " IN (?,?)",
+                new String[] {ACCOUNT_TYPE, accountName, StructuredName.CONTENT_ITEM_TYPE,
+                        Phone.CONTENT_ITEM_TYPE},
+                null)) {
+            while (c != null && c.moveToNext()) {
+                final LocalContact contact = contacts.get(c.getLong(0));
+                final String value = nullIfEmpty(c.getString(2));
+                if (contact == null || value == null) {
+                    continue;
+                }
+                if (StructuredName.CONTENT_ITEM_TYPE.equals(c.getString(1))) {
+                    contact.name = value;
+                } else if (contact.number == null || c.getInt(3) != 0) {
+                    contact.number = PhoneNumberUtils.stripSeparators(value);
+                }
+            }
+        }
+        return contacts;
+    }
+
+    private static void appendDataInserts(List<ContentProviderOperation> ops, long rawContactId,
+            int rawContactOp, SimContact simContact) {
+        if (simContact.hasName()) {
+            ops.add(newDataInsert(rawContactId, rawContactOp)
+                    .withValue(Data.MIMETYPE, StructuredName.CONTENT_ITEM_TYPE)
+                    .withValue(StructuredName.DISPLAY_NAME, simContact.getName())
+                    .build());
+        }
+        if (simContact.hasPhone()) {
+            ops.add(newDataInsert(rawContactId, rawContactOp)
+                    .withValue(Data.MIMETYPE, Phone.CONTENT_ITEM_TYPE)
+                    .withValue(Phone.NUMBER, simContact.getPhone())
+                    .withValue(Phone.TYPE, Phone.TYPE_MOBILE)
+                    .build());
+        }
+    }
+
+    private static ContentProviderOperation.Builder newDataInsert(long rawContactId,
+            int rawContactOp) {
+        final ContentProviderOperation.Builder builder =
+                ContentProviderOperation.newInsert(DATA_URI);
+        return rawContactOp >= 0
+                ? builder.withValueBackReference(Data.RAW_CONTACT_ID, rawContactOp)
+                : builder.withValue(Data.RAW_CONTACT_ID, rawContactId);
+    }
+
+    // Back references are indices into one batch, so only call this between contacts.
+    private void applyIfFull(ArrayList<ContentProviderOperation> ops)
+            throws RemoteException, OperationApplicationException {
+        if (ops.size() >= MAX_BATCH_SIZE) {
+            apply(ops);
+        }
+    }
+
+    private void apply(ArrayList<ContentProviderOperation> ops)
+            throws RemoteException, OperationApplicationException {
+        if (!ops.isEmpty()) {
+            mResolver.applyBatch(ContactsContract.AUTHORITY, new ArrayList<>(ops));
+            ops.clear();
+        }
+    }
+
+    private static int parseRecordNumber(String sourceId) {
+        if (TextUtils.isEmpty(sourceId)) {
+            return -1;
+        }
+        try {
+            return Integer.parseInt(sourceId);
+        } catch (NumberFormatException e) {
+            return -1;
+        }
+    }
+
+    private static String nullIfEmpty(String value) {
+        return TextUtils.isEmpty(value) ? null : value;
+    }
+
+    private static String emptyIfNull(String value) {
+        return value != null ? value : "";
+    }
+
+    private static Uri asSyncAdapter(Uri uri) {
+        return uri.buildUpon()
+                .appendQueryParameter(ContactsContract.CALLER_IS_SYNCADAPTER, "true")
+                .build();
+    }
+
+    private static class LocalContact {
+        long rawContactId;
+        int recordNumber;
+        boolean dirty;
+        boolean deleted;
+        String name;
+        String number;
+        String syncName;
+        String syncNumber;
+    }
+}
