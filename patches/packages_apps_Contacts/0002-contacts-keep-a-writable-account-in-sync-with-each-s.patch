+package com.android.contacts.editor;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.provider.SimPhonebookContract.SimRecords;
+import android.text.InputFilter;
+import android.text.Spanned;
+import android.util.Log;
+import android.widget.EditText;
+
+import com.android.contacts.database.SimContactDaoImpl;
+import com.android.contacts.database.SimContactSync;
+
+import java.util.Arrays;
+
+/**
+ * Stops the name fields of a SIM contact from growing past what the SIM can store. The limit is
+ * in encoded bytes, so it depends on the characters typed.
+ */
+public class SimNameLengthFilter implements InputFilter {
+    private static final String TAG = "SimNameLengthFilter";
+
+    private final ContentResolver mResolver;
+    private final EditText[] mFields;
+    private final int mMaxLength;
+
+    private SimNameLengthFilter(ContentResolver resolver, EditText[] fields, int maxLength) {
+        mResolver = resolver;
+        mFields = fields;
+        mMaxLength = maxLength;
+    }
+
+    /** Looks up the limit of the account's SIM in the background and then adds the filter. */
+    public static void attach(Context context, String accountName, EditText[] fields) {
+        final int subscriptionId = SimContactSync.getSubscriptionId(accountName);
+        if (subscriptionId < 0 || fields.length == 0) {
+            return;
+        }
+        final Context appContext = context.getApplicationContext();
+        new Thread(() -> {
+            final int maxLength;
+            try {
+                maxLength = new SimContactDaoImpl(appContext).getAdnNameMaxLength(subscriptionId);
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Failed to read the SIM name length", e);
+                return;
+            }
+            if (maxLength <= 0) {
+                return;
+            }
+            fields[0].post(() -> {
+                final SimNameLengthFilter filter = new SimNameLengthFilter(
+                        appContext.getContentResolver(), fields, maxLength);
+                for (EditText field : fields) {
+                    final InputFilter[] filters = Arrays.copyOf(field.getFilters(),
+                            field.getFilters().length + 1);
+                    filters[filters.length - 1] = filter;
+                    field.setFilters(filters);
+                }
+            });
+        }).start();
+    }
+
+    @Override
+    public CharSequence filter(CharSequence source, int start, int end, Spanned dest,
+            int dstart, int dend) {
+        final String before = dest.subSequence(0, dstart).toString();
+        final String after = dest.subSequence(dend, dest.length()).toString();
+        String inserted = source.subSequence(start, end).toString();
+        if (fits(dest, before + inserted + after)) {
+            return null;
+        }
+        while (!inserted.isEmpty()) {
+            inserted = inserted.substring(0, inserted.offsetByCodePoints(inserted.length(), -1));
+            if (fits(dest, before + inserted + after)) {
+                break;
+            }
+        }
+        return inserted;
+    }
+
+    // The SIM gets the display name, which joins the name fields with a space.
+    private boolean fits(Spanned dest, String value) {
+        final StringBuilder name = new StringBuilder();
+        for (EditText field : mFields) {
+            final String text = field.getText() == dest ? value : field.getText().toString();
+            if (text.trim().isEmpty()) {
+                continue;
+            }
+            if (name.length() > 0) {
+                name.append(' ');
+            }
+            name.append(text.trim());
+        }
+        try {
+            return SimRecords.getEncodedNameLength(mResolver, name.toString()) <= mMaxLength;
+        } catch (RuntimeException e) {
+            return true;
+        }
+    }
+}
