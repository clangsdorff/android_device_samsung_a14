From c5f6095b4cb35a0bf7a21939f5aa2a7d3b9246c9 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Wed, 18 Nov 2026 16:20:00 +0300
Subject: [PATCH] updater: fallback to full feed when incremental is missing

when updater_server_url contains {incr}, try the incremental feed first
and fall back to the full feed (without /{incr}) if the server returns
404 so users on older or untracked builds still receive full updates.
---
 .../network/UpdatesNetworkDataSource.kt       | 48 ++++++++++++-------
 1 file changed, 31 insertions(+), 17 deletions(-)

diff --git a/app/src/main/java/org/lineageos/updater/data/source/network/UpdatesNetworkDataSource.kt b/app/src/main/java/org/lineageos/updater/data/source/network/UpdatesNetworkDataSource.kt
index 2f1407f..08c04d9 100644
--- a/app/src/main/java/org/lineageos/updater/data/source/network/UpdatesNetworkDataSource.kt
+++ b/app/src/main/java/org/lineageos/updater/data/source/network/UpdatesNetworkDataSource.kt
@@ -14,19 +14,19 @@ import java.io.IOException
 import java.util.concurrent.TimeUnit
 
 class UpdatesNetworkDataSource(private val context: Context) {
-    private val serverUrl: String
-        get() {
-            val base = DeviceInfoUtils.updaterUri.trim().ifEmpty {
-                context.getString(R.string.updater_server_url)
-            }
-            require(base.startsWith("https://")) {
-                "Update server URL must use HTTPS: $base"
-            }
-            return base
-                .replace("{device}", DeviceInfoUtils.device)
-                .replace("{type}", DeviceInfoUtils.releaseType.lowercase())
-                .replace("{incr}", DeviceInfoUtils.buildVersionIncremental)
+    private fun resolveUrl(base: String, includeIncr: Boolean): String {
+        require(base.startsWith("https://")) {
+            "Update server URL must use HTTPS: $base"
         }
+        val url = if (includeIncr) {
+            base.replace("{incr}", DeviceInfoUtils.buildVersionIncremental)
+        } else {
+            base.replace("/{incr}", "").replace("{incr}", "")
+        }
+        return url
+            .replace("{device}", DeviceInfoUtils.device)
+            .replace("{type}", DeviceInfoUtils.releaseType.lowercase())
+    }
 
     private val client = OkHttpClient.Builder()
         .callTimeout(10, TimeUnit.SECONDS)
@@ -34,18 +34,32 @@ class UpdatesNetworkDataSource(private val context: Context) {
         .build()
 
     fun fetchUpdates(): List<NetworkUpdate> {
+        val base = DeviceInfoUtils.updaterUri.trim().ifEmpty {
+            context.getString(R.string.updater_server_url)
+        }
+        val primaryUrl = resolveUrl(base, includeIncr = true)
+        val fallbackUrl = if ("{incr}" in base) resolveUrl(base, includeIncr = false) else null
+
+        val responseBody = fetchBody(primaryUrl, allowNotFound = fallbackUrl != null)
+            ?: fetchBody(fallbackUrl!!, allowNotFound = false)!!
+
+        return Json.decodeFromString<List<NetworkUpdate>>(responseBody)
+    }
+
+    private fun fetchBody(url: String, allowNotFound: Boolean): String? {
         val request = Request.Builder()
-            .url(serverUrl)
+            .url(url)
             .build()
 
-        val responseBody = client.newCall(request).execute().use { response ->
+        client.newCall(request).execute().use { response ->
+            if (allowNotFound && response.code == 404) {
+                return null
+            }
             if (!response.isSuccessful) {
                 throw IOException("Unexpected HTTP status: ${response.code}")
             }
 
-            response.body?.string() ?: throw IOException("Empty response body")
+            return response.body?.string() ?: throw IOException("Empty response body")
         }
-
-        return Json.decodeFromString<List<NetworkUpdate>>(responseBody)
     }
 }
