android_app {
    name: "DolbySettings",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    required: ["privapp-permissions-com.langsdorff.dolby.xml"],
    static_libs: [
        "SettingsLib",
        "androidx.preference_preference",
    ],
    optimize: {
        enabled: false,
    },
}


prebuilt_etc {
    name: "privapp-permissions-com.langsdorff.dolby.xml",
    src: "privapp-permissions-com.langsdorff.dolby.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
