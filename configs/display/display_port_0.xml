<displayConfiguration>
    <!-- peak: dts hdr_max_luma (nt36672c_csot) = 540 nits; points linear in backlight code, not measured -->
    <screenBrightnessMap>
        <point>
            <value>0.0</value>
            <nits>0.0</nits>
        </point>
        <point>
            <value>1.0</value>
            <nits>540.0</nits>
        </point>
    </screenBrightnessMap>

    <screenBrightnessDefault>0.418301</screenBrightnessDefault>

    <highBrightnessMode enabled="true">
        <transitionPoint>0.833333</transitionPoint>
        <minimumLux>3000</minimumLux>
        <timing>
            <timeWindowSecs>0</timeWindowSecs>
            <timeMaxSecs>0</timeMaxSecs>
            <timeMinSecs>0</timeMinSecs>
        </timing>
    </highBrightnessMode>

    <autoBrightness enabled="true">
        <luxToBrightnessMapping>
            <mode>default</mode>
            <setting>normal</setting>
            <map>
                <point>
                    <first>0</first>
                    <second>0.022876</second> <!-- panel level 7 -->
                </point>
                <point>
                    <first>8</first>
                    <second>0.111111</second> <!-- panel level 34 -->
                </point>
                <point>
                    <first>15</first>
                    <second>0.163399</second> <!-- panel level 50 -->
                </point>
                <point>
                    <first>30</first>
                    <second>0.228758</second> <!-- panel level 70 -->
                </point>
                <point>
                    <first>50</first>
                    <second>0.238562</second> <!-- panel level 73 -->
                </point>
                <point>
                    <first>70</first>
                    <second>0.245098</second> <!-- panel level 75 -->
                </point>
                <point>
                    <first>100</first>
                    <second>0.254902</second> <!-- panel level 78 -->
                </point>
                <point>
                    <first>200</first>
                    <second>0.264706</second> <!-- panel level 81 -->
                </point>
                <point>
                    <first>300</first>
                    <second>0.277778</second> <!-- panel level 85 -->
                </point>
                <point>
                    <first>500</first>
                    <second>0.310458</second> <!-- panel level 95 -->
                </point>
                <point>
                    <first>700</first>
                    <second>0.352941</second> <!-- panel level 108 -->
                </point>
                <point>
                    <first>1000</first>
                    <second>0.421569</second> <!-- panel level 129 -->
                </point>
                <point>
                    <first>2000</first>
                    <second>0.633987</second> <!-- panel level 194 -->
                </point>
                <point>
                    <first>3000</first>
                    <second>0.833333</second> <!-- panel level 255 -->
                </point>
                <point>
                    <first>4000</first>
                    <second>1.000000</second> <!-- panel level 306 -->
                </point>
            </map>
        </luxToBrightnessMapping>
        <brighteningLightDebounceMillis>1000</brighteningLightDebounceMillis>
        <darkeningLightDebounceMillis>2000</darkeningLightDebounceMillis>
        <brighteningLightDebounceIdleMillis>-1</brighteningLightDebounceIdleMillis>
        <darkeningLightDebounceIdleMillis>-1</darkeningLightDebounceIdleMillis>
    </autoBrightness>

    <hdrBrightnessConfig>
        <brightnessMap>
        </brightnessMap>
        <brightnessIncreaseDebounceMillis>0</brightnessIncreaseDebounceMillis>
        <screenBrightnessRampIncrease>-1.0</screenBrightnessRampIncrease>
        <brightnessDecreaseDebounceMillis>0</brightnessDecreaseDebounceMillis>
        <screenBrightnessRampDecrease>-1.0</screenBrightnessRampDecrease>
    </hdrBrightnessConfig>

    <lightSensor>
        <type>android.sensor.light</type>
    </lightSensor>
</displayConfiguration>
