on init
    mkdir /dev/cpuset/surfaceflinger
    write /dev/cpuset/surfaceflinger/cpus 0-7
    copy /dev/cpuset/mems /dev/cpuset/surfaceflinger/mems
    chown system system /dev/cpuset/surfaceflinger
    chown system system /dev/cpuset/surfaceflinger/tasks
    chown system system /dev/cpuset/surfaceflinger/cgroup.procs
    chmod 0775 /dev/cpuset/surfaceflinger
    chmod 0664 /dev/cpuset/surfaceflinger/tasks
    chmod 0664 /dev/cpuset/surfaceflinger/cgroup.procs

on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    swapon_all /vendor/etc/fstab.s5e3830

# The camera hal never restores emstune if it dies with a session open
on property:init.svc.sec-camera-provider=running
    write /sys/devices/platform/ems/emstune/req_mode 0

on property:sys.boot_completed=1
    setprop vendor.powerhal.init 1

service vendor.power-hal-aidl /vendor/bin/hw/android.hardware.power-service.pixel-libperfmgr
    override
    class hal
    user root
    group system radio
    priority -20

