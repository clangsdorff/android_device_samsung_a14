set_prop(vendor_init, vendor_graphics_prop)

set_prop(vendor_init, vendor_thermal_prop)

# init.s5e3830.rc copies cpuset mems and clears the rt uclamp default
allow vendor_init cgroup:file getattr;
allow vendor_init proc_sched:file w_file_perms;
get_prop(vendor_init, vendor_radio_prop)

set_prop(vendor_init, system_prop)
allow vendor_init system_data_file:dir create_dir_perms;
allow vendor_init proc:file w_file_perms;
allow vendor_init proc_hung_task:file w_file_perms;
