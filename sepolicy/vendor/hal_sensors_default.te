allow hal_sensors_default sysfs:file r_file_perms;
allow hal_sensors_default sysfs:dir r_dir_perms;
allow hal_sensors_default sysfs_iio:dir r_dir_perms;
allow hal_sensors_default sysfs_iio:file rw_file_perms;

dontaudit hal_sensors_default default_prop:file rw_file_perms;
dontaudit hal_sensors_default property_socket:sock_file rw_file_perms;
