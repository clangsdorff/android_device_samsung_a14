type wlbtd, domain;
type wlbtd_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(wlbtd)

allow wlbtd self:netlink_generic_socket create_socket_perms_no_ioctl;
allow wlbtd conn_vendor_data_file:dir rw_dir_perms;
allow wlbtd conn_vendor_data_file:file create_file_perms;
allow wlbtd sysfs_wifi:dir r_dir_perms;
allow wlbtd sysfs_wifi:file rw_file_perms;

set_prop(wlbtd, vendor_wlbtd_prop)
